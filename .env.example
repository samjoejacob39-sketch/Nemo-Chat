# Nook backend configuration (copy to .env and adjust)
# Local dev database created by scripts/dev-postgres.ps1 or docker compose up
DATABASE_URL=postgres://postgres@localhost:5432/nook
# Where uploaded images are stored
NOOK_MEDIA_DIR=./data/media
# Bind address of the HTTP/WebSocket server
NOOK_BIND=0.0.0.0:8080
# Maximum accepted upload size in bytes (default 10 MiB)
NOOK_MAX_UPLOAD_BYTES=10485760
# Version of the onboarding terms/privacy documents
NOOK_POLICY_VERSION=2026-11-11
