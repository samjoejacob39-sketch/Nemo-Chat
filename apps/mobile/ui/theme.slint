// Nemo Blue Glass — design tokens.
// Visual source of truth: the approved Nook design board.
// Light + dark themes, spacing, typography, radii and motion.

export global Theme {
    // ------------------------------------------------------------------
    // Light palette
    // ------------------------------------------------------------------
    out property <color> bg-1: #F4F7FF;          // page base (lavender white)
    out property <color> bg-2: #E7EDFF;          // gradient partner
    out property <color> blob-1: #C9D8FF;        // decorative blob
    out property <color> blob-2: #EAD9FF;        // soft violet blob
    out property <color> surface: #FFFFFF;       // cards (with alpha below)
    out property <color> surface-alpha: surface.transparentize(0.28);
    out property <color> surface-strong: #FFFFFF;
    out property <color> surface-dim: rgba(255, 255, 255, 0.55);
    out property <color> text: #0E1633;
    out property <color> text-2: #66708C;
    out property <color> text-3: #98A1BB;
    out property <color> accent: #2F6BFF;
    out property <color> accent-hi: #4D8DFF;
    out property <color> accent-deep: #1E52E8;
    out property <color> accent-soft: #E4EDFF;
    out property <color> accent-alpha: rgba(47, 107, 255, 0.16);
    out property <color> on-accent: #FFFFFF;
    out property <color> bubble-in: #F1F4FA;
    out property <color> online: #34C759;
    out property <color> danger: #FF3B4E;
    out property <color> danger-soft: rgba(255, 59, 78, 0.12);
    out property <color> hairline: rgba(22, 42, 96, 0.10);
    out property <color> stroke-glass: rgba(255, 255, 255, 0.85);
    out property <color> nav-glass: rgba(255, 255, 255, 0.62);
    out property <color> shadow: rgba(30, 50, 110, 0.14);
    out property <color> shadow-soft: rgba(30, 50, 110, 0.07);
    out property <color> overlay-scrim: rgba(12, 18, 40, 0.35);
    // Liquid-glass layers (Slint has no backdrop blur; depth is emulated
    // with translucent gradients, a specular edge and layered shadows).
    out property <color> glass-top: rgba(255, 255, 255, 0.80);
    out property <color> glass-bottom: rgba(255, 255, 255, 0.44);
    out property <color> glass-edge: rgba(255, 255, 255, 0.98);

    // ------------------------------------------------------------------
    // Dark palette
    // ------------------------------------------------------------------
    out property <color> d-bg-1: #0C0F17;
    out property <color> d-bg-2: #131A2A;
    out property <color> d-blob-1: #1B3A8F;
    out property <color> d-blob-2: #3A2A6E;
    out property <color> d-surface-alpha: rgba(255, 255, 255, 0.055);
    out property <color> d-surface-strong: #1C2233;
    out property <color> d-surface-dim: rgba(255, 255, 255, 0.035);
    out property <color> d-text: #F2F5FF;
    out property <color> d-text-2: #A2ABC4;
    out property <color> d-text-3: #6E7896;
    out property <color> d-accent-soft: rgba(77, 141, 255, 0.20);
    out property <color> d-bubble-in: #232A3C;
    out property <color> d-hairline: rgba(255, 255, 255, 0.09);
    out property <color> d-stroke-glass: rgba(255, 255, 255, 0.14);
    out property <color> d-nav-glass: rgba(16, 20, 32, 0.72);
    out property <color> d-shadow: rgba(0, 0, 0, 0.45);
    out property <color> d-shadow-soft: rgba(0, 0, 0, 0.25);
    out property <color> d-glass-top: rgba(255, 255, 255, 0.10);
    out property <color> d-glass-bottom: rgba(255, 255, 255, 0.04);
    out property <color> d-glass-edge: rgba(255, 255, 255, 0.20);

    // ------------------------------------------------------------------
    // Resolved tokens (switched by is-dark)
    // ------------------------------------------------------------------
    in-out property <bool> is-dark: false;

    out property <color> c-bg-1: is-dark ? d-bg-1 : bg-1;
    out property <color> c-bg-2: is-dark ? d-bg-2 : bg-2;
    out property <color> c-blob-1: is-dark ? d-blob-1 : blob-1;
    out property <color> c-blob-2: is-dark ? d-blob-2 : blob-2;
    out property <color> c-surface-alpha: is-dark ? d-surface-alpha : surface-alpha;
    out property <color> c-surface-strong: is-dark ? d-surface-strong : surface-strong;
    out property <color> c-surface-dim: is-dark ? d-surface-dim : surface-dim;
    out property <color> c-text: is-dark ? d-text : text;
    out property <color> c-text-2: is-dark ? d-text-2 : text-2;
    out property <color> c-text-3: is-dark ? d-text-3 : text-3;
    out property <color> c-accent-soft: is-dark ? d-accent-soft : accent-soft;
    out property <color> c-accent-alpha: is-dark ? d-accent-soft : accent-alpha;
    out property <color> c-bubble-in: is-dark ? d-bubble-in : bubble-in;
    out property <color> c-hairline: is-dark ? d-hairline : hairline;
    out property <color> c-stroke-glass: is-dark ? d-stroke-glass : stroke-glass;
    out property <color> c-nav-glass: is-dark ? d-nav-glass : nav-glass;
    out property <color> c-shadow: is-dark ? d-shadow : shadow;
    out property <color> c-shadow-soft: is-dark ? d-shadow-soft : shadow-soft;
    out property <color> c-glass-top: is-dark ? d-glass-top : glass-top;
    out property <color> c-glass-bottom: is-dark ? d-glass-bottom : glass-bottom;
    out property <color> c-glass-edge: is-dark ? d-glass-edge : glass-edge;

    // ------------------------------------------------------------------
    // Type ramp
    // ------------------------------------------------------------------
    out property <length> fs-caption: 11.5px;
    out property <length> fs-small: 13px;
    out property <length> fs-body: 15px;
    out property <length> fs-body-lg: 16.5px;
    out property <length> fs-title: 21px;
    out property <length> fs-large: 26px;
    out property <length> fs-hero: 34px;

    // ------------------------------------------------------------------
    // Radii & spacing
    // ------------------------------------------------------------------
    out property <length> r-card: 24px;
    out property <length> r-row: 18px;
    out property <length> r-input: 16px;
    out property <length> r-bubble: 22px;
    out property <length> r-tail: 7px;
    out property <length> sp-1: 4px;
    out property <length> sp-2: 8px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-5: 20px;
    out property <length> sp-6: 24px;
    out property <length> sp-7: 32px;
    out property <length> bar-h: 56px;     // top bars
    out property <length> nav-h: 64px;     // floating bottom nav
    out property <length> touch-min: 44px; // minimum touch target

    // ------------------------------------------------------------------
    // Motion
    // ------------------------------------------------------------------
    out property <duration> t-fast: 120ms;
    out property <duration> t-med: 200ms;
    out property <duration> t-slow: 320ms;
    out property <easing> ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}
