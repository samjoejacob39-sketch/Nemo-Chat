// The Nook logo mark: two overlapping gradient bubbles.
export component NookLogo inherits IconBase {
    in property <bool> compact;
    Rectangle {
        y: 0;
        x: 0;
        width: parent.size * (parent.compact ? 0.68 : 0.72);
        height: parent.size * (parent.compact ? 0.68 : 0.72);
        border-radius: self.width / 2;
        background: @linear-gradient(160deg, Theme.n-ink 0%, Theme.n-ink-soft 100%);
    }
    Rectangle {
        x: parent.size * (parent.compact ? 0.32 : 0.30);
        y: parent.size * 0.28;
        width: parent.size * (parent.compact ? 0.58 : 0.62);
        height: parent.size * (parent.compact ? 0.58 : 0.62);
        border-radius: self.width / 2;
        background: @linear-gradient(200deg, Theme.n-muted 0%, Theme.n-muted-2 100%);
        opacity: 0.94;
    }
}
