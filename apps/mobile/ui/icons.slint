// --- Bottom navigation glyphs (filled when selected) ----------------------

export component NavChat inherits IconBase {
    in property <bool> selected;
    Path {
        width: parent.size; height: parent.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M12 4 C7 4 3.5 7.2 3.5 11.3 C3.5 13.6 4.7 15.6 6.5 16.9 L6 20.5 L9.8 18.6 C10.5 18.8 11.2 18.9 12 18.9 C17 18.9 20.5 15.6 20.5 11.3 C20.5 7.2 17 4 12 4 Z";
        fill: parent.selected ? parent.tint : transparent;
        stroke: parent.tint; stroke-width: 1.9px;
        stroke-line-cap: round; stroke-line-join: round;
    }
}

