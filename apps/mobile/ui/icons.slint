// Line icon set drawn with Slint Paths (24×24 viewBox, ~1.8 stroke).
// All icons color via `color` property.

import { Theme } from "theme.slint";

export component IconBase inherits Rectangle {
    in property <color> tint: Theme.c-text;
    in property <length> size: 24px;
    background: transparent;
    width: size;
    height: size;
}

// --- Navigation & general -------------------------------------------------

export component ChevronLeft inherits IconBase {
    Path {
        width: parent.size; height: parent.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M15 5 L8 12 L15 19";
        stroke: parent.tint; stroke-width: 2.2px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
    }
}

