// Nemo Design System v1.0.0 -- reusable native Liquid Glass components.
//
// Canonical components are prefixed `Nemo*`. The legacy names used by the
// screens (GlassCard, NavBar, ...) are thin inheritances of the canonical
// component so every screen already resolves the same material, radii,
// typography and motion.
//
// Glass is emulated in Slint with translucent layered gradients, one-pixel
// specular edges, an inset bottom reflection and soft shadows. Slint 1.18 has
// no backdrop blur, so no CSS blur is attempted here.

import { Theme } from "theme.slint";
import {
    ChevronLeft, Eye, EyeOff, Search, NavChat, NavFind, NavProfile, Close,
} from "icons.slint";

// ---------------------------------------------------------------------------
// Background
// ---------------------------------------------------------------------------

export component ScreenBackground inherits Rectangle {
    background: @linear-gradient(165deg, Theme.c-bg-1 0%, Theme.c-bg-2 58%, Theme.c-bg-1 100%);

    // Ambient refracted light. No colour, only luminance.
    Rectangle {
        width: 440px;
        height: 440px;
        x: -170px;
        y: -190px;
        border-radius: 220px;
        background: @radial-gradient(circle,
            Theme.is-dark ? rgba(255, 255, 255, 0.075) : rgba(255, 255, 255, 0.92) 0%,
            Theme.is-dark ? rgba(255, 255, 255, 0.015) : rgba(255, 255, 255, 0.34) 46%,
            transparent 100%);
    }
    Rectangle {
        width: 380px;
        height: 380px;
        x: parent.width - 210px;
        y: 150px;
        border-radius: 190px;
        background: @radial-gradient(circle,
            Theme.is-dark ? rgba(255, 255, 255, 0.04) : rgba(255, 255, 255, 0.52) 0%,
            transparent 100%);
    }
    Rectangle {
        width: 460px;
        height: 460px;
        x: parent.width / 2 - 300px;
        y: parent.height - 280px;
        border-radius: 230px;
        background: @radial-gradient(circle,
            Theme.is-dark ? rgba(255, 255, 255, 0.028) : rgba(255, 255, 255, 0.46) 0%,
            transparent 100%);
    }
    // Fine top edge reflection.
    Rectangle {
        y: 0px;
        height: 1px;
        background: @linear-gradient(90deg,
            transparent 0%,
            Theme.is-dark ? rgba(255, 255, 255, 0.10) : rgba(255, 255, 255, 0.96) 50%,
            transparent 100%);
    }
}

// ---------------------------------------------------------------------------
// Glass surfaces
// ---------------------------------------------------------------------------

export component NemoGlassCard inherits Rectangle {
    in property <length> radius: Theme.n-r-card;
    in property <bool> strong: false;
    in property <bool> flat: false;

    border-radius: radius;
    background: strong
        ? @linear-gradient(180deg, Theme.n-glass-strong 0%, Theme.n-glass-strong 100%)
        : @linear-gradient(160deg, Theme.n-glass-top 0%, Theme.n-glass-bottom 100%);
    border-width: 1px;
    border-color: Theme.is-dark ? Theme.n-line-strong : Theme.n-glass-edge;
    drop-shadow-blur: flat ? 0px : (strong ? 26px : 16px);
    drop-shadow-color: Theme.is-dark ? rgba(0, 0, 0, 0.34) : rgba(0, 0, 0, 0.055);
    drop-shadow-offset-y: flat ? 0px : 6px;
    clip: true;

    // Specular top edge.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: @linear-gradient(90deg,
            transparent 0%,
            Theme.n-glass-edge 28%,
            Theme.n-glass-edge 72%,
            transparent 100%);
        opacity: strong ? 0.98 : 0.82;
    }
    // Inner bottom reflection.
    Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 1px;
        background: Theme.n-inner-shadow;
        opacity: 0.9;
    }
    @children
}

export component GlassCard inherits NemoGlassCard { }

export component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.n-line;
}

// ---------------------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------------------

export component NemoPrimaryButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> loading: false;
    callback clicked;

    height: Theme.n-control-h;
    border-radius: Theme.n-r-control;
    background: enabled
        ? @linear-gradient(180deg, Theme.n-primary 0%, Theme.is-dark ? #e6e6e4 : #000000 100%)
        : Theme.n-line;
    border-width: 1px;
    border-color: Theme.is-dark ? rgba(255, 255, 255, 0.12) : rgba(255, 255, 255, 0.16);
    drop-shadow-blur: enabled ? 18px : 0px;
    drop-shadow-color: Theme.is-dark ? rgba(0, 0, 0, 0.30) : rgba(0, 0, 0, 0.16);
    drop-shadow-offset-y: enabled ? 6px : 0px;
    clip: true;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.is-dark ? #000000 : #ffffff;
            opacity: touch.pressed ? 0.10 : 0.0;
            animate opacity { duration: Theme.n-tap; }
        }
        Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 38px;
            x: touch.pressed-x - self.width / 2;
            y: touch.pressed-y - self.height / 2;
            background: Theme.n-primary-text;
            opacity: touch.pressed ? 0.16 : 0.0;
            animate opacity { duration: 280ms; easing: Theme.ease-out; }
        }
    }
    Text {
        text: root.loading ? "Please wait" : root.text;
        font-size: Theme.n-card;
        font-weight: 700;
        color: root.enabled ? Theme.n-primary-text : Theme.n-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        letter-spacing: -0.1px;
    }
}

export component PrimaryButton inherits NemoPrimaryButton { }

export component NemoGlassButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked;

    height: Theme.n-control-h;
    border-radius: Theme.n-r-control;
    background: Theme.n-glass-soft;
    border-width: 1px;
    border-color: Theme.n-line;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.n-inner-shadow;
    drop-shadow-offset-y: 3px;
    clip: true;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.n-primary;
            opacity: touch.pressed ? 0.07 : 0.0;
            animate opacity { duration: Theme.n-tap; }
        }
        Rectangle {
            width: 70px;
            height: 70px;
            border-radius: 35px;
            x: touch.pressed-x - self.width / 2;
            y: touch.pressed-y - self.height / 2;
            background: Theme.n-primary;
            opacity: touch.pressed ? 0.08 : 0.0;
            animate opacity { duration: 260ms; easing: Theme.ease-out; }
        }
    }
    Text {
        text: root.text;
        font-size: Theme.n-body;
        font-weight: 650;
        color: root.enabled ? Theme.n-ink : Theme.n-muted-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component GhostButton inherits NemoGlassButton { }

export component NemoTextButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked;

    height: 44px;
    border-radius: Theme.n-r-control;
    background: transparent;
    clip: true;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: root.border-radius;
            background: Theme.n-primary;
            opacity: touch.pressed ? 0.06 : 0.0;
            animate opacity { duration: Theme.n-tap; }
        }
    }
    Text {
        text: root.text;
        font-size: Theme.n-body;
        font-weight: 650;
        color: !root.enabled ? Theme.n-muted-2 : root.danger ? Theme.n-muted : Theme.n-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TextButton inherits NemoTextButton { }

export component NemoIconButton inherits Rectangle {
    in property <length> size: 44px;
    in property <bool> filled: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;

    width: size;
    height: size;
    border-radius: Theme.n-r-control;
    background: filled ? Theme.n-primary : Theme.n-glass-soft;
    border-width: 1px;
    border-color: filled ? transparent : Theme.n-line;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.n-inner-shadow;
    drop-shadow-offset-y: 3px;
    clip: true;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: root.border-radius;
            background: filled ? Theme.n-primary-text : Theme.n-primary;
            opacity: touch.pressed ? 0.12 : 0.0;
            animate opacity { duration: Theme.n-tap; }
        }
    }
    @children
}

export component IconButton inherits NemoIconButton { }

export component NemoBackButton inherits Rectangle {
    callback clicked;

    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: Theme.n-glass;
    border-width: 1px;
    border-color: Theme.n-line;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.n-inner-shadow;
    drop-shadow-offset-y: 4px;
    clip: true;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: root.border-radius;
            background: Theme.n-primary;
            opacity: touch.pressed ? 0.08 : 0.0;
            animate opacity { duration: Theme.n-tap; }
        }
    }
    ChevronLeft {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 20px;
        tint: Theme.n-ink;
    }
}

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

export component NemoInput inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in property <bool> password: false;
    in property <string> error: "";
    in property <bool> enabled: true;
    in-out property <string> text: "";
    callback accepted(string);
    private property <bool> reveal: false;
    private property <bool> focused: input.has-focus;

    background: transparent;
    height: inner.preferred-height;

    inner := VerticalLayout {
        spacing: Theme.n-xs;
        if label != "": Text {
            text: root.label;
            font-size: Theme.n-label;
            font-weight: 650;
            color: Theme.n-muted;
        }
        Rectangle {
            height: Theme.n-control-h;
            border-radius: Theme.n-r-input;
            background: Theme.is-dark ? Theme.n-glass-soft : Theme.n-glass;
            border-width: 1px;
            border-color: root.focused ? Theme.n-ink
                : root.error != "" ? Theme.n-muted
                : Theme.n-line;
            drop-shadow-blur: root.focused ? 16px : 0px;
            drop-shadow-color: Theme.is-dark ? rgba(0, 0, 0, 0.30) : rgba(0, 0, 0, 0.055);
            drop-shadow-offset-y: 4px;
            clip: true;

            input := TextInput {
                x: 16px;
                y: 0px;
                width: root.password ? parent.width - 62px : parent.width - 32px;
                height: parent.height;
                text <=> root.text;
                font-size: Theme.n-card;
                color: Theme.n-ink;
                input-type: root.password && !root.reveal ? InputType.password : InputType.text;
                enabled: root.enabled;
                accepted() => { root.accepted(root.text); }
                vertical-alignment: center;
            }
            if root.text == "" && root.enabled: Text {
                x: 16px;
                y: 0px;
                height: parent.height;
                text: root.placeholder;
                font-size: Theme.n-card;
                color: Theme.n-muted-2;
                vertical-alignment: center;
            }
            if root.password: TouchArea {
                x: parent.width - 48px;
                y: (parent.height - 32px) / 2;
                width: 32px;
                height: 32px;
                mouse-cursor: pointer;
                clicked => { root.reveal = !root.reveal; }
                if root.reveal: Eye {
                    x: 6px;
                    y: 6px;
                    size: 20px;
                    tint: Theme.n-ink;
                }
                if !root.reveal: EyeOff {
                    x: 6px;
                    y: 6px;
                    size: 20px;
                    tint: Theme.n-muted;
                }
            }
        }
        if root.error != "": Text {
            text: root.error;
            font-size: Theme.n-secondary;
            font-weight: 600;
            color: Theme.n-muted;
        }
    }
}

export component NookField inherits NemoInput { }

export component NemoSearchField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "Search";
    callback text-changed(string);

    height: 50px;
    border-radius: 18px;
    background: Theme.is-dark ? Theme.n-glass-soft : Theme.n-glass;
    border-width: 1px;
    border-color: Theme.n-line;
    clip: true;

    changed text => { root.text-changed(root.text); }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: Theme.n-xs;
        alignment: center;
        Search { size: 18px; tint: Theme.n-muted; }
        input := TextInput {
            vertical-alignment: center;
            text <=> root.text;
            font-size: Theme.n-body;
            color: Theme.n-ink;
        }
        if root.text == "": Text {
            text: root.placeholder;
            font-size: Theme.n-body;
            color: Theme.n-muted-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.text != "": TouchArea {
            width: 28px;
            height: 28px;
            mouse-cursor: pointer;
            clicked => { root.text = ""; }
            Close { x: 4px; y: 4px; size: 20px; tint: Theme.n-muted; }
        }
    }
}

export component SearchField inherits NemoSearchField { }

// ---------------------------------------------------------------------------
// Avatar
// ---------------------------------------------------------------------------

export component NemoAvatar inherits Rectangle {
    in property <string> initials: "?";
    in property <int> variant: 0;
    in property <bool> online: false;
    in property <length> size: 52px;
    in property <bool> has-image: false;
    in property <image> image;

    pure function grad(i: int) -> brush {
        if (i == 0) { return @linear-gradient(150deg, #f0f0ee 0%, #bcbcb8 100%); }
        if (i == 1) { return @linear-gradient(150deg, #dededb 0%, #a3a39f 100%); }
        if (i == 2) { return @linear-gradient(150deg, #c9c9c5 0%, #8d8d89 100%); }
        if (i == 3) { return @linear-gradient(150deg, #e8e8e5 0%, #b0b0ac 100%); }
        if (i == 4) { return @linear-gradient(150deg, #d4d4d0 0%, #979793 100%); }
        return @linear-gradient(150deg, #f4f4f2 0%, #c2c2be 100%);
    }

    width: size;
    height: size;
    border-radius: self.width / 2;
    background: Theme.is-dark
        ? @linear-gradient(150deg, #3b3b39 0%, #1f1f1e 100%)
        : grad(variant);
    border-width: 1px;
    border-color: Theme.is-dark ? Theme.n-line-strong : rgba(255, 255, 255, 0.72);
    clip: true;

    if has-image: Image {
        width: parent.width;
        height: parent.height;
        source: parent.image;
    }
    if !has-image: Text {
        text: parent.initials;
        font-size: parent.size * 0.36;
        font-weight: 720;
        color: Theme.is-dark ? #f2f2f0 : #2e2e2c;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    if online: Rectangle {
        width: parent.size * 0.24;
        height: parent.size * 0.24;
        x: parent.size - self.width - 1px;
        y: parent.size - self.height - 1px;
        border-radius: self.width / 2;
        background: Theme.n-primary;
        border-width: 2px;
        border-color: Theme.c-bg-1;
    }
}

export component Avatar inherits NemoAvatar { }

// ---------------------------------------------------------------------------
// Toggle & badges
// ---------------------------------------------------------------------------

export component NemoToggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 50px;
    height: 30px;
    border-radius: 15px;
    background: checked ? Theme.n-primary : Theme.n-track;
    animate background { duration: Theme.n-focus; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    Rectangle {
        width: 24px;
        height: 24px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 12px;
        background: root.checked
            ? Theme.n-primary-text
            : (Theme.is-dark ? #e8e8e6 : #ffffff);
        drop-shadow-blur: 4px;
        drop-shadow-color: rgba(0, 0, 0, 0.22);
        animate x { duration: Theme.n-focus; easing: Theme.ease-out; }
    }
}

export component Toggle inherits NemoToggle { }

export component NemoBadge inherits Rectangle {
    in property <int> count: 0;
    in property <color> bg: Theme.n-primary;
    in property <color> fg: Theme.n-primary-text;

    width: count > 99 ? 27px : 20px;
    height: 20px;
    border-radius: 10px;
    background: bg;
    visible: count > 0;
    Text {
        width: parent.width;
        height: parent.height;
        text: count > 99 ? "99+" : "" + root.count;
        font-size: 12px;
        font-weight: 750;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CountBadge inherits NemoBadge { }

export component NemoPillTag inherits Rectangle {
    in property <string> text: "";
    in property <color> bg: Theme.n-glass-soft;
    in property <color> fg: Theme.n-muted;
    in property <bool> strong: false;

    height: 26px;
    width: text.character-count * 6.8px + 22px;
    border-radius: 13px;
    background: strong ? Theme.n-primary : root.bg;
    border-width: 1px;
    border-color: strong ? transparent : Theme.n-line;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.n-caption;
        font-weight: 700;
        color: root.strong ? Theme.n-primary-text : root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PillTag inherits NemoPillTag { }

export component NemoSectionLabel inherits Rectangle {
    in property <string> text: "";

    height: 22px;
    background: transparent;
    Text {
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-size: Theme.n-label;
        font-weight: 700;
        letter-spacing: 1.2px;
        color: Theme.n-muted;
    }
}

export component SectionLabel inherits NemoSectionLabel { }

// ---------------------------------------------------------------------------
// Header
// ---------------------------------------------------------------------------

export component NemoTopBar inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> show-back: true;
    callback back;

    height: Theme.n-header-h;
    background: transparent;

    HorizontalLayout {
        padding-left: Theme.n-screen-pad;
        padding-right: Theme.n-screen-pad;
        spacing: Theme.n-sm;
        alignment: center;

        if show-back: NemoBackButton {
            clicked => { root.back(); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: Theme.n-card;
                font-weight: 700;
                color: Theme.n-ink;
                letter-spacing: -0.2px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.n-caption;
                color: Theme.n-muted;
                overflow: elide;
            }
        }
        @children
    }
}

export component TopBar inherits NemoTopBar { }

// ---------------------------------------------------------------------------
// Floating bottom navigation -- exactly Chats / Find / Profile
// ---------------------------------------------------------------------------

export component NemoBottomNav inherits Rectangle {
    in property <int> selected: 0;
    in property <int> unread: 0;
    in property <int> requests: 0;
    callback select(int);

    horizontal-stretch: 1;
    height: Theme.n-nav-h;
    background: transparent;

    Rectangle {
        x: 18px;
        y: 4px;
        width: parent.width - 36px;
        height: 64px;
        border-radius: 24px;
        background: @linear-gradient(180deg, Theme.n-glass-top 0%, Theme.n-nav-bg 55%, Theme.n-glass-bottom 100%);
        border-width: 1px;
        border-color: Theme.is-dark ? Theme.n-line-strong : Theme.n-glass-edge;
        drop-shadow-blur: 28px;
        drop-shadow-color: Theme.is-dark ? rgba(0, 0, 0, 0.40) : rgba(0, 0, 0, 0.11);
        drop-shadow-offset-y: 10px;
        clip: true;

        Rectangle {
            x: 6px;
            y: 1px;
            width: parent.width - 12px;
            height: 1px;
            background: @linear-gradient(90deg,
                transparent 0%,
                Theme.n-glass-edge 34%,
                Theme.n-glass-edge 66%,
                transparent 100%);
            opacity: 0.9;
        }

        HorizontalLayout {
            padding: 5px;
            spacing: 4px;

            // Chats
            TouchArea {
                horizontal-stretch: 1;
                height: 54px;
                mouse-cursor: pointer;
                clicked => { root.select(0); }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: 18px;
                    background: root.selected == 0 ? Theme.n-primary : transparent;
                    animate background { duration: Theme.n-tab; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        NavChat {
                            size: 19px;
                            selected: root.selected == 0;
                            tint: root.selected == 0 ? Theme.n-primary-text : Theme.n-muted;
                        }
                        Text {
                            text: "Chats";
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 0.2px;
                            color: root.selected == 0 ? Theme.n-primary-text : Theme.n-muted;
                            horizontal-alignment: center;
                        }
                    }
                    if root.unread > 0: NemoBadge {
                        count: root.unread;
                        x: parent.width - 28px;
                        y: 5px;
                        bg: root.selected == 0 ? Theme.n-primary-text : Theme.n-primary;
                        fg: root.selected == 0 ? Theme.n-primary : Theme.n-primary-text;
                    }
                }
            }

            // Find
            TouchArea {
                horizontal-stretch: 1;
                height: 54px;
                mouse-cursor: pointer;
                clicked => { root.select(1); }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: 18px;
                    background: root.selected == 1 ? Theme.n-primary : transparent;
                    animate background { duration: Theme.n-tab; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        NavFind {
                            size: 19px;
                            selected: root.selected == 1;
                            tint: root.selected == 1 ? Theme.n-primary-text : Theme.n-muted;
                        }
                        Text {
                            text: "Find";
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 0.2px;
                            color: root.selected == 1 ? Theme.n-primary-text : Theme.n-muted;
                            horizontal-alignment: center;
                        }
                    }
                    if root.requests > 0: NemoBadge {
                        count: root.requests;
                        x: parent.width - 28px;
                        y: 5px;
                        bg: root.selected == 1 ? Theme.n-primary-text : Theme.n-primary;
                        fg: root.selected == 1 ? Theme.n-primary : Theme.n-primary-text;
                    }
                }
            }

            // Profile
            TouchArea {
                horizontal-stretch: 1;
                height: 54px;
                mouse-cursor: pointer;
                clicked => { root.select(2); }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: 18px;
                    background: root.selected == 2 ? Theme.n-primary : transparent;
                    animate background { duration: Theme.n-tab; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        NavProfile {
                            size: 19px;
                            selected: root.selected == 2;
                            tint: root.selected == 2 ? Theme.n-primary-text : Theme.n-muted;
                        }
                        Text {
                            text: "Profile";
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 0.2px;
                            color: root.selected == 2 ? Theme.n-primary-text : Theme.n-muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component NavBar inherits NemoBottomNav { }

// ---------------------------------------------------------------------------
// Overlays
// ---------------------------------------------------------------------------

export component NemoBottomSheet inherits Rectangle {
    in property <bool> open: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <length> sheet-height: 260px;
    callback close;

    background: transparent;

    // Scrim
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.n-scrim;
        opacity: root.open ? 1.0 : 0.0;
        animate opacity { duration: Theme.n-sheet; }
        TouchArea {
            enabled: root.open;
            clicked => { root.close(); }
        }
    }
    // Sheet
    Rectangle {
        x: 12px;
        y: root.open ? parent.height - root.sheet-height : parent.height + 24px;
        width: parent.width - 24px;
        height: root.sheet-height;
        border-radius: Theme.n-r-sheet;
        background: @linear-gradient(180deg, Theme.n-glass-strong 0%, Theme.n-glass-strong 100%);
        border-width: 1px;
        border-color: Theme.is-dark ? Theme.n-line-strong : Theme.n-glass-edge;
        drop-shadow-blur: 34px;
        drop-shadow-color: Theme.is-dark ? rgba(0, 0, 0, 0.46) : rgba(0, 0, 0, 0.16);
        drop-shadow-offset-y: 12px;
        clip: true;
        animate y { duration: Theme.n-sheet; easing: Theme.ease-out; }

        VerticalLayout {
            padding: 16px;
            spacing: 0px;
            Rectangle {
                height: 4px;
                width: 38px;
                border-radius: 2px;
                background: Theme.n-muted;
                opacity: 0.40;
            }
            Text {
                text: root.title;
                font-size: Theme.n-card;
                font-weight: 720;
                color: Theme.n-ink;
                letter-spacing: -0.2px;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.n-secondary;
                color: Theme.n-muted;
                wrap: word-wrap;
            }
            @children
        }
    }
}

export component NemoDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title: "";
    in property <string> subtitle: "";
    callback close;

    background: transparent;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.n-scrim;
        opacity: root.open ? 1.0 : 0.0;
        animate opacity { duration: Theme.n-sheet; }
        TouchArea {
            enabled: root.open;
            clicked => { root.close(); }
        }
    }
    Rectangle {
        x: 24px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 48px;
        height: content.preferred-height + 40px;
        border-radius: Theme.n-r-sheet;
        background: Theme.n-glass-strong;
        border-width: 1px;
        border-color: Theme.n-line;
        drop-shadow-blur: 30px;
        drop-shadow-color: rgba(0, 0, 0, 0.18);
        drop-shadow-offset-y: 10px;
        opacity: root.open ? 1.0 : 0.0;
        animate opacity { duration: Theme.n-sheet; }

        content := VerticalLayout {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            spacing: 10px;
            Text {
                text: root.title;
                font-size: Theme.n-card;
                font-weight: 720;
                color: Theme.n-ink;
                horizontal-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.n-secondary;
                color: Theme.n-muted;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            @children
        }
    }
}

// ---------------------------------------------------------------------------
// States
// ---------------------------------------------------------------------------

export component NemoStateView inherits Rectangle {
    in property <string> state: "empty"; // loading | empty | error | offline | success
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> action-text: "";
    callback action;

    height: 240px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.n-sm;

        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 22px;
            background: Theme.n-glass-soft;
            border-width: 1px;
            border-color: Theme.n-line;
            drop-shadow-blur: 14px;
            drop-shadow-color: Theme.n-inner-shadow;
            drop-shadow-offset-y: 4px;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.state == "loading" ? "..." : root.state == "error" ? "!" : root.state == "offline" ? "x" : "◇";
                font-size: 22px;
                font-weight: 650;
                color: Theme.n-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.title;
            font-size: Theme.n-card;
            font-weight: 700;
            color: Theme.n-ink;
            horizontal-alignment: center;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Theme.n-secondary;
            color: Theme.n-muted;
            horizontal-alignment: center;
            width: 260px;
            wrap: word-wrap;
        }
        if root.action-text != "": TouchArea {
            height: 38px;
            mouse-cursor: pointer;
            clicked => { root.action(); }
            Text {
                height: 38px;
                text: root.action-text;
                font-size: Theme.n-secondary;
                font-weight: 700;
                color: Theme.n-ink;
                vertical-alignment: center;
            }
        }
    }
}

export component EmptyState inherits NemoStateView { }

// ---------------------------------------------------------------------------
// Typing indicator
// ---------------------------------------------------------------------------

export component NemoTypingBubble inherits Rectangle {
    width: 68px;
    height: 40px;
    border-radius: 20px;
    background: Theme.n-glass-soft;
    border-width: 1px;
    border-color: Theme.n-line;

    Rectangle { width: 7px; height: 7px; x: 17px; y: 16px; border-radius: 4px; background: Theme.n-muted; opacity: 0.40; }
    Rectangle { width: 7px; height: 7px; x: 30px; y: 16px; border-radius: 4px; background: Theme.n-muted; opacity: 0.70; }
    Rectangle { width: 7px; height: 7px; x: 43px; y: 16px; border-radius: 4px; background: Theme.n-muted; opacity: 1.0; }
}

export component TypingBubble inherits NemoTypingBubble { }
