// Onboarding: Welcome, Sign-up (with recovery reveal), Login, Terms.
//
// Verified against Slint 1.18.1:
// - string members: character-count / is-empty / to-lowercase / to-uppercase
// - color member fns, Math.*, pure functions inside components only.

import { Theme } from "../theme.slint";
import {
    NookLogo, Back, Check,
} from "../icons.slint";
import {
    ScreenBackground, GlassCard, PrimaryButton, GhostButton, TextButton,
    NookField,
} from "../widgets.slint";

// ---------------------------------------------------------------------------
// Welcome
// ---------------------------------------------------------------------------

// Monochrome Liquid Glass welcome / auth screen (mobile-first).
export component WelcomeScreen inherits Rectangle {
    callback sign-up;
    callback log-in;
    background: transparent;

    // Local monochrome palette (matches the approved HTML reference).
    in-out property <bool> signup-mode: false;
    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> show-password: false;
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> display-name: "";
    in-out property <string> confirm-password: "";
    in-out property <bool> remember: false;
    in-out property <bool> terms: false;
    in-out property <string> toast: "";
    in-out property <bool> touch-lit: false;
    in-out property <int> ripple-key: 0;

    // Ambient palette
    property <color> bg: dark ? #111111 : #f1f1ef;
    property <color> ink: dark ? #f4f4f2 : #171717;
    property <color> ink-2: dark ? #d7d7d4 : #3f3f3f;
    property <color> muted: dark ? #aaa9a5 : #777775;
    property <color> paper: dark ? #252525 : #ffffff;
    property <color> paper-strong: dark ? #2b2b2b : #ffffff;
    property <color> field: dark ? #121212 : #f4f4f2;
    property <color> line: dark ? rgba(255,255,255,0.105) : rgba(30,30,30,0.095);

    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 18px;
        padding-bottom: 22px;
        spacing: 0px;

        // Ambient blobs
        Rectangle {
            height: 0px;
            Rectangle {
                x: parent.width - 205px;
                y: -275px;
                width: 440px;
                height: 440px;
                border-radius: 220px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.18) 0%, rgba(150,150,150,0.13) 34%, transparent 70%)
                    : @radial-gradient(circle, rgba(255,255,255,0.95) 0%, rgba(205,205,202,0.36) 34%, transparent 70%);
                opacity: 0.8;
            }
            Rectangle {
                x: -235px;
                y: 520px;
                width: 390px;
                height: 390px;
                border-radius: 195px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.14) 0%, rgba(150,150,150,0.10) 37%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.83) 0%, rgba(190,190,186,0.30) 37%, transparent 72%);
                opacity: 0.8;
            }
        }

        // Top bar
        HorizontalLayout {
            height: 48px;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 27px;
                height: 27px;
                border-radius: 13.5px;
                background: dark
                    ? @radial-gradient(circle, #f5f5f3 0%, #aaa 18%, #555 55%, #222 100%)
                    : @radial-gradient(circle, #fff 0%, #d7d7d4 18%, #8d8d89 55%, #4a4a48 100%);
                border-width: 1px;
                border-color: rgba(255,255,255,0.55);
            }
            Text {
                text: "nemo";
                font-size: 17px;
                font-weight: 720;
                color: ink;
                letter-spacing: -0.5px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // Theme toggle
            TouchArea {
                width: 38px;
                height: 38px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 19px;
                    background: paper;
                    border-width: 1px;
                    border-color: line;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.dark ? "☀" : "☾";
                        font-size: 16px;
                        color: ink-2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Content
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 24px;

                // Intro
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "YOUR SPACE, YOUR PEOPLE";
                        font-size: 10px;
                        font-weight: 700;
                        color: muted;
                        letter-spacing: 1.9px;
                    }
                    Text {
                        text: root.signup-mode ? "Make room\nfor your people." : "Good to\nhave you back.";
                        font-size: 40px;
                        font-weight: 690;
                        color: ink;
                        letter-spacing: -2.7px;

                    }
                    Text {
                        text: root.signup-mode
                            ? "Create your space. The good conversations start here."
                            : "A quieter place for the conversations that matter.";
                        font-size: 14px;
                        color: muted;

                    }
                }

                // Glass card
                Rectangle {
                    // shell border
                    border-radius: 30px;
                    background: dark
                        ? @linear-gradient(145deg, rgba(255,255,255,0.34) 0%, rgba(255,255,255,0.08) 34%, rgba(255,255,255,0.035) 72%, rgba(255,255,255,0.20) 100%)
                        : @linear-gradient(145deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.34) 34%, rgba(120,120,120,0.16) 72%, rgba(255,255,255,0.82) 100%);
                    drop-shadow-blur: 28px;
                    drop-shadow-color: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.085);
                    drop-shadow-offset-y: 10px;

                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.touch-lit = true;
                            root.ripple-key = root.ripple-key + 1;
                        }
                        Rectangle {
                            // glass card
                            border-radius: 29px;
                            x: 1px; y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            background: dark
                                ? @linear-gradient(145deg, rgba(47,47,47,0.92) 0%, rgba(31,31,31,0.78) 56%, rgba(45,45,45,0.80) 100%)
                                : @linear-gradient(145deg, paper-strong 0%, paper 56%, rgba(230,230,227,0.52) 100%);
                            clip: true;

                            // touch-lit reflection
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: dark
                                    ? @radial-gradient(circle, rgba(255,255,255,0.16) 0%, transparent 36%)
                                    : @radial-gradient(circle, rgba(255,255,255,0.34) 0%, transparent 34%);
                                opacity: root.touch-lit ? 1 : 0;
                                animate opacity { duration: 620ms; easing: ease-out; }
                            }
                            // glass flow
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: dark
                                    ? @linear-gradient(125deg, rgba(255,255,255,0.18) 0%, transparent 24%, transparent 66%, rgba(255,255,255,0.06) 100%)
                                    : @linear-gradient(125deg, rgba(255,255,255,0.58) 0%, transparent 24%, transparent 66%, rgba(255,255,255,0.10) 100%);
                                opacity: 0.72;
                            }
                            // edge shimmer top
                            Rectangle {
                                x: parent.width * 0.12; y: 0px;
                                width: parent.width * 0.76; height: 1px;
                                background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.98) 50%, transparent 100%);
                            }

                            VerticalLayout {
                                padding-left: 23px;
                                padding-right: 23px;
                                padding-top: 27px;
                                padding-bottom: 22px;
                                spacing: 14px;

                                // Card heading
                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: root.signup-mode ? "Create your account" : "Welcome back";
                                        font-size: 21px;
                                        font-weight: 670;
                                        color: ink;
                                        letter-spacing: -0.9px;
                                    }
                                    Text {
                                        text: root.signup-mode ? "A few details and you're all set." : "Sign in to continue to Nemo.";
                                        font-size: 12.5px;
                                        color: muted;
                                    }
                                }

                                // Display name (signup only)
                                if root.signup-mode: VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Display name"; font-size: 11px; font-weight: 650; color: ink-2; }
                                    Rectangle {
                                        height: 49px;
                                        border-radius: 15px;
                                        background: field;
                                        border-width: 1px;
                                        border-color: line;
                                        HorizontalLayout {
                                            padding-left: 15px; padding-right: 15px;
                                            TextInput {
                                                text <=> root.display-name;
                                                font-size: 14px;
                                                color: ink;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Username
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Username"; font-size: 11px; font-weight: 650; color: ink-2; }
                                    Rectangle {
                                        height: 53px;
                                        border-radius: 15px;
                                        background: field;
                                        border-width: 1px;
                                        border-color: line;
                                        HorizontalLayout {
                                            padding-left: 15px; padding-right: 15px;
                                            TextInput {
                                                text <=> root.username;
                                                font-size: 14px;
                                                color: ink;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Password
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Password"; font-size: 11px; font-weight: 650; color: ink-2; }
                                    Rectangle {
                                        height: 53px;
                                        border-radius: 15px;
                                        background: field;
                                        border-width: 1px;
                                        border-color: line;
                                        HorizontalLayout {
                                            padding-left: 15px; padding-right: 44px;
                                            TextInput {
                                                text <=> root.password;
                                                font-size: 14px;
                                                color: ink;
                                                vertical-alignment: center;
                                                input-type: root.show-password ? InputType.text : InputType.password;
                                            }
                                            TouchArea {
                                                width: 32px; height: 32px;
                                                mouse-cursor: pointer;
                                                clicked => { root.show-password = !root.show-password; }
                                            }
                                        }
                                    }
                                }

                                // Confirm password (signup only)
                                if root.signup-mode: VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Confirm password"; font-size: 11px; font-weight: 650; color: ink-2; }
                                    Rectangle {
                                        height: 49px;
                                        border-radius: 15px;
                                        background: field;
                                        border-width: 1px;
                                        border-color: line;
                                        HorizontalLayout {
                                            padding-left: 15px; padding-right: 15px;
                                            TextInput {
                                                text <=> root.confirm-password;
                                                font-size: 14px;
                                                color: ink;
                                                vertical-alignment: center;
                                                input-type: InputType.password;
                                            }
                                        }
                                    }
                                }

                                // Terms checkbox (signup only)
                                if root.signup-mode: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    TouchArea {
                                        width: 20px; height: 20px;
                                        mouse-cursor: pointer;
                                        clicked => { root.terms = !root.terms; }
                                        Rectangle {
                                            width: 16px; height: 16px;
                                            border-radius: 4px;
                                            background: root.terms ? ink : paper-strong;
                                            border-width: 1px;
                                            border-color: root.terms ? ink : muted;
                                            Text {
                                                width: parent.width; height: parent.height;
                                                text: root.terms ? "✓" : "";
                                                font-size: 10px;
                                                color: dark ? #171717 : #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "I agree to the Terms of Service and Privacy Policy.";
                                        font-size: 11px;
                                        color: muted;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }

                                // Remember me (login only)
                                if !root.signup-mode: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    TouchArea {
                                        width: 20px; height: 20px;
                                        mouse-cursor: pointer;
                                        clicked => { root.remember = !root.remember; }
                                        Rectangle {
                                            width: 16px; height: 16px;
                                            border-radius: 4px;
                                            background: root.remember ? ink : paper-strong;
                                            border-width: 1px;
                                            border-color: root.remember ? ink : muted;
                                            Text {
                                                width: parent.width; height: parent.height;
                                                text: root.remember ? "✓" : "";
                                                font-size: 10px;
                                                color: dark ? #171717 : #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "Remember me";
                                        font-size: 11px;
                                        color: muted;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: "Need help?";
                                        font-size: 11px;
                                        font-weight: 650;
                                        color: ink-2;
                                        vertical-alignment: center;
                                    }
                                }

                                // Primary button
                                TouchArea {
                                    height: 54px;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.signup-mode) { root.sign-up(); }
                                        else { root.log-in(); }
                                    }
                                    Rectangle {
                                        width: parent.width;
                                        height: 54px;
                                        border-radius: 16px;
                                        background: dark
                                            ? @linear-gradient(110deg, #f4f4f2 0%, #d7d7d4 100%)
                                            : @linear-gradient(110deg, #111 0%, #292929 48%, #171717 100%);
                                        border-width: 1px;
                                        border-color: dark ? rgba(255,255,255,0.5) : rgba(255,255,255,0.16);
                                        drop-shadow-blur: 18px;
                                        drop-shadow-color: dark ? rgba(0,0,0,0.28) : rgba(0,0,0,0.16);
                                        drop-shadow-offset-y: 8px;
                                        opacity: touch.pressed ? 0.92 : 1.0;
                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: root.signup-mode ? "Create account" : "Sign in";
                                            font-size: 13px;
                                            font-weight: 680;
                                            color: dark ? #171717 : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Switch mode
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Text {
                                        text: root.signup-mode ? "Already have an account?" : "New to Nemo?";
                                        font-size: 11.5px;
                                        color: muted;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        width: 110px; height: 24px;
                                        mouse-cursor: pointer;
                                        clicked => { root.signup-mode = !root.signup-mode; }
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: root.signup-mode ? "Sign in" : "Create an account";
                                            font-size: 11.5px;
                                            font-weight: 700;
                                            color: ink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Secure note
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 7px;
                                    Rectangle {
                                        width: 13px; height: 13px;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: muted;
                                    }
                                    Text {
                                        text: "Your conversations belong to you.";
                                        font-size: 10px;
                                        color: muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Footer
        Text {
            text: "Made for your people  ·  © Nemo";
            font-size: 10px;
            color: muted;
            horizontal-alignment: center;
        }

        // Toast
        if root.toast != "": Rectangle {
            x: (parent.width - 200px) / 2;
            width: 200px;
            height: 40px;
            border-radius: 14px;
            background: paper-strong;
            border-width: 1px;
            border-color: line;
            drop-shadow-blur: 20px;
            drop-shadow-color: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.085);
            Text {
                width: parent.width; height: parent.height;
                text: root.toast;
                font-size: 12px;
                color: ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Sign-up
// ---------------------------------------------------------------------------

export component SignUpScreen inherits Rectangle {
    callback back;                        // -> welcome
    callback submit(string, string, string); // username, display-name, password
    background: transparent;

    in-out property <string> username: "";
    in-out property <string> display-name: "";
    in-out property <string> password: "";
    in property <string> error: "";
    in property <bool> busy: false;

    // Pure heuristic over verified string members:
    // 0 empty / 1 weak / 2 okay / 3 good / 4 strong
    // Note: character-count is a pre-bound builtin call (used bare, no parens);
    // to-lowercase/to-uppercase are member functions (used with parens).
    pure function score() -> int {
        let len = password.character-count;
        if (len == 0) { return 0; }
        let upper = password.to-lowercase() != password;  // has capitals
        let lower = password.to-uppercase() != password;  // has lowercase
        return Math.min(
            (len >= 8 ? 1 : 0) + (len >= 12 ? 1 : 0) + (len >= 16 ? 1 : 0)
                + (upper ? 1 : 0) + (lower ? 1 : 0),
            4);
    }
    private property <int> score-now: score();

    pure function strength-color(level: int) -> color {
        if (level <= 1) { return Theme.danger; }
        if (level == 2) { return #F5A524; }
        if (level == 3) { return #E3C341; }
        return Theme.online;
    }
    pure function strength-label(level: int) -> string {
        if (level <= 1) { return "Weak"; }
        if (level == 2) { return "Okay"; }
        if (level == 3) { return "Good"; }
        return "Strong";
    }

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Text {
            text: "Create your account";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
        }
        Text {
            text: "Pick a handle friends can find you by.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
        }

        NookField {
            label: "Username";
            placeholder: "e.g. maple_syrup";
            text <=> root.username;
            error: root.error;
        }
        NookField {
            label: "Display name";
            placeholder: "How you'll appear to others";
            text <=> root.display-name;
        }
        NookField {
            label: "Password";
            placeholder: "At least 10 characters";
            password: true;
            text <=> root.password;
        }

        // Strength meter
        HorizontalLayout {
            spacing: 6px;
            height: 22px;
            alignment: start;
            for i in 4: Rectangle {
                width: 34px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: root.score-now >= (i + 1)
                    ? root.strength-color(root.score-now)
                    : Theme.c-hairline;
            }
            Text {
                text: root.strength-label(root.score-now);
                font-size: Theme.fs-caption;
                font-weight: 600;
                color: Theme.c-text-3;
                vertical-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        PrimaryButton {
            text: root.busy ? "Creating…" : "Create account";
            enabled: !root.busy && root.score-now >= 2;
            clicked => { root.submit(root.username, root.display-name, root.password); }
        }
    }
}

// ---------------------------------------------------------------------------
// Recovery codes reveal (right after sign-up)
// ---------------------------------------------------------------------------

export component RecoveryScreen inherits Rectangle {
    in property <[string]> codes;
    callback saved;   // -> login
    background: transparent;

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        Text {
            text: "Save your recovery codes";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
        }
        Text {
            text: "Nemo has no email or phone. If you ever forget your password, a recovery code is the only way back in. Write them down and keep them somewhere safe.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
            wrap: word-wrap;
        }

        GlassCard {
            vertical-stretch: 1;
            VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-2;
                alignment: center;
                for code in root.codes: Text {
                    text: code;
                    font-size: Theme.fs-body-lg;
                    font-weight: 700;
                    color: Theme.c-text;
                    horizontal-alignment: center;
                    letter-spacing: 1.4px;
                }
            }
        }

        PrimaryButton {
            text: "I've saved them";
            clicked => { root.saved(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Login
// ---------------------------------------------------------------------------

export component LoginScreen inherits Rectangle {
    callback back;
    callback submit(string, string); // username, password
    callback forgot;                 // -> recovery entry
    background: transparent;

    in-out property <string> username: "";
    in-out property <string> password: "";
    in property <string> error: "";
    in property <bool> busy: false;

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            NookLogo {
                compact: true;
                size: 64px;
                x: (parent.width - self.width) / 2;
            }
        }
        Text {
            text: "Welcome back";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
            horizontal-alignment: center;
        }
        Text {
            text: "Log in to your nook.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
            horizontal-alignment: center;
        }

        Rectangle { height: Theme.sp-2; }

        NookField {
            label: "Username";
            placeholder: "your handle";
            text <=> root.username;
            error: root.error;
        }
        NookField {
            label: "Password";
            placeholder: "••••••••••";
            password: true;
            text <=> root.password;
        }

        Rectangle { vertical-stretch: 1; }

        PrimaryButton {
            text: root.busy ? "Logging in…" : "Log in";
            enabled: !root.busy;
            clicked => { root.submit(root.username, root.password); }
        }
        TextButton {
            text: "Use a recovery code instead";
            clicked => { root.forgot(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Terms
// ---------------------------------------------------------------------------

export struct PolicySection {
    heading: string,
    body: string,
}

export component TermsScreen inherits Rectangle {
    in property <string> doc-title;
    in property <[PolicySection]> sections;
    in property <bool> gate: true;              // require checkbox
    callback agreed(bool);
    callback continue-p;
    callback back;
    background: transparent;

    in-out property <bool> accepted: false;

    VerticalLayout {
        padding-left: Theme.sp-5;
        padding-right: Theme.sp-5;
        padding-top: 8px;
        padding-bottom: Theme.sp-5;
        spacing: Theme.sp-3;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Text {
            text: root.doc-title;
            font-size: Theme.fs-title;
            font-weight: 800;
            color: Theme.c-text;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.r-card;
            background: Theme.c-surface-alpha;
            border-width: 1px;
            border-color: Theme.c-stroke-glass;
            clip: true;
            Flickable {
                VerticalLayout {
                    padding-top: Theme.sp-4;
                    padding-bottom: Theme.sp-4;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: Theme.sp-3;
                    for s in root.sections: VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: s.heading;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            color: Theme.c-text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: s.body;
                            font-size: Theme.fs-small;
                            color: Theme.c-text-2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Agreement checkbox
        if root.gate: HorizontalLayout {
            spacing: Theme.sp-3;
            alignment: start;
            TouchArea {
                width: 30px;
                mouse-cursor: pointer;
                clicked => { root.accepted = !root.accepted; root.agreed(root.accepted); }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 2px;
                    border-radius: 8px;
                    background: root.accepted ? Theme.accent : transparent;
                    border-width: 1.6px;
                    border-color: root.accepted ? Theme.accent : Theme.c-text-3;
                    Check {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        size: 18px;
                        tint: white;
                    }
                }
            }
            Text {
                text: "I have read and agree to these terms.";
                font-size: Theme.fs-small;
                color: Theme.c-text-2;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        PrimaryButton {
            text: "Continue";
            enabled: !root.gate || root.accepted;
            clicked => { root.continue-p(); }
        }
    }
}
