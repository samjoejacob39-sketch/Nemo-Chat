// Onboarding: Welcome, Sign-up (with recovery reveal), Login, Terms.
//
// Verified against Slint 1.18.1:
// - string members: character-count / is-empty / to-lowercase / to-uppercase
// - color member fns, Math.*, pure functions inside components only.

import { Theme } from "../theme.slint";
import {
    NookLogo, Back, Check,
} from "../icons.slint";
import {
    ScreenBackground, GlassCard, PrimaryButton, GhostButton, TextButton,
    NookField,
} from "../widgets.slint";

// ---------------------------------------------------------------------------
// Welcome
// ---------------------------------------------------------------------------

// Welcome / onboarding screen — monochrome Liquid Glass (mobile-first).
export component WelcomeScreen inherits Rectangle {
    callback sign-up;
    callback log-in;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;

    property <color> ink: dark ? #f3f3f1 : #171717;
    property <color> ink-soft: dark ? #dadad7 : #3d3d3b;
    property <color> muted: dark ? #a1a19d : #777774;
    property <color> line: dark ? rgba(255,255,255,0.11) : rgba(25,25,25,0.09);
    property <color> glass: dark ? rgba(42,42,42,0.58) : rgba(255,255,255,0.59);
    property <color> glass-strong: dark ? rgba(52,52,52,0.76) : rgba(255,255,255,0.79);

    VerticalLayout {
        padding-left: 23px;
        padding-right: 23px;
        padding-top: 18px;
        padding-bottom: 20px;
        spacing: 0px;

        // Ambient blobs
        Rectangle {
            height: 0px;
            Rectangle {
                x: parent.width / 2 - 215px;
                y: -235px;
                width: 430px;
                height: 430px;
                border-radius: 215px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.16) 0%, rgba(180,180,180,0.10) 32%, transparent 70%)
                    : @radial-gradient(circle, rgba(255,255,255,0.96) 0%, rgba(211,211,207,0.45) 32%, transparent 70%);
                opacity: 0.72;
            }
            Rectangle {
                x: parent.width - 190px;
                y: 480px;
                width: 360px;
                height: 360px;
                border-radius: 180px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.10) 0%, rgba(180,180,180,0.06) 38%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.83) 0%, rgba(185,185,180,0.26) 38%, transparent 72%);
                opacity: 0.72;
            }
        }

        // Top bar
        HorizontalLayout {
            height: 46px;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: dark
                    ? @linear-gradient(145deg, #777 0%, #262626 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(190,190,186,0.42) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.25) : rgba(255,255,255,0.93);
                drop-shadow-blur: 9px;
                drop-shadow-color: rgba(0,0,0,0.08);
                drop-shadow-offset-y: 3px;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "n";
                    font-size: 14px;
                    font-weight: 780;
                    color: dark ? #f2f2ef : #343432;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "nemo";
                font-size: 17px;
                font-weight: 750;
                color: ink;
                letter-spacing: -1.1px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 39px;
                height: 39px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 39px;
                    height: 39px;
                    border-radius: 19.5px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.035);
                    drop-shadow-offset-y: 3px;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.dark ? "☀" : "☾";
                        font-size: 17px;
                        color: ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Hero art
        Rectangle {
            vertical-stretch: 1;
            min-height: 180px;
            clip: true;
            // orbital
            Rectangle {
                x: (parent.width - 300px) / 2;
                y: 20px;
                width: 300px;
                height: 216px;
                border-radius: 150px;
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.10) : rgba(120,120,115,0.13);
            }
            // art glow
            Rectangle {
                x: (parent.width - 210px) / 2;
                y: 60px;
                width: 210px;
                height: 210px;
                border-radius: 105px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(190,190,190,0.08) 48%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.96) 0%, rgba(201,201,197,0.32) 48%, transparent 72%);
                opacity: 0.85;
            }
            // glass dot
            Rectangle {
                x: (parent.width - 288px) / 2;
                y: 47px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: dark
                    ? @linear-gradient(145deg, #777 0%, #292929 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.98) 0%, rgba(190,190,185,0.48) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.25) : rgba(255,255,255,0.95);
                drop-shadow-blur: 20px;
                drop-shadow-color: rgba(0,0,0,0.08);
                drop-shadow-offset-y: 10px;
            }
            // main message card
            Rectangle {
                x: (parent.width - 248px) / 2;
                y: Math.max(0px, (parent.height - 152px) / 2 - 10px);
                width: 248px;
                height: 152px;
                border-radius: 22px;
                background: dark
                    ? @linear-gradient(145deg, rgba(66,66,66,0.82) 0%, rgba(34,34,34,0.68) 56%, rgba(55,55,55,0.52) 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.84) 0%, rgba(245,245,243,0.48) 54%, rgba(218,218,214,0.40) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.20) : rgba(255,255,255,0.92);
                drop-shadow-blur: 30px;
                drop-shadow-color: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.09);
                drop-shadow-offset-y: 22px;
                clip: true;

                HorizontalLayout {
                    x: 17px; y: 17px;
                    width: 214px;
                    height: 29px;
                    spacing: 9px;
                    Rectangle {
                        width: 29px; height: 29px;
                        border-radius: 14.5px;
                        background: dark
                            ? @linear-gradient(145deg, #777 0%, #333 100%)
                            : @linear-gradient(145deg, #fafaf8 0%, #bdbdb9 100%);
                        border-width: 1px;
                        border-color: dark ? #888 : rgba(255,255,255,0.95);
                        Text {
                            width: parent.width; height: parent.height;
                            text: "A";
                            font-size: 10px;
                            font-weight: 750;
                            color: dark ? #fff : #555;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Alex";
                        font-size: 11px;
                        font-weight: 720;
                        color: ink;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "now";
                        font-size: 9px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                Text {
                    x: 17px; y: 58px;
                    width: 190px;
                    text: "Some people just make the day better.";
                    font-size: 16px;
                    font-weight: 620;
                    color: ink;
                    letter-spacing: -0.7px;
                    wrap: word-wrap;
                }
                Text {
                    x: 17px; y: 122px;
                    text: "A little closer, wherever you are.";
                    font-size: 10px;
                    color: muted;
                }
            }
            // mini bubble
            Rectangle {
                x: parent.width - 176px;
                y: Math.max(0px, parent.height - 60px);
                width: 156px;
                height: 62px;
                border-radius: 22px;
                background: dark
                    ? @linear-gradient(145deg, rgba(66,66,66,0.82) 0%, rgba(34,34,34,0.68) 56%, rgba(55,55,55,0.52) 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.84) 0%, rgba(245,245,243,0.48) 54%, rgba(218,218,214,0.40) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.20) : rgba(255,255,255,0.92);
                drop-shadow-blur: 24px;
                drop-shadow-color: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.09);
                drop-shadow-offset-y: 14px;
                clip: true;
                VerticalLayout {
                    padding-left: 14px;
                    padding-top: 12px;
                    spacing: 5px;
                    Text {
                        text: "I'm always here.";
                        font-size: 12px;
                        font-weight: 600;
                        color: ink;
                        letter-spacing: -0.3px;
                    }
                    Text {
                        text: "Delivered just now";
                        font-size: 9px;
                        color: muted;
                    }
                }
            }
        }

        // Copy
        VerticalLayout {
            spacing: 8px;
            alignment: center;
            Text {
                text: "A space for your people";
                font-size: 10px;
                font-weight: 760;
                color: muted;
                letter-spacing: 1.9px;
                horizontal-alignment: center;
            }
            Text {
                text: "Conversations that feel closer.";
                font-size: 38px;
                font-weight: 720;
                color: ink;
                letter-spacing: -2.7px;
                horizontal-alignment: center;
            }
            Text {
                text: "Keep up with your friends, share the little things, and stay connected in one quiet space.";
                font-size: 14px;
                color: muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Actions
        VerticalLayout {
            spacing: 10px;
            TouchArea {
                height: 56px;
                mouse-cursor: pointer;
                clicked => { root.sign-up(); }
                Rectangle {
                    width: parent.width;
                    height: 56px;
                    border-radius: 19px;
                    background: dark ? #f1f1ef : #171717;
                    border-width: 1px;
                    border-color: dark ? rgba(255,255,255,0.5) : rgba(255,255,255,0.16);
                    drop-shadow-blur: 22px;
                    drop-shadow-color: dark ? rgba(0,0,0,0.28) : rgba(0,0,0,0.13);
                    drop-shadow-offset-y: 9px;
                    opacity: 1.0;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px;
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: "Get started";
                            font-size: 14px;
                            font-weight: 690;
                            color: dark ? #161616 : #ffffff;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "→";
                            font-size: 16px;
                            color: dark ? #161616 : #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            TouchArea {
                height: 56px;
                mouse-cursor: pointer;
                clicked => { root.log-in(); }
                Rectangle {
                    width: parent.width;
                    height: 56px;
                    border-radius: 19px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.035);
                    drop-shadow-offset-y: 3px;
                    opacity: 1.0;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "I already have an account";
                        font-size: 14px;
                        font-weight: 690;
                        color: ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: "By continuing, you agree to Nemo's Terms and Privacy Policy.";
            font-size: 10px;
            color: muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// ---------------------------------------------------------------------------
// Sign-up
// ---------------------------------------------------------------------------

export component SignUpScreen inherits Rectangle {
    callback back;                        // -> welcome
    callback submit(string, string, string); // username, display-name, password
    background: transparent;

    in-out property <string> username: "";
    in-out property <string> display-name: "";
    in-out property <string> password: "";
    in property <string> error: "";
    in property <bool> busy: false;

    // Pure heuristic over verified string members:
    // 0 empty / 1 weak / 2 okay / 3 good / 4 strong
    // Note: character-count is a pre-bound builtin call (used bare, no parens);
    // to-lowercase/to-uppercase are member functions (used with parens).
    pure function score() -> int {
        let len = password.character-count;
        if (len == 0) { return 0; }
        let upper = password.to-lowercase() != password;  // has capitals
        let lower = password.to-uppercase() != password;  // has lowercase
        return Math.min(
            (len >= 8 ? 1 : 0) + (len >= 12 ? 1 : 0) + (len >= 16 ? 1 : 0)
                + (upper ? 1 : 0) + (lower ? 1 : 0),
            4);
    }
    private property <int> score-now: score();

    pure function strength-color(level: int) -> color {
        if (level <= 1) { return Theme.danger; }
        if (level == 2) { return #F5A524; }
        if (level == 3) { return #E3C341; }
        return Theme.online;
    }
    pure function strength-label(level: int) -> string {
        if (level <= 1) { return "Weak"; }
        if (level == 2) { return "Okay"; }
        if (level == 3) { return "Good"; }
        return "Strong";
    }

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Text {
            text: "Create your account";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
        }
        Text {
            text: "Pick a handle friends can find you by.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
        }

        NookField {
            label: "Username";
            placeholder: "e.g. maple_syrup";
            text <=> root.username;
            error: root.error;
        }
        NookField {
            label: "Display name";
            placeholder: "How you'll appear to others";
            text <=> root.display-name;
        }
        NookField {
            label: "Password";
            placeholder: "At least 10 characters";
            password: true;
            text <=> root.password;
        }

        // Strength meter
        HorizontalLayout {
            spacing: 6px;
            height: 22px;
            alignment: start;
            for i in 4: Rectangle {
                width: 34px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: root.score-now >= (i + 1)
                    ? root.strength-color(root.score-now)
                    : Theme.c-hairline;
            }
            Text {
                text: root.strength-label(root.score-now);
                font-size: Theme.fs-caption;
                font-weight: 600;
                color: Theme.c-text-3;
                vertical-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        PrimaryButton {
            text: root.busy ? "Creating…" : "Create account";
            enabled: !root.busy && root.score-now >= 2;
            clicked => { root.submit(root.username, root.display-name, root.password); }
        }
    }
}

// ---------------------------------------------------------------------------
// Recovery codes reveal (right after sign-up)
// ---------------------------------------------------------------------------

export component RecoveryScreen inherits Rectangle {
    in property <[string]> codes;
    callback saved;   // -> login
    background: transparent;

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        Text {
            text: "Save your recovery codes";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
        }
        Text {
            text: "Nemo has no email or phone. If you ever forget your password, a recovery code is the only way back in. Write them down and keep them somewhere safe.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
            wrap: word-wrap;
        }

        GlassCard {
            vertical-stretch: 1;
            VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-2;
                alignment: center;
                for code in root.codes: Text {
                    text: code;
                    font-size: Theme.fs-body-lg;
                    font-weight: 700;
                    color: Theme.c-text;
                    horizontal-alignment: center;
                    letter-spacing: 1.4px;
                }
            }
        }

        PrimaryButton {
            text: "I've saved them";
            clicked => { root.saved(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Login
// ---------------------------------------------------------------------------

export component LoginScreen inherits Rectangle {
    callback back;
    callback submit(string, string); // username, password
    callback forgot;                 // -> recovery entry
    background: transparent;

    in-out property <string> username: "";
    in-out property <string> password: "";
    in property <string> error: "";
    in property <bool> busy: false;

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            NookLogo {
                compact: true;
                size: 64px;
                x: (parent.width - self.width) / 2;
            }
        }
        Text {
            text: "Welcome back";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
            horizontal-alignment: center;
        }
        Text {
            text: "Log in to your nook.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
            horizontal-alignment: center;
        }

        Rectangle { height: Theme.sp-2; }

        NookField {
            label: "Username";
            placeholder: "your handle";
            text <=> root.username;
            error: root.error;
        }
        NookField {
            label: "Password";
            placeholder: "••••••••••";
            password: true;
            text <=> root.password;
        }

        Rectangle { vertical-stretch: 1; }

        PrimaryButton {
            text: root.busy ? "Logging in…" : "Log in";
            enabled: !root.busy;
            clicked => { root.submit(root.username, root.password); }
        }
        TextButton {
            text: "Use a recovery code instead";
            clicked => { root.forgot(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Terms
// ---------------------------------------------------------------------------

export struct PolicySection {
    heading: string,
    body: string,
}

export component TermsScreen inherits Rectangle {
    in property <string> doc-title;
    in property <[PolicySection]> sections;
    in property <bool> gate: true;              // require checkbox
    callback agreed(bool);
    callback continue-p;
    callback back;
    background: transparent;

    in-out property <bool> accepted: false;

    VerticalLayout {
        padding-left: Theme.sp-5;
        padding-right: Theme.sp-5;
        padding-top: 8px;
        padding-bottom: Theme.sp-5;
        spacing: Theme.sp-3;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Text {
            text: root.doc-title;
            font-size: Theme.fs-title;
            font-weight: 800;
            color: Theme.c-text;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.r-card;
            background: Theme.c-surface-alpha;
            border-width: 1px;
            border-color: Theme.c-stroke-glass;
            clip: true;
            Flickable {
                VerticalLayout {
                    padding-top: Theme.sp-4;
                    padding-bottom: Theme.sp-4;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: Theme.sp-3;
                    for s in root.sections: VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: s.heading;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            color: Theme.c-text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: s.body;
                            font-size: Theme.fs-small;
                            color: Theme.c-text-2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Agreement checkbox
        if root.gate: HorizontalLayout {
            spacing: Theme.sp-3;
            alignment: start;
            TouchArea {
                width: 30px;
                mouse-cursor: pointer;
                clicked => { root.accepted = !root.accepted; root.agreed(root.accepted); }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 2px;
                    border-radius: 8px;
                    background: root.accepted ? Theme.accent : transparent;
                    border-width: 1.6px;
                    border-color: root.accepted ? Theme.accent : Theme.c-text-3;
                    Check {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        size: 18px;
                        tint: white;
                    }
                }
            }
            Text {
                text: "I have read and agree to these terms.";
                font-size: Theme.fs-small;
                color: Theme.c-text-2;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        PrimaryButton {
            text: "Continue";
            enabled: !root.gate || root.accepted;
            clicked => { root.continue-p(); }
        }
    }
}
