// Onboarding: Welcome, Sign-up (with recovery reveal), Login, Terms.
//
// Verified against Slint 1.18.1:
// - string members: character-count / is-empty / to-lowercase / to-uppercase
// - color member fns, Math.*, pure functions inside components only.

import { Theme } from "../theme.slint";
import {
    NookLogo, Back, Check,
} from "../icons.slint";
import {
    ScreenBackground, GlassCard, PrimaryButton, GhostButton, TextButton,
    NookField,
} from "../widgets.slint";

// ---------------------------------------------------------------------------
// Welcome
// ---------------------------------------------------------------------------

// Welcome / onboarding screen — monochrome Liquid Glass (mobile-first).
export component WelcomeScreen inherits Rectangle {
    callback sign-up;
    callback log-in;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;

    property <color> ink: dark ? #f3f3f1 : #171717;
    property <color> ink-soft: dark ? #dadad7 : #3d3d3b;
    property <color> muted: dark ? #a1a19d : #777774;
    property <color> line: dark ? rgba(255,255,255,0.11) : rgba(25,25,25,0.09);
    property <color> glass: dark ? rgba(42,42,42,0.58) : rgba(255,255,255,0.59);
    property <color> glass-strong: dark ? rgba(52,52,52,0.76) : rgba(255,255,255,0.79);

    VerticalLayout {
        padding-left: 23px;
        padding-right: 23px;
        padding-top: 18px;
        padding-bottom: 20px;
        spacing: 0px;

        // Ambient blobs
        Rectangle {
            height: 0px;
            Rectangle {
                x: parent.width / 2 - 215px;
                y: -235px;
                width: 430px;
                height: 430px;
                border-radius: 215px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.16) 0%, rgba(180,180,180,0.10) 32%, transparent 70%)
                    : @radial-gradient(circle, rgba(255,255,255,0.96) 0%, rgba(211,211,207,0.45) 32%, transparent 70%);
                opacity: 0.72;
            }
            Rectangle {
                x: parent.width - 190px;
                y: 480px;
                width: 360px;
                height: 360px;
                border-radius: 180px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.10) 0%, rgba(180,180,180,0.06) 38%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.83) 0%, rgba(185,185,180,0.26) 38%, transparent 72%);
                opacity: 0.72;
            }
        }

        // Top bar
        HorizontalLayout {
            height: 46px;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: dark
                    ? @linear-gradient(145deg, #777 0%, #262626 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(190,190,186,0.42) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.25) : rgba(255,255,255,0.93);
                drop-shadow-blur: 9px;
                drop-shadow-color: rgba(0,0,0,0.08);
                drop-shadow-offset-y: 3px;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "n";
                    font-size: 14px;
                    font-weight: 780;
                    color: dark ? #f2f2ef : #343432;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "nemo";
                font-size: 17px;
                font-weight: 750;
                color: ink;
                letter-spacing: -1.1px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 39px;
                height: 39px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 39px;
                    height: 39px;
                    border-radius: 19.5px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.035);
                    drop-shadow-offset-y: 3px;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.dark ? "☀" : "☾";
                        font-size: 17px;
                        color: ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Hero art
        Rectangle {
            vertical-stretch: 1;
            min-height: 180px;
            clip: true;
            // orbital
            Rectangle {
                x: (parent.width - 300px) / 2;
                y: 20px;
                width: 300px;
                height: 216px;
                border-radius: 150px;
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.10) : rgba(120,120,115,0.13);
            }
            // art glow
            Rectangle {
                x: (parent.width - 210px) / 2;
                y: 60px;
                width: 210px;
                height: 210px;
                border-radius: 105px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(190,190,190,0.08) 48%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.96) 0%, rgba(201,201,197,0.32) 48%, transparent 72%);
                opacity: 0.85;
            }
            // glass dot
            Rectangle {
                x: (parent.width - 288px) / 2;
                y: 47px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: dark
                    ? @linear-gradient(145deg, #777 0%, #292929 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.98) 0%, rgba(190,190,185,0.48) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.25) : rgba(255,255,255,0.95);
                drop-shadow-blur: 20px;
                drop-shadow-color: rgba(0,0,0,0.08);
                drop-shadow-offset-y: 10px;
            }
            // main message card
            Rectangle {
                x: (parent.width - 248px) / 2;
                y: Math.max(0px, (parent.height - 152px) / 2 - 10px);
                width: 248px;
                height: 152px;
                border-radius: 22px;
                background: dark
                    ? @linear-gradient(145deg, rgba(66,66,66,0.82) 0%, rgba(34,34,34,0.68) 56%, rgba(55,55,55,0.52) 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.84) 0%, rgba(245,245,243,0.48) 54%, rgba(218,218,214,0.40) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.20) : rgba(255,255,255,0.92);
                drop-shadow-blur: 30px;
                drop-shadow-color: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.09);
                drop-shadow-offset-y: 22px;
                clip: true;

                HorizontalLayout {
                    x: 17px; y: 17px;
                    width: 214px;
                    height: 29px;
                    spacing: 9px;
                    Rectangle {
                        width: 29px; height: 29px;
                        border-radius: 14.5px;
                        background: dark
                            ? @linear-gradient(145deg, #777 0%, #333 100%)
                            : @linear-gradient(145deg, #fafaf8 0%, #bdbdb9 100%);
                        border-width: 1px;
                        border-color: dark ? #888 : rgba(255,255,255,0.95);
                        Text {
                            width: parent.width; height: parent.height;
                            text: "A";
                            font-size: 10px;
                            font-weight: 750;
                            color: dark ? #fff : #555;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Alex";
                        font-size: 11px;
                        font-weight: 720;
                        color: ink;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "now";
                        font-size: 9px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                Text {
                    x: 17px; y: 58px;
                    width: 190px;
                    text: "Some people just make the day better.";
                    font-size: 16px;
                    font-weight: 620;
                    color: ink;
                    letter-spacing: -0.7px;
                    wrap: word-wrap;
                }
                Text {
                    x: 17px; y: 122px;
                    text: "A little closer, wherever you are.";
                    font-size: 10px;
                    color: muted;
                }
            }
            // mini bubble
            Rectangle {
                x: parent.width - 176px;
                y: Math.max(0px, parent.height - 60px);
                width: 156px;
                height: 62px;
                border-radius: 22px;
                background: dark
                    ? @linear-gradient(145deg, rgba(66,66,66,0.82) 0%, rgba(34,34,34,0.68) 56%, rgba(55,55,55,0.52) 100%)
                    : @linear-gradient(145deg, rgba(255,255,255,0.84) 0%, rgba(245,245,243,0.48) 54%, rgba(218,218,214,0.40) 100%);
                border-width: 1px;
                border-color: dark ? rgba(255,255,255,0.20) : rgba(255,255,255,0.92);
                drop-shadow-blur: 24px;
                drop-shadow-color: dark ? rgba(0,0,0,0.42) : rgba(0,0,0,0.09);
                drop-shadow-offset-y: 14px;
                clip: true;
                VerticalLayout {
                    padding-left: 14px;
                    padding-top: 12px;
                    spacing: 5px;
                    Text {
                        text: "I'm always here.";
                        font-size: 12px;
                        font-weight: 600;
                        color: ink;
                        letter-spacing: -0.3px;
                    }
                    Text {
                        text: "Delivered just now";
                        font-size: 9px;
                        color: muted;
                    }
                }
            }
        }

        // Copy
        VerticalLayout {
            spacing: 8px;
            alignment: center;
            Text {
                text: "A space for your people";
                font-size: 10px;
                font-weight: 760;
                color: muted;
                letter-spacing: 1.9px;
                horizontal-alignment: center;
            }
            Text {
                text: "Conversations that feel closer.";
                font-size: 38px;
                font-weight: 720;
                color: ink;
                letter-spacing: -2.7px;
                horizontal-alignment: center;
            }
            Text {
                text: "Keep up with your friends, share the little things, and stay connected in one quiet space.";
                font-size: 14px;
                color: muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Actions
        VerticalLayout {
            spacing: 10px;
            TouchArea {
                height: 56px;
                mouse-cursor: pointer;
                clicked => { root.sign-up(); }
                Rectangle {
                    width: parent.width;
                    height: 56px;
                    border-radius: 19px;
                    background: dark ? #f1f1ef : #171717;
                    border-width: 1px;
                    border-color: dark ? rgba(255,255,255,0.5) : rgba(255,255,255,0.16);
                    drop-shadow-blur: 22px;
                    drop-shadow-color: dark ? rgba(0,0,0,0.28) : rgba(0,0,0,0.13);
                    drop-shadow-offset-y: 9px;
                    opacity: 1.0;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px;
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: "Get started";
                            font-size: 14px;
                            font-weight: 690;
                            color: dark ? #161616 : #ffffff;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "→";
                            font-size: 16px;
                            color: dark ? #161616 : #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            TouchArea {
                height: 56px;
                mouse-cursor: pointer;
                clicked => { root.log-in(); }
                Rectangle {
                    width: parent.width;
                    height: 56px;
                    border-radius: 19px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.035);
                    drop-shadow-offset-y: 3px;
                    opacity: 1.0;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "I already have an account";
                        font-size: 14px;
                        font-weight: 690;
                        color: ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: "By continuing, you agree to Nemo's Terms and Privacy Policy.";
            font-size: 10px;
            color: muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// ---------------------------------------------------------------------------
// Sign-up
// Sign-up screen — monochrome Liquid Glass (mobile-first).
export component SignUpScreen inherits Rectangle {
    callback back;                        // -> welcome
    callback submit(string, string, string); // username, display-name, password
    background: transparent;

    in-out property <string> username: "";
    in-out property <string> display-name: "";
    in-out property <string> password: "";
    in-out property <string> confirm-password: "";
    in property <string> error: "";
    in property <bool> busy: false;
    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> show-password: false;
    in-out property <bool> show-confirm: false;

    property <color> ink: dark ? #f3f3f1 : #171717;
    property <color> ink-soft: dark ? #dadad7 : #3d3d3b;
    property <color> muted: dark ? #a1a19d : #77777d;
    property <color> line: dark ? rgba(255,255,255,0.11) : rgba(25,25,25,0.09);
    property <color> glass: dark ? rgba(42,42,42,0.58) : rgba(255,255,255,0.59);
    property <color> glass-strong: dark ? rgba(52,52,52,0.76) : rgba(255,255,255,0.78);
    property <color> field: dark ? rgba(18,18,18,0.62) : rgba(255,255,255,0.56);
    property <color> field-focus: dark ? rgba(30,30,30,0.85) : rgba(255,255,255,0.91);

    // Password strength (0..4)
    pure function score() -> int {
        let len = password.character-count;
        if (len == 0) { return 0; }
        let upper = password.to-lowercase() != password;
        let lower = password.to-uppercase() != password;
        return Math.min(
            (len >= 8 ? 1 : 0) + (len >= 12 ? 1 : 0) + (len >= 16 ? 1 : 0)
                + (upper ? 1 : 0) + (lower ? 1 : 0)
                + (password != confirm-password && confirm-password != "" ? 0 : 0),
            4);
    }
    private property <int> score-now: score();
    pure function strength-label(level: int) -> string {
        if (level == 0) { return "Not entered"; }
        if (level <= 1) { return "Weak"; }
        if (level == 2) { return "Fair"; }
        if (level == 3) { return "Good"; }
        return "Strong";
    }

    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 12px;
        
        spacing: 0px;

        // Top bar
        HorizontalLayout {
            height: 62px;
            alignment: start;
            TouchArea {
                width: 42px; height: 42px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 21px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(20,20,25,0.045);
                    drop-shadow-offset-y: 5px;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "←";
                        font-size: 18px;
                        color: ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "ACCOUNT SETUP   /   01";
                font-size: 11px;
                font-weight: 650;
                color: muted;
                letter-spacing: 1.3px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 42px; height: 42px; }
        }

        // Content
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 0px;

                // Avatar
                Rectangle {
                    height: 74px;
                    width: 74px;
                    x: (parent.width - 74px) / 2;
                    border-radius: 37px;
                    background: glass-strong;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 28px;
                    drop-shadow-color: rgba(22,22,26,0.09);
                    drop-shadow-offset-y: 12px;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "👤";
                        font-size: 32px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Intro
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "WELCOME TO NEMO";
                        font-size: 10px;
                        font-weight: 700;
                        color: muted;
                        letter-spacing: 1.7px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Create Account";
                        font-size: 29px;
                        font-weight: 720;
                        color: ink;
                        letter-spacing: -1.3px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "A little space for your favourite conversations.";
                        font-size: 13px;
                        color: muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Form card
                Rectangle {
                    border-radius: 31px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: rgba(20,20,25,0.075);
                    drop-shadow-offset-y: 18px;
                    clip: true;

                    // top specular
                    Rectangle {
                        x: 18px; y: 1px;
                        width: parent.width - 36px; height: 1px;
                        background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,1) 50%, transparent 100%);
                    }

                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 0px;

                        // Field: Name shown to friends
                        Rectangle {
                            height: 58px;
                            border-radius: 19px;
                            background: field;
                            border-width: 1px;
                            border-color: rgba(255,255,255,0.62);
                            
                            HorizontalLayout {
                                padding-left: 15px; padding-right: 15px;
                                spacing: 13px;
                                alignment: start;
                                Rectangle {
                                    width: 24px; height: 24px;
                                    // icon placeholder
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    cross-axis-self-alignment: center;
                                    Text { text: "NAME SHOWN TO FRIENDS"; font-size: 10px; font-weight: 600; color: muted; letter-spacing: 0.15px; }
                                    TextInput {
                                        text <=> root.display-name;
                                        font-size: 14px;
                                        color: ink;
                                    }
                                }
                            }
                        }

                        // Field: Username
                        Rectangle {
                            height: 58px;
                            border-radius: 19px;
                            background: field;
                            border-width: 1px;
                            border-color: rgba(255,255,255,0.62);
                            
                            HorizontalLayout {
                                padding-left: 15px; padding-right: 15px;
                                spacing: 13px;
                                alignment: start;
                                Rectangle { width: 24px; height: 24px; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    cross-axis-self-alignment: center;
                                    Text { text: "USERNAME"; font-size: 10px; font-weight: 600; color: muted; letter-spacing: 0.15px; }
                                    TextInput {
                                        text <=> root.username;
                                        font-size: 14px;
                                        color: ink;
                                    }
                                }
                            }
                        }

                        // Field: Password
                        Rectangle {
                            height: 58px;
                            border-radius: 19px;
                            background: field;
                            border-width: 1px;
                            border-color: rgba(255,255,255,0.62);
                            
                            HorizontalLayout {
                                padding-left: 15px; padding-right: 15px;
                                spacing: 13px;
                                alignment: start;
                                Rectangle { width: 24px; height: 24px; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    cross-axis-self-alignment: center;
                                    Text { text: "PASSWORD"; font-size: 10px; font-weight: 600; color: muted; letter-spacing: 0.15px; }
                                    TextInput {
                                        text <=> root.password;
                                        font-size: 14px;
                                        color: ink;
                                        input-type: root.show-password ? InputType.text : InputType.password;
                                    }
                                }
                                TouchArea {
                                    width: 34px; height: 34px;
                                    mouse-cursor: pointer;
                                    clicked => { root.show-password = !root.show-password; }
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: root.show-password ? "Hide" : "Show";
                                        font-size: 10px;
                                        color: muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Field: Confirm Password
                        Rectangle {
                            height: 58px;
                            border-radius: 19px;
                            background: field;
                            border-width: 1px;
                            border-color: rgba(255,255,255,0.62);
                            
                            HorizontalLayout {
                                padding-left: 15px; padding-right: 15px;
                                spacing: 13px;
                                alignment: start;
                                Rectangle { width: 24px; height: 24px; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    cross-axis-self-alignment: center;
                                    Text { text: "CONFIRM PASSWORD"; font-size: 10px; font-weight: 600; color: muted; letter-spacing: 0.15px; }
                                    TextInput {
                                        text <=> root.confirm-password;
                                        font-size: 14px;
                                        color: ink;
                                        input-type: InputType.password;
                                    }
                                }
                                TouchArea {
                                    width: 34px; height: 34px;
                                    mouse-cursor: pointer;
                                    clicked => { root.show-confirm = !root.show-confirm; }
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: root.show-confirm ? "Hide" : "Show";
                                        font-size: 10px;
                                        color: muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Strength meter
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            padding-top: 11px; padding-bottom: 9px;
                            spacing: 12px;
                            alignment: center;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 7px;
                                Text { text: "PASSWORD STRENGTH"; font-size: 10px; font-weight: 600; color: muted; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    for i in 4: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 4px;
                                        border-radius: 2px;
                                        background: i < root.score-now ? #55555b : #d8d8dc;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: end;
                                Text {
                                    text: root.score-now == 0 ? "Not entered" : (root.score-now <= 1 ? "Weak" : (root.score-now == 2 ? "Fair" : (root.score-now == 3 ? "Good" : "Strong")));
                                    font-size: 10px;
                                    font-weight: 650;
                                    color: #55555b;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: root.confirm-password == "" ? "Use at least 8 characters" : (root.password == root.confirm-password ? "Passwords match" : "Passwords do not match");
                                    font-size: 10px;
                                    color: #96969b;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }

                // Create Account button
                TouchArea {
                    height: 56px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit(root.username, root.display-name, root.password);
                    }
                    Rectangle {
                        width: parent.width;
                        height: 56px;
                        border-radius: 19px;
                        background: @linear-gradient(180deg, #303034 0%, #111113 100%);
                        border-width: 1px;
                        border-color: rgba(255,255,255,0.22);
                        drop-shadow-blur: 20px;
                        drop-shadow-color: rgba(0,0,0,0.16);
                        drop-shadow-offset-y: 9px;
                        opacity: 1.0;
                        // top highlight
                        Rectangle {
                            x: 1px; y: 1px;
                            width: parent.width - 2px; height: 45%;
                            border-radius: 18px;
                            background: @linear-gradient(180deg, rgba(255,255,255,0.18) 0%, transparent 100%);
                        }
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.busy ? "Creating…" : "Create Account";
                            font-size: 14px;
                            font-weight: 650;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Footer
        Text {
            text: "Already have an account?  Log in";
            font-size: 12px;
            color: muted;
            horizontal-alignment: center;
            
        }

        Text {
            text: "Your account will have its own recovery codes. Keep them somewhere safe.";
            font-size: 10px;
            color: #a0a0a5;
            horizontal-alignment: center;
            wrap: word-wrap;
            
        }
    }
}

// ---------------------------------------------------------------------------
// Recovery codes reveal (right after sign-up)
// Recovery codes screen — monochrome Liquid Glass (mobile-first).
export component RecoveryScreen inherits Rectangle {
    in property <[string]> codes;
    callback saved;   // -> terms
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> confirmed: false;

    property <color> ink: dark ? #f3f3f1 : #171717;
    property <color> ink-soft: dark ? #dadad7 : #3d3d3b;
    property <color> muted: dark ? #a1a19d : #777774;
    property <color> line: dark ? rgba(255,255,255,0.11) : rgba(25,25,25,0.09);
    property <color> glass: dark ? rgba(42,42,42,0.58) : rgba(255,255,255,0.57);
    property <color> glass-strong: dark ? rgba(52,52,52,0.76) : rgba(255,255,255,0.76);
    property <color> field: dark ? rgba(18,18,18,0.62) : rgba(247,247,248,0.74);

    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 18px;
        padding-bottom: 16px;
        spacing: 0px;

        // Ambient blobs
        Rectangle {
            height: 0px;
            Rectangle {
                x: -155px; y: parent.height * 0.18;
                width: 300px; height: 300px;
                border-radius: 150px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.16) 0%, rgba(180,180,180,0.08) 68%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.12) 68%, transparent 72%);
                opacity: 0.55;
            }
            Rectangle {
                x: parent.width - 220px; y: parent.height - 120px;
                width: 360px; height: 360px;
                border-radius: 180px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.10) 0%, rgba(180,180,185,0.06) 68%, transparent 72%)
                    : @radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(180,180,185,0.12) 68%, transparent 72%);
                opacity: 0.55;
            }
        }

        // Top bar
        HorizontalLayout {
            height: 34px;
            alignment: start;
            spacing: 0px;
            TouchArea {
                width: 38px; height: 38px;
                mouse-cursor: pointer;
                clicked => { }
                Rectangle {
                    width: 38px; height: 38px;
                    border-radius: 19px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 5px;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "←";
                        font-size: 18px;
                        color: ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "ACCOUNT SECURITY · 03 / 14";
                font-size: 10px;
                font-weight: 750;
                color: muted;
                letter-spacing: 1.6px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "nemo.";
                font-size: 17px;
                font-weight: 800;
                color: ink;
                letter-spacing: -0.45px;
                vertical-alignment: center;
            }
        }

        // Content
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 16px;

                // Icon
                Rectangle {
                    width: 68px; height: 68px;
                    x: (parent.width - 68px) / 2;
                    border-radius: 23px;
                    background: glass-strong;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.95);
                    drop-shadow-blur: 32px;
                    drop-shadow-color: rgba(0,0,0,0.09);
                    drop-shadow-offset-y: 12px;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "🔐";
                        font-size: 29px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Heading
                VerticalLayout {
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: "Save your recovery codes";
                        font-size: 27px;
                        font-weight: 780;
                        color: ink;
                        letter-spacing: -1.4px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "These codes are your backup way into Nemo if you ever lose access to your password.";
                        font-size: 13px;
                        color: muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Security notice
                Rectangle {
                    border-radius: 18px;
                    background: glass;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.84);
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        padding-top: 13px; padding-bottom: 13px;
                        spacing: 11px;
                        alignment: start;
                        Rectangle {
                            width: 17px; height: 17px;
                            // shield icon placeholder
                            Text { text: "🛡"; font-size: 14px; }
                        }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text {
                            text: "Keep these codes private";
                            font-size: 12px;
                            font-weight: 700;
                            color: ink;
                        }
                        Text {
                            text: "Each code can be used once. Anyone with one of your codes may be able to access your account.";
                            font-size: 11px;
                            color: muted;
                            wrap: word-wrap;
                        }
                    }
                }
                }

                // Codes card
                Rectangle {
                    border-radius: 23px;
                    background: glass-strong;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.94);
                    drop-shadow-blur: 32px;
                    drop-shadow-color: rgba(0,0,0,0.055);
                    drop-shadow-offset-y: 12px;
                    clip: true;

                    // top specular
                    Rectangle {
                        x: 14px; y: 1px;
                        width: parent.width - 28px; height: 1px;
                        background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,1) 50%, transparent 100%);
                    }

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 15px;
                        padding-bottom: 13px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Your recovery codes";
                                font-size: 12px;
                                font-weight: 750;
                                color: ink;
                            }
                            Rectangle {
                                width: 80px; height: 20px;
                                border-radius: 10px;
                                background: rgba(20,20,24,0.06);
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "Preview only";
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: muted;
                                    letter-spacing: 1.2px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Code list (single column, one per row)
                        VerticalLayout {
                            spacing: 6px;
                            for code in root.codes: Rectangle {
                                height: 42px;
                                border-radius: 12px;
                                background: field;
                                border-width: 1px;
                                border-color: rgba(255,255,255,0.92);
                                HorizontalLayout {
                                    padding-left: 11px; padding-right: 9px;
                                    spacing: 8px;
                                    alignment: center;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: code;
                                        font-size: 11px;
                                        font-weight: 650;
                                        color: ink;
                                        letter-spacing: 0.35px;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        width: 27px; height: 30px;
                                        mouse-cursor: pointer;
                                        Rectangle {
                                            width: 27px; height: 30px;
                                            border-radius: 8px;
                                        }
                                    }
                                }
                            }
                        }

                        // Actions
                        HorizontalLayout {
                            spacing: 9px;
                            TouchArea {
                                horizontal-stretch: 1;
                                height: 42px;
                                mouse-cursor: pointer;
                                clicked => { }
                                Rectangle {
                                    width: parent.width;
                                    height: 42px;
                                    border-radius: 13px;
                                    background: glass;
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.94);
                                    drop-shadow-blur: 14px;
                                    drop-shadow-color: rgba(0,0,0,0.035);
                                    drop-shadow-offset-y: 5px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 7px;
                                        Text { text: "Copy all"; font-size: 11px; font-weight: 720; color: ink-soft; vertical-alignment: center; }
                                    }
                                }
                            }
                            TouchArea {
                                horizontal-stretch: 1;
                                height: 42px;
                                mouse-cursor: pointer;
                                clicked => { }
                                Rectangle {
                                    width: parent.width;
                                    height: 42px;
                                    border-radius: 13px;
                                    background: glass;
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.94);
                                    drop-shadow-blur: 14px;
                                    drop-shadow-color: rgba(0,0,0,0.035);
                                    drop-shadow-offset-y: 5px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 7px;
                                        Text { text: "Save as file"; font-size: 11px; font-weight: 720; color: ink-soft; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Store them somewhere private. Don't share them or keep them in a public place.";
                            font-size: 10px;
                            color: muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Confirm checkbox
                TouchArea {
                    height: 50px;
                    mouse-cursor: pointer;
                    clicked => { root.confirmed = !root.confirmed; }
                    Rectangle {
                        width: parent.width;
                        height: 50px;
                        border-radius: 15px;
                        background: glass;
                        border-width: 1px;
                        border-color: rgba(255,255,255,0.82);
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 19px; height: 19px;
                                border-radius: 6px;
                                background: root.confirmed ? ink : glass-strong;
                                border-width: 1px;
                                border-color: root.confirmed ? ink : #9b9ba0;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: root.confirmed ? "✓" : "";
                                    font-size: 11px;
                                    color: dark ? #171717 : #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "I've saved my recovery codes somewhere safe.";
                                font-size: 11px;
                                font-weight: 600;
                                color: #55555b;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Continue button
                TouchArea {
                    height: 52px;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.confirmed) { root.saved(); }
                    }
                    Rectangle {
                        width: parent.width;
                        height: 52px;
                        border-radius: 16px;
                        background: root.confirmed
                            ? @linear-gradient(180deg, #303034 0%, #111113 100%)
                            : rgba(25,25,27,0.34);
                        border-width: 1px;
                        border-color: rgba(255,255,255,0.2);
                        drop-shadow-blur: root.confirmed ? 23px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.17);
                        drop-shadow-offset-y: 10px;
                        opacity: root.confirmed ? 1.0 : 0.34;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Continue";
                            font-size: 13px;
                            font-weight: 750;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Footer
        Text {
            text: "NEMO · YOUR ACCOUNT, YOUR CONTROL";
            font-size: 9px;
            color: muted;
            letter-spacing: 0.35px;
            horizontal-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Login
// ---------------------------------------------------------------------------

export component LoginScreen inherits Rectangle {
    callback back;
    callback submit(string, string); // username, password
    callback forgot;                 // -> recovery entry
    background: transparent;

    in-out property <string> username: "";
    in-out property <string> password: "";
    in property <string> error: "";
    in property <bool> busy: false;

    VerticalLayout {
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: 8px;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            NookLogo {
                compact: true;
                size: 64px;
                x: (parent.width - self.width) / 2;
            }
        }
        Text {
            text: "Welcome back";
            font-size: Theme.fs-large;
            font-weight: 800;
            color: Theme.c-text;
            horizontal-alignment: center;
        }
        Text {
            text: "Log in to your nook.";
            font-size: Theme.fs-body;
            color: Theme.c-text-2;
            horizontal-alignment: center;
        }

        Rectangle { height: Theme.sp-2; }

        NookField {
            label: "Username";
            placeholder: "your handle";
            text <=> root.username;
            error: root.error;
        }
        NookField {
            label: "Password";
            placeholder: "••••••••••";
            password: true;
            text <=> root.password;
        }

        Rectangle { vertical-stretch: 1; }

        PrimaryButton {
            text: root.busy ? "Logging in…" : "Log in";
            enabled: !root.busy;
            clicked => { root.submit(root.username, root.password); }
        }
        TextButton {
            text: "Use a recovery code instead";
            clicked => { root.forgot(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Terms
// ---------------------------------------------------------------------------

export struct PolicySection {
    heading: string,
    body: string,
}

export component TermsScreen inherits Rectangle {
    in property <string> doc-title;
    in property <[PolicySection]> sections;
    in property <bool> gate: true;              // require checkbox
    callback agreed(bool);
    callback continue-p;
    callback back;
    background: transparent;

    in-out property <bool> accepted: false;

    VerticalLayout {
        padding-left: Theme.sp-5;
        padding-right: Theme.sp-5;
        padding-top: 8px;
        padding-bottom: Theme.sp-5;
        spacing: Theme.sp-3;

        HorizontalLayout {
            height: Theme.bar-h;
            alignment: start;
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Back {
                        x: (parent.width - 22px) / 2;
                        y: (parent.height - 22px) / 2;
                        size: 22px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Text {
            text: root.doc-title;
            font-size: Theme.fs-title;
            font-weight: 800;
            color: Theme.c-text;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.r-card;
            background: Theme.c-surface-alpha;
            border-width: 1px;
            border-color: Theme.c-stroke-glass;
            clip: true;
            Flickable {
                VerticalLayout {
                    padding-top: Theme.sp-4;
                    padding-bottom: Theme.sp-4;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: Theme.sp-3;
                    for s in root.sections: VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: s.heading;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            color: Theme.c-text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: s.body;
                            font-size: Theme.fs-small;
                            color: Theme.c-text-2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Agreement checkbox
        if root.gate: HorizontalLayout {
            spacing: Theme.sp-3;
            alignment: start;
            TouchArea {
                width: 30px;
                mouse-cursor: pointer;
                clicked => { root.accepted = !root.accepted; root.agreed(root.accepted); }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 2px;
                    border-radius: 8px;
                    background: root.accepted ? Theme.accent : transparent;
                    border-width: 1.6px;
                    border-color: root.accepted ? Theme.accent : Theme.c-text-3;
                    Check {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        size: 18px;
                        tint: white;
                    }
                }
            }
            Text {
                text: "I have read and agree to these terms.";
                font-size: Theme.fs-small;
                color: Theme.c-text-2;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        PrimaryButton {
            text: "Continue";
            enabled: !root.gate || root.accepted;
            clicked => { root.continue-p(); }
        }
    }
}
