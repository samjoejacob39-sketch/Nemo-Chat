// Chats list and the chat view (bubbles, composer, date separators).
//
// Verified against Slint 1.18.1 compiler sources:
// - `"" + int + "text"` string concat is valid (int coerces to string).
// - Flickable canonical props: content-x/y/width/height, visible-width/height.
// - Conditional `if` elements are absent from the item tree when false, so
//   they never take layout space. (`visible: false` lowers to a Clip wrapper
//   whose layout info has stretch 1 - it would absorb extra layout space,
//   so it must not be used for conditional rows inside layouts.)
// - Layout children accept `cross-axis-self-alignment` (CrossAxisAlignment);
//   layouts accept `cross-axis-alignment` for the container default.
// - Text measuring: an element's `preferred-width`/`preferred-height` are
//   readable; wrapped Text reports its preferred height for the assigned
//   width, which is how bubble cards auto-size here.

import { Theme } from "../theme.slint";
import {
    ChevronLeft, ChevronRight, Bell, BellFilled, Compose, Send, Smile,
    DotsVertical, CheckDouble, Pin, MutedIcon, Plus, NookLogo,
    Sun, Moon, Search, Reply, InfoIcon, Paperclip, Picture,
} from "../icons.slint";
import {
    ScreenBackground, GlassCard, Hairline, PrimaryButton,
    SearchField, Avatar, CountBadge, EmptyState, TypingBubble, NavBar,
    NemoBackButton,
} from "../widgets.slint";

// ---------------------------------------------------------------------------
// Shared row models (instantiated by Rust)
// ---------------------------------------------------------------------------

export struct UiChat {
    index: int,
    title: string,
    subtitle: string,
    time: string,
    unread: int,
    initials: string,
    variant: int,
    has-avatar: bool,
    avatar: image,
    online: bool,
    muted: bool,
    pinned: bool,
}

export struct UiBubble {
    index: int,
    kind: int,          // 0 text, 1 image-only, 2 system notice
    text: string,
    mine: bool,
    read: bool,
    time: string,
    day: string,
    is-day-sep: bool,
    sender: string,
    has-image: bool,
    image: image,
}

// ---------------------------------------------------------------------------
// Chat list row
// ---------------------------------------------------------------------------

export component ChatRow inherits Rectangle {
    in property <UiChat> chat;
    callback open-chat;
    height: 76px;
    background: transparent;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-chat(); }
        GlassCard {
            radius: Theme.r-row;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 14px;
                spacing: Theme.sp-3;
                Avatar {
                    size: 48px;
                    initials: chat.initials;
                    variant: chat.variant;
                    has-image: chat.has-avatar;
                    image: chat.avatar;
                    online: chat.online;
                }
                VerticalLayout {
                    height: 44px;
                    cross-axis-self-alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: chat.title;
                            font-size: Theme.fs-body-lg;
                            font-weight: chat.unread > 0 ? 800 : 600;
                            color: Theme.c-text;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if chat.muted: MutedIcon {
                            size: 15px;
                            tint: Theme.c-text-3;
                        }
                        if chat.pinned: Pin {
                            size: 15px;
                            tint: Theme.c-text-3;
                        }
                    }
                    Text {
                        text: chat.subtitle;
                        font-size: Theme.fs-small;
                        color: chat.unread > 0 ? Theme.c-text : Theme.c-text-2;
                        font-weight: chat.unread > 0 ? 600 : 400;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    width: 74px;
                    cross-axis-self-alignment: center;
                    spacing: 4px;
                    Text {
                        text: chat.time;
                        font-size: Theme.fs-caption;
                        color: Theme.c-text-3;
                        horizontal-alignment: right;
                    }
                    HorizontalLayout {
                        if chat.unread > 0: CountBadge {
                            count: chat.unread;
                            bg: chat.muted ? Theme.c-text-3 : Theme.accent;
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Chats list screen
// Chats list screen — monochrome Liquid Glass (mobile-first).
export component ChatsScreen inherits Rectangle {
    in property <[UiChat]> chats;
    in property <int> request-count: 0;
    in property <int> unseen-activity: 0;
    callback open-chat(int);
    callback new-chat;
    callback open-notifications;
    callback open-profile;
    callback open-find;
    callback search-changed(string);
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <string> search: "";
    in-out property <int> filter: 0; // 0 all, 1 unread, 2 groups
    in-out property <bool> options-open: false;
    in-out property <bool> preview-open: false;
    in-out property <bool> compose-open: false;
    in-out property <string> selected-name: "";
    in-out property <string> selected-preview: "";

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> muted-2: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> surface-soft: Theme.n-surface-soft;
    property <color> nav-bg: Theme.n-nav-bg;
    property <color> bubble: Theme.c-bubble-in;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Status bar spacer
        Rectangle { height: 42px; }

        // Top bar
        HorizontalLayout {
            padding-left: 22px; padding-right: 22px;
            padding-top: 13px; padding-bottom: 12px;
            spacing: 12px;
            alignment: start;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                Text {
                    text: "Your conversations";
                    font-size: 12px;
                    font-weight: 750;
                    color: muted;
                    letter-spacing: 1.6px;
                }
                Text {
                    text: "Chats";
                    font-size: 31px;
                    font-weight: 760;
                    color: ink;
                    letter-spacing: -1.15px;
                }
            }
            // theme toggle
            TouchArea {
                width: 42px; height: 42px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                    drop-shadow-blur: 15px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 5px;
                    if root.dark: Sun {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 19px;
                        tint: ink;
                    }
                    if !root.dark: Moon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 19px;
                        tint: ink;
                    }
                }
            }
            // notifications
            TouchArea {
                width: 42px; height: 42px;
                mouse-cursor: pointer;
                clicked => { root.open-notifications(); }
                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                    drop-shadow-blur: 15px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 5px;
                    Bell {
                        x: 11px;
                        y: 11px;
                        size: 20px;
                        tint: ink;
                    }
                }
            }
            // compose
            TouchArea {
                width: 42px; height: 42px;
                mouse-cursor: pointer;
                clicked => { root.compose-open = true; }
                Rectangle {
                    width: 42px; height: 42px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                    drop-shadow-blur: 15px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 5px;
                    Compose {
                        x: 11px;
                        y: 11px;
                        size: 20px;
                        tint: ink;
                    }
                }
            }
        }

        // Search
        HorizontalLayout {
            padding-left: 20px; padding-right: 20px;
            padding-bottom: 12px;
            Rectangle {
                horizontal-stretch: 1;
                height: 45px;
                border-radius: 17px;
                background: glass;
                border-width: 1px;
                border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                drop-shadow-blur: 12px;
                drop-shadow-color: rgba(0,0,0,0.025);
                drop-shadow-offset-y: 5px;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px;
                    spacing: 10px;
                    alignment: center;
                    Search {
                        size: 16px;
                        tint: muted;
                    }
                    TextInput {
                        text <=> root.search;
                        font-size: 13px;
                        color: ink;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Filters
        HorizontalLayout {
            padding-left: 21px; padding-right: 21px;
            padding-bottom: 14px;
            spacing: 8px;
            TouchArea {
                height: 34px;
                mouse-cursor: pointer;
                clicked => { root.filter = 0; }
                Rectangle {
                    width: 60px; height: 34px;
                    border-radius: 17px;
                    background: root.filter == 0 ? ink : glass;
                    border-width: 1px;
                    border-color: root.filter == 0 ? ink : rgba(25,25,30,0.075);
                    Text {
                        width: parent.width; height: parent.height;
                        text: "All";
                        font-size: 12px;
                        font-weight: 650;
                        color: root.filter == 0 ? (dark ? #171719 : #ffffff) : muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            TouchArea {
                height: 34px;
                mouse-cursor: pointer;
                clicked => { root.filter = 1; }
                Rectangle {
                    width: 90px; height: 34px;
                    border-radius: 17px;
                    background: root.filter == 1 ? ink : glass;
                    border-width: 1px;
                    border-color: root.filter == 1 ? ink : rgba(25,25,30,0.075);
                    Text {
                        width: parent.width; height: parent.height;
                        text: "Unread 3";
                        font-size: 12px;
                        font-weight: 650;
                        color: root.filter == 1 ? (dark ? #171719 : #ffffff) : muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            TouchArea {
                height: 34px;
                mouse-cursor: pointer;
                clicked => { root.filter = 2; }
                Rectangle {
                    width: 80px; height: 34px;
                    border-radius: 17px;
                    background: root.filter == 2 ? ink : glass;
                    border-width: 1px;
                    border-color: root.filter == 2 ? ink : rgba(25,25,30,0.075);
                    Text {
                        width: parent.width; height: parent.height;
                        text: "Groups";
                        font-size: 12px;
                        font-weight: 650;
                        color: root.filter == 2 ? (dark ? #171719 : #ffffff) : muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Conversation list
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 19px;
                padding-right: 19px;
                padding-bottom: 100px;
                spacing: 0px;
                // list heading
                HorizontalLayout {
                    height: 30px;
                    Text {
                        text: "Recent messages";
                        font-size: 12px;
                        font-weight: 700;
                        color: muted;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "Recent ▾";
                        font-size: 12px;
                        font-weight: 650;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                for chat in root.chats: TouchArea {
                    height: 77px;
                    mouse-cursor: pointer;
                    clicked => { root.open-chat(chat.index); }
                    Rectangle {
                        width: parent.width;
                        height: 77px;
                        // bottom border
                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: line;
                        }
                        HorizontalLayout {
                            padding-top: 12px; padding-bottom: 12px;
                            spacing: 12px;
                            alignment: start;
                            // avatar
                            Rectangle {
                                width: 49px; height: 49px;
                                border-radius: 24.5px;
                                background: dark
                                    ? @radial-gradient(circle, #44444a 0%, #5b5b63 44%, #777780 100%)
                                    : @radial-gradient(circle, #ffffff 0%, #e7e7e9 34%, #bdbdc3 100%);
                                border-width: 1px;
                                border-color: dark ? rgba(255,255,255,0.12) : rgba(255,255,255,0.92);
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: chat.initials;
                                    font-size: 13px;
                                    font-weight: 750;
                                    color: dark ? #f4f4f5 : #252529;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            // copy
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                cross-axis-self-alignment: center;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: chat.title;
                                        font-size: 13px;
                                        font-weight: 730;
                                        color: ink;
                                        letter-spacing: -0.18px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: chat.time;
                                        font-size: 12px;
                                        color: muted;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 9px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: chat.subtitle;
                                        font-size: 12px;
                                        color: muted;
                                        overflow: elide;
                                    }
                                    if chat.unread > 0: Rectangle {
                                        width: 17px; height: 17px;
                                        border-radius: 8.5px;
                                        background: ink;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "" + chat.unread;
                                            font-size: 12px;
                                            font-weight: 750;
                                            color: dark ? #171719 : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if chat.unread == 0: Text {
                                        text: "✓✓";
                                        font-size: 12px;
                                        color: muted;
                                    }
                                }
                            }
                        }
                    }
                }
                if root.chats.length == 0: EmptyState {
                    state: "empty";
                    title: "No conversations yet";
                    subtitle: "Start a chat and it will appear here.";
                }
            }
        }

        // Bottom navigation — shared floating glass tab bar.
        NavBar {
            selected: 0;
            unread: 0;
            requests: root.request-count;
            select(i) => {
                if (i == 1) { root.open-find(); }
                if (i == 2) { root.open-profile(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// One message row — monochrome Liquid Glass
// ---------------------------------------------------------------------------

component ChatBubbleRow inherits VerticalLayout {
    in property <UiBubble> bubble;
    in property <bool> group: false;
    in property <length> available-width: 340px;
    callback open-image;

    // Day divider
    if bubble.is-day-sep: HorizontalLayout {
        height: 24px;
        alignment: center;
        Rectangle { horizontal-stretch: 1; height: 1px; background: rgba(0,0,0,0.09); }
        Text {
            text: bubble.day;
            font-size: 12px;
            font-weight: 650;
            color: #858585;
            letter-spacing: 0.9px;
        }
        Rectangle { horizontal-stretch: 1; height: 1px; background: rgba(0,0,0,0.09); }
    }

    // System notice
    if bubble.kind == 2 && !bubble.is-day-sep: Text {
        height: 24px;
        text: bubble.text;
        font-size: 12px;
        color: #858585;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Bubble
    if bubble.kind != 2 && !bubble.is-day-sep: HorizontalLayout {
        spacing: 7px;
        Rectangle {
            width: 0px;
            horizontal-stretch: bubble.mine ? 1 : 0;
        }
        // mini avatar for incoming
        if !bubble.mine: Rectangle {
            width: 25px; height: 25px;
            border-radius: 9px;
            background: @linear-gradient(145deg, #d9d9d8 0%, #a7a7a5 100%);
            border-width: 1px;
            border-color: rgba(255,255,255,0.75);
            Text {
                width: parent.width; height: parent.height;
                text: bubble.sender != "" ? bubble.sender : "";
                font-size: 8px;
                font-weight: 750;
                color: #222;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            width: bubble.has-image ? 220px
                : Math.min(root.available-width - 60px,
                    Math.max(60px, bubble.text.character-count * 8.5px));
            height: inner.preferred-height;
            border-radius: 18px;
            background: bubble.mine
                ? #202020
                : rgba(255,255,255,0.88);
            border-width: bubble.mine ? 0px : 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: bubble.mine ? 20px : 16px;
            drop-shadow-color: bubble.mine ? rgba(0,0,0,0.11) : rgba(0,0,0,0.035);
            drop-shadow-offset-y: bubble.mine ? 8px : 5px;

            inner := VerticalLayout {
                padding-top: 11px;
                padding-bottom: 11px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 5px;

                if bubble.has-image: Rectangle {
                    height: 124px;
                    border-radius: 15px;
                    background: @linear-gradient(145deg, #d5d5d3 0%, #969694 58%, #c8c8c6 100%);
                    clip: true;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-image(); }
                    }
                }
                if bubble.text != "": Text {
                    text: bubble.text;
                    font-size: 13px;
                    color: bubble.mine ? #ffffff : #171717;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: bubble.mine ? end : start;
                    spacing: 6px;
                    Text {
                        text: bubble.time;
                        font-size: 12px;
                        color: bubble.mine ? rgba(255,255,255,0.7) : #858585;
                    }
                    if bubble.mine: Text {
                        text: bubble.read ? "✓✓" : "✓";
                        font-size: 12px;
                        color: bubble.read ? #c0c0c0 : rgba(255,255,255,0.5);
                    }
                }
            }
        }
        Rectangle {
            width: 0px;
            horizontal-stretch: bubble.mine ? 0 : 1;
        }
    }
}

// ---------------------------------------------------------------------------
// Chat view screen — monochrome Liquid Glass
// ---------------------------------------------------------------------------

export component ChatScreen inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> other-online: false;
    in property <string> peer-initials: "";
    in property <int> peer-variant: 0;
    in property <bool> peer-has-avatar: false;
    in property <image> peer-avatar;
    in property <bool> is-group: false;
    in property <[UiBubble]> messages;
    in property <string> typing-name: "";
    in property <bool> blocked: false;
    in property <bool> can-send: true;
    in property <int> chat-index: 0;

    callback back;
    callback send(string);
    callback open-info;
    callback open-image(int);
    callback pick-image;
    callback load-more;
    background: transparent;

    in-out property <string> draft: "";
    in-out property <bool> emoji-open: false;
    in-out property <bool> loading-older: false;
    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> sheet-open: false;
    private property <bool> stick: true;
    private property <bool> has-draft: !root.draft.replace-all(" ", "").is-empty;

    function send-draft() {
        if (!root.draft.replace-all(" ", "").is-empty) {
            root.send(root.draft);
            root.draft = "";
        }
    }

    property <color> ink: Theme.n-ink;
    property <color> ink-2: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> surface: Theme.n-glass;
    property <color> surface-strong: Theme.n-glass-strong;
    property <color> surface-muted: Theme.n-surface-soft;
    property <color> field: Theme.n-glass-soft;
    property <color> outgoing: Theme.n-primary;
    property <color> outgoing-text: Theme.n-primary-text;
    property <color> incoming: Theme.n-glass-strong;
    property <color> line: Theme.n-line;
    property <color> scrim: Theme.n-scrim;

    VerticalLayout {
        // Top bar
        HorizontalLayout {
            height: 56px;
            padding-left: 17px; padding-right: 17px;
            spacing: 11px;
            alignment: start;

            NemoBackButton {
                clicked => { root.back(); }
            }
            Rectangle {
                width: 43px; height: 43px;
                border-radius: 15px;
                background: @linear-gradient(145deg, #dededc 0%, #a9a9a7 100%);
                border-width: 1px;
                border-color: rgba(255,255,255,0.8);
                Text {
                    width: parent.width; height: parent.height;
                    text: root.peer-initials;
                    font-size: 13px;
                    font-weight: 750;
                    color: #222;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                cross-axis-self-alignment: center;
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 680;
                    color: ink;
                    letter-spacing: -0.25px;
                    overflow: elide;
                }
                Text {
                    text: root.typing-name != "" ? "typing…" : root.subtitle;
                    font-size: 12px;
                    color: root.typing-name != "" ? ink : muted;
                    overflow: elide;
                }
            }
            TouchArea {
                width: 38px; height: 38px;
                mouse-cursor: pointer;
                clicked => { root.open-info(); }
                Rectangle {
                    width: 38px; height: 38px;
                    border-radius: 14px;
                    background: surface;
                    border-width: 1px;
                    border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⋯";
                        font-size: 18px;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: line; }

        // Messages
        if root.blocked: Rectangle {
            vertical-stretch: 1;
            Text {
                width: parent.width; height: parent.height;
                text: "You can't message this account";
                font-size: 13px;
                color: muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if !root.blocked: Flickable {
            vertical-stretch: 1;

            changed content-height => {
                if (root.stick
                    || self.content-y >= -(self.content-height - self.height) - 60px) {
                    self.content-y = -Math.max(0px, self.content-height - self.height);
                }
            }
            changed content-y => {
                root.stick = self.content-y >= -(self.content-height - self.height) - 60px;
                if (self.content-y >= -40px && !root.loading-older && root.messages.length > 0) {
                    root.loading-older = true;
                    root.load-more();
                }
            }

            VerticalLayout {
                padding-left: 17px;
                padding-right: 17px;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 13px;
                Text {
                    text: "Today · 9:32 AM";
                    font-size: 12px;
                    font-weight: 650;
                    color: muted;
                    letter-spacing: 0.9px;
                    horizontal-alignment: center;
                }
                for msg in root.messages: ChatBubbleRow {
                    bubble: msg;
                    group: root.is-group;
                    available-width: root.width - 34px;
                    open-image => { root.open-image(msg.index); }
                }
            }
        }

        // Composer
        if !root.blocked && root.can-send: VerticalLayout {
            padding-left: 13px; padding-right: 13px;
            padding-top: 10px; padding-bottom: 12px;
            spacing: 7px;
            Rectangle {
                height: 1px;
                background: line;
            }
            HorizontalLayout {
                spacing: 7px;
                alignment: start;
                // attach
                TouchArea {
                    width: 37px; height: 37px;
                    mouse-cursor: pointer;
                    clicked => { root.pick-image(); }
                    Rectangle {
                        width: 37px; height: 37px;
                        border-radius: 13px;
                        background: surface-muted;
                        Paperclip {
                            x: 9px;
                            y: 9px;
                            size: 19px;
                            tint: ink;
                        }
                    }
                }
                // input
                Rectangle {
                    horizontal-stretch: 1;
                    min-height: 37px;
                    border-radius: 23px;
                    background: surface-strong;
                    border-width: 1px;
                    border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.035);
                    drop-shadow-offset-y: 4px;
                    VerticalLayout {
                        padding-top: 10px; padding-bottom: 7px;
                        padding-left: 14px; padding-right: 14px;
                        TextInput {
                            text <=> root.draft;
                            font-size: 13px;
                            color: ink;
                            accepted() => { root.send-draft(); }
                        }
                    }
                }
                // emoji
                TouchArea {
                    width: 37px; height: 37px;
                    mouse-cursor: pointer;
                    clicked => { root.emoji-open = !root.emoji-open; }
                    Rectangle {
                        width: 37px; height: 37px;
                        border-radius: 13px;
                        background: surface-muted;
                        Smile {
                            x: 9px;
                            y: 9px;
                            size: 19px;
                            tint: ink;
                        }
                    }
                }
                // send
                TouchArea {
                    width: 38px; height: 38px;
                    mouse-cursor: pointer;
                    clicked => { root.send-draft(); }
                    Rectangle {
                        width: 38px; height: 38px;
                        border-radius: 14px;
                        background: root.has-draft ? outgoing : surface-muted;
                        opacity: root.has-draft ? 1.0 : 0.36;
                        drop-shadow-blur: root.has-draft ? 13px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.13);
                        drop-shadow-offset-y: 5px;
                        Send {
                            x: 10px;
                            y: 10px;
                            size: 18px;
                            tint: root.has-draft ? outgoing-text : muted;
                        }
                    }
                }
            }
            Text {
                text: "Messages are shown here as a local UI preview.";
                font-size: 12px;
                color: muted;
                horizontal-alignment: center;
            }
        }

        // Action sheet backdrop + sheet
        if root.sheet-open: Rectangle {
            // backdrop
        }
    }

    // Action sheet (overlay)
    if root.sheet-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea {
            clicked => { root.sheet-open = false; }
        }
        Rectangle {
            x: 10px;
            y: parent.height - 260px;
            width: parent.width - 20px;
            height: 250px;
            border-radius: 25px;
            background: surface-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding-left: 17px; padding-right: 17px;
                padding-top: 17px; padding-bottom: 17px;
                spacing: 0px;
                Rectangle {
                    height: 4px;
                    width: 35px;
                    x: (parent.width - 35px) / 2;
                    border-radius: 2px;
                    background: muted;
                    opacity: 0.38;
                }
                Text {
                    text: "Conversation options";
                    font-size: 14px;
                    font-weight: 700;
                    color: ink;
                }
                // options
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 12px;
                            padding-left: 8px;
                            Search { size: 15px; tint: muted; }
                            Text { text: "Search in conversation"; font-size: 13px; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 12px;
                            padding-left: 8px;
                            Reply { size: 15px; tint: muted; }
                            Text { text: "Reply to latest message"; font-size: 13px; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 12px;
                            padding-left: 8px;
                            InfoIcon { size: 15px; tint: muted; }
                            Text { text: "Conversation details"; font-size: 13px; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 45px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width;
                        height: 45px;
                        border-radius: 13px;
                        background: surface-muted;
                        
                        Text {
                            width: parent.width; height: parent.height;
                            text: "Cancel";
                            font-size: 12px;
                            font-weight: 650;
                            color: ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
