// Group creation and group info screens.

import { Theme } from "../theme.slint";
import {
    Users, Check, Sun, Moon, Search, EditPencil, Bell, MutedIcon, Shield,
    Picture, LinkIcon, Plus,
} from "../icons.slint";
import {
    GlassCard, Hairline, SearchField, Avatar, PrimaryButton, GhostButton,
    PillTag, SectionLabel, TopBar, NookField, NemoBackButton,
} from "../widgets.slint";
import { Chip, LinkRow, ToggleRow } from "social.slint";

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

export struct UiFriendPick {
    id: int,
    name: string,
    handle: string,
    initials: string,
    variant: int,
    selected: bool,
}

export struct UiMember {
    id: int,
    name: string,
    handle: string,
    initials: string,
    variant: int,
    admin: bool,
}

// ---------------------------------------------------------------------------
// Rows
// ---------------------------------------------------------------------------

component FriendPickRow inherits Rectangle {
    in property <UiFriendPick> friend;
    callback toggle;

    height: 66px;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
        GlassCard {
            radius: Theme.r-row;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: Theme.sp-3;
                Avatar {
                    size: 42px;
                    cross-axis-self-alignment: center;
                    initials: friend.initials;
                    variant: friend.variant;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    height: 40px;
                    cross-axis-self-alignment: center;
                    spacing: 2px;
                    Text {
                        text: friend.name;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        color: Theme.c-text;
                        overflow: elide;
                    }
                    Text {
                        text: "@" + friend.handle;
                        font-size: Theme.fs-caption;
                        color: Theme.c-text-2;
                        overflow: elide;
                    }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    cross-axis-self-alignment: center;
                    border-radius: 12px;
                    background: friend.selected ? Theme.accent : Theme.c-surface-alpha;
                    border-width: friend.selected ? 0px : 1.5px;
                    border-color: Theme.c-text-3;
                    if friend.selected: Check {
                        x: 5px;
                        y: 5px;
                        size: 14px;
                        tint: white;
                    }
                }
            }
        }
    }
}

component MemberRow inherits Rectangle {
    in property <UiMember> member;
    in property <bool> viewer-admin: false;
    callback remove;

    height: 60px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Avatar {
            size: 36px;
            cross-axis-self-alignment: center;
            initials: member.initials;
            variant: member.variant;
        }
        Text {
            horizontal-stretch: 1;
            text: member.name;
            font-size: Theme.fs-body;
            font-weight: 600;
            color: Theme.c-text;
            vertical-alignment: center;
            overflow: elide;
        }
        if member.admin: PillTag {
            text: "Admin";
            cross-axis-self-alignment: center;
        }
        if root.viewer-admin && !member.admin: Chip {
            text: "Remove";
            bg: Theme.c-surface-alpha;
            fg: Theme.c-text-2;
            cross-axis-self-alignment: center;
            clicked => { root.remove(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Create group
// Create Group screen — monochrome Liquid Glass (mobile-first).
export component CreateGroupScreen inherits Rectangle {
    in property <[UiFriendPick]> friends;
    in property <int> selected-count: 0;
    in-out property <string> name: "";
    in-out property <string> query: "";
    callback back;
    callback search-changed(string);
    callback toggle-member(int);
    callback create;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> modal-open: false;

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> soft: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> field: Theme.n-glass-soft;
    property <color> selected-bg: Theme.n-glass-soft;
    property <color> primary: Theme.n-primary;
    property <color> primary-text: Theme.n-primary-text;
    property <color> scrim: Theme.n-scrim;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 0px;
        spacing: 0px;

        // Ambient
        Rectangle {
            height: 0px;
            Rectangle {
                x: parent.width - 160px; y: 190px;
                width: 280px; height: 280px;
                border-radius: 140px;
                background: dark
                    ? @radial-gradient(circle, rgba(255,255,255,0.75) 0%, transparent 70%)
                    : @radial-gradient(circle, rgba(255,255,255,0.95) 0%, rgba(120,120,120,0.04) 70%, transparent 100%);
                opacity: dark ? 0.12 : 0.22;
            }
        }

        // Top bar
        HorizontalLayout {
            height: 48px;
            spacing: 0px;
            alignment: start;
            NemoBackButton {
                clicked => { root.back(); }
            }
            Text {
                text: "Nemo";
                font-size: 13px;
                font-weight: 730;
                color: ink;
                letter-spacing: -0.2px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 90px; height: 42px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 90px; height: 42px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if root.dark: Sun { size: 15px; tint: ink; }
                        if !root.dark: Moon { size: 15px; tint: ink; }
                        Text { text: root.dark ? "Light" : "Dark"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                    }
                }
            }
        }

        // Intro
        VerticalLayout {
            spacing: 4px;
            padding-bottom: 22px;
            Text {
                text: "MAKE IT A GROUP";
                font-size: 12px;
                font-weight: 750;
                color: muted;
                letter-spacing: 1.8px;
            }
            Text {
                text: "Create a group.";
                font-size: 31px;
                font-weight: 760;
                color: ink;
                letter-spacing: -1.7px;
            }
            Text {
                text: "Bring your people together in one conversation.";
                font-size: 14px;
                color: muted;
                wrap: word-wrap;
            }
        }

        // Group card
        Rectangle {
            border-radius: 27px;
            background: glass;
            border-width: 1px;
            border-color: line;
            drop-shadow-blur: 24px;
            drop-shadow-color: rgba(0,0,0,0.09);
            drop-shadow-offset-y: 12px;
            clip: true;
            // top specular
            Rectangle {
                x: 12px; y: 0px; width: 300px; height: 1px;
                background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.95) 50%, transparent 100%);
            }

            VerticalLayout {
                padding-left: 17px;
                padding-right: 17px;
                padding-top: 17px;
                padding-bottom: 17px;
                spacing: 17px;

                // Group photo + meta
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Rectangle {
                        width: 66px; height: 66px;
                        border-radius: 22px;
                        background: glass-strong;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: rgba(0,0,0,0.04);
                        drop-shadow-offset-y: 3px;
                        Text {
                            width: parent.width; height: parent.height;
                            text: "＋";
                            font-size: 25px;
                            font-weight: 300;
                            color: muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        cross-axis-self-alignment: center;
                        Text {
                            text: "Group photo";
                            font-size: 14px;
                            font-weight: 700;
                            color: ink;
                        }
                        Text {
                            text: "Optional · Add an image for your group";
                            font-size: 12px;
                            color: muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // Fields
                VerticalLayout {
                    spacing: 11px;
                    // Group name
                    Rectangle {
                        height: 53px;
                        border-radius: 16px;
                        background: field;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: rgba(0,0,0,0.02);
                        drop-shadow-offset-y: 2px;
                        HorizontalLayout {
                            padding-left: 15px; padding-right: 15px;
                            spacing: 11px;
                            alignment: center;
                            EditPencil { size: 15px; tint: muted; }
                            TextInput {
                                horizontal-stretch: 1;
                                text <=> root.name;
                                font-size: 14px;
                                color: ink;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // Description
                    Rectangle {
                        height: 65px;
                        border-radius: 16px;
                        background: field;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: rgba(0,0,0,0.02);
                        drop-shadow-offset-y: 2px;
                        VerticalLayout {
                            padding-left: 15px; padding-right: 15px;
                            padding-top: 3px; padding-bottom: 3px;
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 11px;
                                alignment: start;
                                EditPencil { size: 15px; tint: muted; }
                                TextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.query; // reuse query as description placeholder
                                    font-size: 14px;
                                    color: ink;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Add friends section
        HorizontalLayout {
            padding-top: 22px;
            padding-bottom: 12px;
            alignment: space-between;
            Text {
                text: "Add friends";
                font-size: 16px;
                font-weight: 720;
                color: ink;
                letter-spacing: -0.25px;
                vertical-alignment: center;
            }
            Text {
                text: root.selected-count + " selected";
                font-size: 12px;
                color: muted;
                vertical-alignment: center;
            }
        }

        // Search
        Rectangle {
            height: 49px;
            border-radius: 16px;
            background: glass;
            border-width: 1px;
            border-color: line;
            drop-shadow-blur: 8px;
            drop-shadow-color: rgba(0,0,0,0.03);
            drop-shadow-offset-y: 3px;
            
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                spacing: 10px;
                alignment: center;
                Search { size: 16px; tint: muted; }
                TextInput {
                    horizontal-stretch: 1;
                    text <=> root.query;
                    font-size: 13px;
                    color: ink;
                    vertical-alignment: center;
                }
            }
        }

        // Selected panel
        Rectangle {
            border-radius: 20px;
            background: glass;
            border-width: 1px;
            border-color: line;
            drop-shadow-blur: 8px;
            drop-shadow-color: rgba(0,0,0,0.03);
            drop-shadow-offset-y: 3px;
            
            min-height: 62px;
            VerticalLayout {
                padding-left: 13px; padding-right: 13px;
                padding-top: 13px; padding-bottom: 13px;
                spacing: 9px;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Selected members"; font-size: 12px; font-weight: 700; color: ink; vertical-alignment: center; }
                    Text { text: root.selected-count >= 2 ? "Ready to create" : "Choose at least 2 friends"; font-size: 12px; color: muted; vertical-alignment: center; }
                }
                if root.selected-count == 0: Text {
                    text: "Your selected friends will appear here";
                    font-size: 12px;
                    color: muted;
                }
            }
        }

        // Friend list
        VerticalLayout {
            spacing: 7px;
            for f in root.friends: TouchArea {
                height: 62px;
                mouse-cursor: pointer;
                clicked => { root.toggle-member(f.id); }
                Rectangle {
                    width: parent.width;
                    height: 62px;
                    border-radius: 19px;
                    background: f.selected ? selected-bg : glass;
                    border-width: 1px;
                    border-color: f.selected ? line : transparent;
                    HorizontalLayout {
                        padding-left: 11px; padding-right: 11px;
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 43px; height: 43px;
                            border-radius: 15px;
                            background: @linear-gradient(145deg, #d4d4d2 0%, #b9b9b6 100%);
                            Text {
                                width: parent.width; height: parent.height;
                                text: f.initials;
                                font-size: 12px;
                                font-weight: 800;
                                color: #222;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            Text {
                                text: f.name;
                                font-size: 13px;
                                font-weight: 680;
                                color: ink;
                            }
                            Text {
                                text: "@" + f.handle;
                                font-size: 12px;
                                color: muted;
                            }
                        }
                        Rectangle {
                            width: 23px; height: 23px;
                            border-radius: 11.5px;
                            border-width: 1.4px;
                            border-color: f.selected ? primary : soft;
                            background: f.selected ? primary : transparent;
                            Text {
                                width: parent.width; height: parent.height;
                                text: f.selected ? "✓" : "";
                                font-size: 12px;
                                color: primary-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        if root.friends.length == 0: Text {
            text: "No friends match that search.";
            font-size: 13px;
            color: muted;
            horizontal-alignment: center;
            
        }
    }

    // Bottom CTA
    Rectangle {
        height: 112px;
        VerticalLayout {
            padding-left: 20px; padding-right: 20px;
            padding-top: 16px; padding-bottom: 15px;
            spacing: 0px;
            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.selected-count == 0 ? "No members selected" : (root.selected-count + " " + (root.selected-count == 1 ? "friend" : "friends") + " selected");
                        font-size: 12px;
                        font-weight: 700;
                        color: ink;
                    }
                    Text {
                        text: root.selected-count >= 2 ? "Your group is almost ready" : "Select at least 2 friends";
                        font-size: 12px;
                        color: muted;
                    }
                }
                TouchArea {
                    width: 148px; height: 53px;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.selected-count >= 2 && root.name != "") { root.modal-open = true; }
                    }
                    Rectangle {
                        width: 148px; height: 53px;
                        border-radius: 17px;
                        background: (root.selected-count >= 2 && root.name != "") ? primary : rgba(23,23,23,0.36);
                        opacity: (root.selected-count >= 2 && root.name != "") ? 1.0 : 0.36;
                        drop-shadow-blur: (root.selected-count >= 2 && root.name != "") ? 22px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.14);
                        drop-shadow-offset-y: 9px;
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "Create group";
                                font-size: 13px;
                                font-weight: 730;
                                color: primary-text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Confirmation modal
    if root.modal-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.modal-open = false; } }
        Rectangle {
            x: 12px; y: parent.height - 200px;
            width: parent.width; height: 180px;
            border-radius: 28px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 23px;
                spacing: 0px;
                Text { text: "Create this group?"; font-size: 18px; font-weight: 700; color: ink; letter-spacing: -0.3px; }
                Text { text: "Your group will be created with the selected friends. This is a local UI preview, so no real group or invitation will be created."; font-size: 13px; color: muted; wrap: word-wrap;  }
                HorizontalLayout {
                    spacing: 9px;
                    TouchArea {
                        horizontal-stretch: 1; height: 47px;
                        mouse-cursor: pointer;
                        clicked => { root.modal-open = false; }
                        Rectangle {
                            width: parent.width; height: 47px;
                            border-radius: 15px;
                            background: glass;
                            border-width: 1px;
                            border-color: line;
                            Text { width: parent.width; height: parent.height; text: "Cancel"; font-size: 13px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    TouchArea {
                        horizontal-stretch: 1; height: 47px;
                        mouse-cursor: pointer;
                        clicked => { root.modal-open = false; root.create(); }
                        Rectangle {
                            width: parent.width; height: 47px;
                            border-radius: 15px;
                            background: primary;
                            border-width: 0px;
                            Text { width: parent.width; height: parent.height; text: "Preview group"; font-size: 13px; font-weight: 700; color: primary-text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Group info
// Group Info screen — monochrome Liquid Glass (mobile-first).
export component GroupInfoScreen inherits Rectangle {
    in property <string> group-name: "";
    in property <string> group-initials: "";
    in property <int> group-variant: 0;
    in property <int> member-count: 0;
    in property <[UiMember]> members;
    in property <bool> is-admin: false;
    in-out property <bool> group-muted: false;
    callback back;
    callback leave;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <int> tab: 0; // 0 members, 1 media
    in-out property <bool> sheet-open: false;
    in-out property <bool> leave-open: false;

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> muted-2: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> line-strong: Theme.n-line-strong;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> surface-soft: Theme.n-surface-soft;
    property <color> nav-bg: Theme.n-nav-bg;
    property <color> primary: Theme.n-primary;
    property <color> primary-text: Theme.n-primary-text;
    property <color> scrim: Theme.n-scrim;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Top bar
        HorizontalLayout {
            padding-left: 20px; padding-right: 20px;
            padding-top: 10px; padding-bottom: 8px;
            height: 66px;
            alignment: start;
            spacing: 0px;
            NemoBackButton {
                clicked => { root.back(); }
            }
            Text {
                horizontal-stretch: 1;
                text: "Group info";
                font-size: 15px;
                font-weight: 650;
                color: ink;
                letter-spacing: -0.2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 40px; height: 40px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    if root.dark: Sun {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 19px;
                        tint: ink;
                    }
                    if !root.dark: Moon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 19px;
                        tint: ink;
                    }
                }
            }
            TouchArea {
                width: 40px; height: 40px;
                mouse-cursor: pointer;
                clicked => { root.sheet-open = true; }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⋯";
                        font-size: 18px;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 22px;
                padding-bottom: 18px;
                spacing: 0px;

                // Group hero
                VerticalLayout {
                    spacing: 0px;
                    alignment: center;
                    // avatar
                    Rectangle {
                        width: 104px; height: 104px;
                        
                        border-radius: 33px;
                        background: @linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(205,205,202,0.58) 100%);
                        border-width: 1px;
                        border-color: rgba(255,255,255,0.8);
                        drop-shadow-blur: 32px;
                        drop-shadow-color: rgba(0,0,0,0.12);
                        drop-shadow-offset-y: 16px;
                        // edit button
                        TouchArea {
                            width: 31px; height: 31px;
                            x: 73px; y: 73px;
                            mouse-cursor: pointer;
                            clicked => { }
                            Rectangle {
                                width: 31px; height: 31px;
                                border-radius: 15.5px;
                                background: primary;
                                border-width: 2px;
                                border-color: dark ? #101010 : #f4f4f3;
                                drop-shadow-blur: 12px;
                                drop-shadow-color: rgba(0,0,0,0.08);
                                drop-shadow-offset-y: 4px;
                                EditPencil {
                                    x: 8px;
                                    y: 8px;
                                    size: 15px;
                                    tint: primary-text;
                                }
                            }
                        }
                        Text {
                            width: parent.width; height: parent.height;
                            text: root.group-initials;
                            font-size: 32px;
                            font-weight: 700;
                            color: #333;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.group-name;
                        font-size: 25px;
                        font-weight: 720;
                        color: ink;
                        letter-spacing: -0.55px;
                        horizontal-alignment: center;
                        padding-top: 17px;
                    }
                    Text {
                        text: "#" + root.group-name.to-lowercase().replace-all(" ", "-");
                        font-size: 13px;
                        color: muted;
                        horizontal-alignment: center;
                        padding-top: 7px;
                    }
                    Text {
                        text: "Good people, good conversations, and plans that actually happen.";
                        font-size: 13px;
                        color: muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        padding-top: 12px;
                    }
                    Text {
                        text: "Created by Alex Morgan · 12 October 2026";
                        font-size: 12px;
                        color: muted-2;
                        horizontal-alignment: center;
                        padding-top: 12px;
                    }
                }

                // Hero actions
                HorizontalLayout {
                    padding-top: 2px;
                    padding-bottom: 23px;
                    spacing: 9px;
                    alignment: center;
                    for action in ["Add", "Mute", "Search", "Share"]: TouchArea {
                        horizontal-stretch: 1;
                        height: 70px;
                        mouse-cursor: pointer;
                        clicked => {
                            if (action == "Mute") { root.group-muted = !root.group-muted; }
                        }
                        Rectangle {
                            width: parent.width; height: 70px;
                            border-radius: 19px;
                            background: glass;
                            border-width: 1px;
                            border-color: line;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: rgba(0,0,0,0.045);
                            drop-shadow-offset-y: 4px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Rectangle {
                                    width: 53px; height: 53px;
                                    x: (parent.width - 53px) / 2;
                                    border-radius: 19px;
                                    background: surface-soft;
                                    border-width: 1px;
                                    border-color: line;
                                    if action == "Add": Plus {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 22px;
                                        tint: ink;
                                    }
                                    if action == "Mute" && !root.group-muted: Bell {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 22px;
                                        tint: ink;
                                    }
                                    if action == "Mute" && root.group-muted: MutedIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 22px;
                                        tint: ink;
                                    }
                                    if action == "Search": Search {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 22px;
                                        tint: ink;
                                    }
                                    if action == "Share": LinkIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 22px;
                                        tint: ink;
                                    }
                                }
                                Text {
                                    text: action == "Mute" ? (root.group-muted ? "Unmute" : "Mute") : action;
                                    font-size: 12px;
                                    font-weight: 650;
                                    color: ink;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Members section
                HorizontalLayout {
                    padding-bottom: 11px;
                    alignment: start;
                    spacing: 0px;
                    Text {
                        text: "Members";
                        font-size: 14px;
                        font-weight: 680;
                        color: ink;
                        letter-spacing: -0.2px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: " · " + root.member-count;
                        font-size: 12px;
                        color: muted;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TouchArea {
                        width: 30px; height: 30px;
                        mouse-cursor: pointer;
                        clicked => { }
                        Rectangle {
                            width: 30px; height: 30px;
                            border-radius: 10px;
                            background: glass;
                            border-width: 1px;
                            border-color: line;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "+";
                                font-size: 18px;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    border-radius: 24px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    clip: true;
                    VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 0px;
                        for m in root.members: HorizontalLayout {
                            height: 62px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle {
                                width: 43px; height: 43px;
                                border-radius: 16px;
                                background: @linear-gradient(145deg, #eee 0%, #bdbdb9 100%);
                                border-width: 1px;
                                border-color: rgba(255,255,255,0.65);
                                drop-shadow-blur: 10px;
                                drop-shadow-color: rgba(0,0,0,0.07);
                                drop-shadow-offset-y: 4px;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: m.initials;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #383836;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: m.name;
                                    font-size: 13px;
                                    font-weight: 630;
                                    color: ink;
                                    letter-spacing: -0.15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: m.handle;
                                    font-size: 12px;
                                    color: muted;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                width: 0px; // spacer
                            }
                            if m.admin: Rectangle {
                                width: 60px; height: 22px;
                                border-radius: 11px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "Admin";
                                    font-size: 12px;
                                    color: muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if !m.admin: TouchArea {
                                width: 30px; height: 30px;
                                mouse-cursor: pointer;
                                clicked => { }
                                Rectangle {
                                    width: 30px; height: 30px;
                                    border-radius: 10px;
                                    background: glass;
                                    border-width: 1px;
                                    border-color: line;
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: "⋯";
                                        font-size: 14px;
                                        color: muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                        }
                        TouchArea {
                            height: 54px;
                            mouse-cursor: pointer;
                            clicked => { }
                            Rectangle {
                                width: parent.width; height: 54px;
                                HorizontalLayout {
                                    padding-left: 15px; padding-right: 15px;
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle {
                                        width: 33px; height: 33px;
                                        border-radius: 12px;
                                        background: surface-soft;
                                        border-width: 1px;
                                        border-color: line;
                                        Text { width: parent.width; height: parent.height; text: "›"; font-size: 14px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "View all members";
                                        font-size: 12px;
                                        font-weight: 630;
                                        color: ink;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.member-count;
                                        font-size: 12px;
                                        color: muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Tabs
                HorizontalLayout {
                    padding-top: 14px;
                    padding-bottom: 13px;
                    spacing: 6px;
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 34px;
                        mouse-cursor: pointer;
                        clicked => { root.tab = 0; }
                        Rectangle {
                            width: parent.width; height: 34px;
                            border-radius: 12px;
                            background: root.tab == 0 ? glass-strong : surface-soft;
                            border-width: 1px;
                            border-color: root.tab == 0 ? line-strong : line;
                            drop-shadow-blur: root.tab == 0 ? 9px : 0px;
                            drop-shadow-color: rgba(0,0,0,0.07);
                            drop-shadow-offset-y: 3px;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Members";
                                font-size: 12px;
                                font-weight: 620;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 34px;
                        mouse-cursor: pointer;
                        clicked => { root.tab = 1; }
                        Rectangle {
                            width: parent.width; height: 34px;
                            border-radius: 12px;
                            background: root.tab == 1 ? glass-strong : surface-soft;
                            border-width: 1px;
                            border-color: root.tab == 1 ? line-strong : line;
                            drop-shadow-blur: root.tab == 1 ? 9px : 0px;
                            drop-shadow-color: rgba(0,0,0,0.07);
                            drop-shadow-offset-y: 3px;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Media & links";
                                font-size: 12px;
                                font-weight: 620;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Media panel (shown when tab == 1)
                if root.tab == 1: Rectangle {
                    border-radius: 24px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    clip: true;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        // media grid (3 columns, 2 rows)
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; height: 80px; border-radius: 17px; background: @linear-gradient(145deg, #e8e8e5 0%, #bcbcb8 100%); border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: "Photo"; font-size: 12px; font-weight: 650; color: #555; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { horizontal-stretch: 1; height: 80px; border-radius: 17px; background: @linear-gradient(145deg, #d4d4d1 0%, #999995 100%); border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: "File"; font-size: 12px; font-weight: 650; color: #555; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { horizontal-stretch: 1; height: 80px; border-radius: 17px; background: @linear-gradient(145deg, #f0f0ed 0%, #c5c5c1 100%); border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: "Link"; font-size: 12px; font-weight: 650; color: #555; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; height: 80px; border-radius: 17px; background: @linear-gradient(145deg, #c5c5c1 0%, #858581 100%); border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: "Document"; font-size: 12px; font-weight: 650; color: #555; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { horizontal-stretch: 1; height: 80px; border-radius: 17px; background: @linear-gradient(145deg, #ececea 0%, #aaa9a5 100%); border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: "Shared"; font-size: 12px; font-weight: 650; color: #555; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { horizontal-stretch: 1; height: 80px; border-radius: 17px; background: @linear-gradient(145deg, #bdbdb9 0%, #ededeb 100%); border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: "More"; font-size: 12px; font-weight: 650; color: #555; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                    }
                }

                // Group settings
                Text {
                    text: "Group settings";
                    font-size: 14px;
                    font-weight: 680;
                    color: ink;
                    letter-spacing: -0.2px;
                    padding-top: 14px;
                    padding-bottom: 11px;
                }
                Rectangle {
                    border-radius: 22px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    clip: true;
                    VerticalLayout {
                        TouchArea {
                            height: 54px;
                            mouse-cursor: pointer;
                            clicked => { }
                            Rectangle {
                                width: parent.width; height: 54px;
                                HorizontalLayout {
                                    padding-left: 15px; padding-right: 15px;
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle { width: 33px; height: 33px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; EditPencil { x: 9px; y: 9px; size: 15px; tint: ink; } }
                                    Text { horizontal-stretch: 1; text: "Edit group details"; font-size: 12px; font-weight: 630; color: ink; vertical-alignment: center; }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        TouchArea {
                            height: 54px;
                            mouse-cursor: pointer;
                            clicked => { }
                            Rectangle {
                                width: parent.width; height: 54px;
                                HorizontalLayout {
                                    padding-left: 15px; padding-right: 15px;
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle { width: 33px; height: 33px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Shield { x: 9px; y: 9px; size: 15px; tint: ink; } }
                                    Text { horizontal-stretch: 1; text: "Group permissions"; font-size: 12px; font-weight: 630; color: ink; vertical-alignment: center; }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        TouchArea {
                            height: 54px;
                            mouse-cursor: pointer;
                            clicked => { }
                            Rectangle {
                                width: parent.width; height: 54px;
                                HorizontalLayout {
                                    padding-left: 15px; padding-right: 15px;
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle { width: 33px; height: 33px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Picture { x: 9px; y: 9px; size: 15px; tint: ink; } }
                                    Text { horizontal-stretch: 1; text: "Media visibility"; font-size: 12px; font-weight: 630; color: ink; vertical-alignment: center; }
                                    Text { text: "Default"; font-size: 12px; color: muted; vertical-alignment: center; }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Leave group
                TouchArea {
                    height: 52px;
                    mouse-cursor: pointer;
                    clicked => { root.leave-open = true; }
                    Rectangle {
                        width: parent.width;
                        height: 52px;
                        border-radius: 16px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 4px;
                        Text {
                            width: parent.width; height: parent.height;
                            text: "Leave group";
                            font-size: 13px;
                            font-weight: 700;
                            color: muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "NEMO · GROUP INFORMATION";
                    font-size: 12px;
                    color: muted;
                    letter-spacing: 0.35px;
                    horizontal-alignment: center;
                    padding-top: 14px;
                    padding-bottom: 12px;
                }
            }
        }

    }

    // More options sheet
    if root.sheet-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.sheet-open = false; } }
        Rectangle {
            x: 12px; y: parent.height - 220px;
            width: parent.width; height: 200px;
            border-radius: 28px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle { height: 4px; width: 38px;  border-radius: 2px; background: muted; opacity: 0.45; }
                Text { text: "Group options"; font-size: 15px; font-weight: 700; color: ink;  }
                Text { text: "Manage this group and its appearance."; font-size: 12px; color: muted;  }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            Sun { size: 15px; tint: ink; }
                            Text { text: "Light appearance"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            Moon { size: 15px; tint: ink; }
                            Text { text: "Dark appearance"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            LinkIcon { size: 15px; tint: ink; }
                            Text { text: "Copy group link"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 45px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 45px;
                        border-radius: 13px;
                        background: surface-soft;
                        
                        Text { width: parent.width; height: parent.height; text: "Close"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // Leave group confirmation sheet
    if root.leave-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.leave-open = false; } }
        Rectangle {
            x: 12px; y: parent.height - 200px;
            width: parent.width; height: 180px;
            border-radius: 28px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle { height: 4px; width: 38px;  border-radius: 2px; background: muted; opacity: 0.45; }
                Text { text: "Leave this group?"; font-size: 15px; font-weight: 700; color: ink;  }
                Text { text: "You will stop receiving messages from The Weekend Crew. You can only return if a group member invites you again."; font-size: 12px; color: muted; wrap: word-wrap;  }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.leave-open = false; root.leave(); }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 14px;
                        background: primary;
                        Text { width: parent.width; height: parent.height; text: "Leave group"; font-size: 12px; font-weight: 700; color: primary-text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.leave-open = false; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 14px;
                        background: surface-soft;
                        
                        Text { width: parent.width; height: parent.height; text: "Stay in group"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
