                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Friend requests"; font-size: 12px; font-weight: 650; color: ink; }
                                        Text { text: "Control who can add you"; font-size: 12px; color: muted; }
                                    }
                                    Text { text: "Everyone"; font-size: 12px; font-weight: 700; color: muted; vertical-alignment: center; }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Read receipts
                        HorizontalLayout {
                            height: 58px;
                            padding-left: 16px; padding-right: 16px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Eye { x: 8px; y: 8px; size: 17px; tint: ink; } }
                            VerticalLayout {
