// Notifications, Find Friends, Profile and Settings screens.
//
// Verified Slint 1.18.1 rules used here:
// - `if` conditionals (absent from the item tree when false) instead of
//   `visible:` for anything inside a layout.
// - Layout children never set x/y; vertical centering uses
//   `cross-axis-self-alignment: center`.
// - Composite cards used as layout children get an explicit height (a bare
//   Rectangle reports preferred height 0 and would collapse or balloon).
// - Chip widths derive from `text.character-count` (pre-bound call, no parens).

import { Theme } from "../theme.slint";
import {
    ChevronRight, Gear, Sun, Moon, Bell, Search, Trash, EditPencil, Calendar,
    Users, User, NavChat, Mail, Speaker, Eye, BlockIcon, Lock, CopyIcon,
    Document, Refresh, Logout, LinkIcon, ListIcon,
} from "../icons.slint";
import {
    GlassCard, Hairline, SearchField, Avatar, EmptyState, NavBar, TopBar,
    PillTag, SectionLabel, Toggle, GhostButton, NemoBackButton,
} from "../widgets.slint";

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

export struct UiPerson {
    id: int,
    name: string,
    handle: string,
    initials: string,
    variant: int,
    online: bool,
    subtitle: string,
    state: int,          // 0 = can add, 1 = pending, 2 = friends
    has-avatar: bool,
    avatar: image,
}

export struct UiActivity {
    id: int,
    name: string,
    initials: string,
    variant: int,
    action: string,
    time: string,
    unread: bool,
}

// ---------------------------------------------------------------------------
// Action chip (auto width)
// ---------------------------------------------------------------------------

export component Chip inherits Rectangle {
    in property <string> text: "";
    in property <color> bg: Theme.c-accent-soft;
    in property <color> fg: Theme.accent;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    width: text.character-count * 6.6px + 26px;
    border-radius: self.height / 2;
    background: root.bg;
    border-width: 1px;
    border-color: Theme.c-stroke-glass;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Rectangle {
            border-radius: root.border-radius;
            background: white;
            opacity: touch.pressed ? 0.18 : 0;
            animate opacity { duration: 90ms; }
        }
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.fs-caption;
        font-weight: 700;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------------------------------------------------------------------------
// Rows
// ---------------------------------------------------------------------------

export component PersonRow inherits Rectangle {
    in property <UiPerson> person;
    callback primary;

    height: 68px;

    GlassCard {
        radius: Theme.r-row;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: Theme.sp-3;
            Avatar {
                size: 44px;
                cross-axis-self-alignment: center;
                initials: person.initials;
                variant: person.variant;
                online: person.online;
                has-image: person.has-avatar;
                image: person.avatar;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 42px;
                cross-axis-self-alignment: center;
                spacing: 2px;
                Text {
                    text: person.name;
                    font-size: Theme.fs-body-lg;
                    font-weight: 700;
                    color: Theme.c-text;
                    overflow: elide;
                }
                Text {
                    text: "@" + person.handle;
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-2;
                    overflow: elide;
                }
            }
            if person.state == 0: Chip {
                text: "Add";
                bg: Theme.accent;
                fg: white;
                cross-axis-self-alignment: center;
                clicked => { root.primary(); }
            }
            if person.state == 1: Chip {
                text: "Pending";
                bg: Theme.c-surface-alpha;
                fg: Theme.c-text-3;
                enabled: false;
                cross-axis-self-alignment: center;
            }
            if person.state == 2: Chip {
                text: "Friends";
                bg: Theme.c-accent-soft;
                fg: Theme.accent;
                enabled: false;
                cross-axis-self-alignment: center;
            }
        }
    }
}

export component RequestRow inherits Rectangle {
    in property <UiPerson> person;
    callback accept;
    callback decline;

    height: 76px;

    GlassCard {
        radius: Theme.r-row;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            Avatar {
                size: 48px;
                cross-axis-self-alignment: center;
                initials: person.initials;
                variant: person.variant;
                online: person.online;
                has-image: person.has-avatar;
                image: person.avatar;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 46px;
                cross-axis-self-alignment: center;
                spacing: 2px;
                Text {
                    text: person.name;
                    font-size: Theme.fs-body-lg;
                    font-weight: 700;
                    color: Theme.c-text;
                    overflow: elide;
                }
                Text {
                    text: person.subtitle != "" ? person.subtitle : "@" + person.handle;
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-2;
                    overflow: elide;
                }
            }
            Chip {
                text: "Accept";
                bg: Theme.accent;
                fg: white;
                cross-axis-self-alignment: center;
                clicked => { root.accept(); }
            }
            Chip {
                text: "Decline";
                bg: Theme.danger-soft;
                fg: Theme.danger;
                cross-axis-self-alignment: center;
                clicked => { root.decline(); }
            }
        }
    }
}

export component ActivityRow inherits Rectangle {
    in property <string> name: "";
    in property <string> initials: "";
    in property <int> variant: 0;
    in property <string> action: "";
    in property <string> time: "";
    in property <bool> unread: false;

    height: 68px;

    GlassCard {
        radius: Theme.r-row;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: Theme.sp-3;
            Avatar {
                size: 42px;
                cross-axis-self-alignment: center;
                initials: root.initials;
                variant: root.variant;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 42px;
                cross-axis-self-alignment: center;
                spacing: 2px;
                Text {
                    text: root.name;
                    font-size: Theme.fs-body;
                    font-weight: 700;
                    color: Theme.c-text;
                    overflow: elide;
                }
                Text {
                    text: root.action;
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-2;
                    overflow: elide;
                }
            }
            Text {
                text: root.time;
                font-size: Theme.fs-caption;
                color: Theme.c-text-3;
                cross-axis-self-alignment: center;
            }
            if root.unread: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
                cross-axis-self-alignment: center;
            }
        }
    }
}

// Settings-style link row (chevron on the right, optional danger styling).
export component LinkRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> danger: false;
    callback clicked;

    height: 58px;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: Theme.sp-2;
        VerticalLayout {
            horizontal-stretch: 1;
            height: 40px;
            cross-axis-self-alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: Theme.fs-body;
                font-weight: 600;
                color: root.danger ? Theme.danger : Theme.c-text;
                vertical-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.fs-caption;
                color: Theme.c-text-3;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !root.danger: ChevronRight {
            size: 16px;
            cross-axis-self-alignment: center;
            tint: Theme.c-text-3;
        }
    }
}

// Settings row with a glass toggle switch.
export component ToggleRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 58px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: Theme.sp-3;
        VerticalLayout {
            horizontal-stretch: 1;
            height: 40px;
            cross-axis-self-alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: Theme.fs-body;
                font-weight: 600;
                color: Theme.c-text;
                vertical-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.fs-caption;
                color: Theme.c-text-3;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Toggle {
            cross-axis-self-alignment: center;
            checked: root.checked;
            toggled(v) => {
                root.checked = v;
                root.toggled(v);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Notifications (friend requests + activity)
// Notifications screen — monochrome Liquid Glass (mobile-first).
export component NotificationsScreen inherits Rectangle {
    in property <[UiPerson]> requests;
    in property <[UiActivity]> activity;
    in-out property <int> tab: 0; // 0 all, 1 unread
    callback back;
    callback accept-request(int);
    callback decline-request(int);
    callback open-chats;
    callback open-find;
    callback open-profile;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> sheet-open: false;

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> muted-2: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> line-strong: Theme.n-line-strong;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> glass-low: Theme.n-glass-soft;
    property <color> surface-soft: Theme.n-surface-soft;
    property <color> unread-bg: Theme.n-glass-soft;
    property <color> nav-bg: Theme.n-nav-bg;
    property <color> scrim: Theme.n-scrim;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Top bar
        HorizontalLayout {
            padding-left: 22px; padding-right: 22px;
            padding-top: 18px; padding-bottom: 10px;
            spacing: 0px;
            alignment: start;
            NemoBackButton {
                clicked => { root.back(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "N E M O";
                font-size: 13px;
                font-weight: 750;
                color: muted;
                letter-spacing: 1.8px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 43px; height: 43px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 43px; height: 43px;
                    border-radius: 16px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    if root.dark: Sun {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 19px;
                        tint: ink;
                    }
                    if !root.dark: Moon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 19px;
                        tint: ink;
                    }
                }
            }
            TouchArea {
                width: 43px; height: 43px;
                mouse-cursor: pointer;
                clicked => { root.sheet-open = true; }
                Rectangle {
                    width: 43px; height: 43px;
                    border-radius: 16px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⋯";
                        font-size: 18px;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Content
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 18px;
                padding-bottom: 120px;
                spacing: 0px;

                Text {
                    text: "YOUR ACTIVITY";
                    font-size: 12px;
                    font-weight: 750;
                    color: muted;
                    letter-spacing: 1.8px;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "Notifications";
                        font-size: 31px;
                        font-weight: 760;
                        color: ink;
                        letter-spacing: -1.45px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TouchArea {
                        width: 90px; height: 24px;
                        mouse-cursor: pointer;
                        Text {
                            width: parent.width; height: parent.height;
                            text: "Mark all read";
                            font-size: 12px;
                            font-weight: 700;
                            color: ink;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: "Stay up to date with what's happening.";
                    font-size: 13px;
                    color: muted;
                    wrap: word-wrap;
                    padding-bottom: 4px;
                }

                // Summary card
                Rectangle {
                    border-radius: 21px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    HorizontalLayout {
                        padding-left: 15px; padding-right: 15px;
                        padding-top: 14px; 
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 39px; height: 39px;
                            border-radius: 14px;
                            background: surface-soft;
                            Bell {
                                x: 10px;
                                y: 10px;
                                size: 19px;
                                tint: ink;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.requests.length + root.activity.length > 0 ? "A few things need your attention." : "You are all caught up.";
                                font-size: 12px;
                                font-weight: 700;
                                color: ink;
                            }
                            Text {
                                text: "You have " + (root.requests.length + root.activity.length) + " unread notification" + (root.requests.length + root.activity.length == 1 ? "" : "s") + ".";
                                font-size: 12px;
                                color: muted;
                            }
                        }
                        Rectangle {
                            width: 28px; height: 28px;
                            border-radius: 14px;
                            background: ink;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "" + (root.requests.length + root.activity.length);
                                font-size: 12px;
                                font-weight: 750;
                                color: dark ? #171717 : #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Tabs
                HorizontalLayout {
                    padding-top: 18px;
                    padding-bottom: 20px;
                    spacing: 7px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 13px;
                        background: root.tab == 0 ? glass-strong : surface-soft;
                        border-width: 1px;
                        border-color: root.tab == 0 ? line : line;
                        drop-shadow-blur: root.tab == 0 ? 12px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.07);
                        drop-shadow-offset-y: 3px;
                        TouchArea {
                            clicked => { root.tab = 0; }
                            Text {
                                width: parent.width; height: parent.height;
                                text: "All";
                                font-size: 12px;
                                font-weight: 700;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 13px;
                        background: root.tab == 1 ? glass-strong : surface-soft;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: root.tab == 1 ? 12px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.07);
                        drop-shadow-offset-y: 3px;
                        TouchArea {
                            clicked => { root.tab = 1; }
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Unread " + (root.requests.length + root.activity.length);
                                font-size: 12px;
                                font-weight: 700;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Today section
                VerticalLayout {
                    spacing: 10px;
                    padding-bottom: 23px;
                    Text {
                        text: "TODAY";
                        font-size: 12px;
                        font-weight: 800;
                        color: muted;
                        letter-spacing: 1.3px;
                    }
                    // Friend requests
                    for req in root.requests: Rectangle {
                        border-radius: 21px;
                        background: glass;
                        border-width: 1px;
                        border-color: line-strong;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 6px;
                        clip: true;
                        Rectangle {
                            x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                            background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                        }
                        VerticalLayout {
                            padding-left: 13px; padding-right: 13px;
                            padding-top: 14px; 
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 43px; height: 43px;
                                    border-radius: 16px;
                                    background: @linear-gradient(145deg, #e9e9e9 0%, #c9c9c9 100%);
                                    border-width: 1px;
                                    border-color: rgba(0,0,0,0.07);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: req.initials;
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: #272727;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: req.name + " sent you a friend request";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: ink;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "2m ago";
                                        font-size: 12px;
                                        color: muted;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                TouchArea {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    mouse-cursor: pointer;
                                    clicked => { root.accept-request(req.id); }
                                    Rectangle {
                                        width: parent.width; height: 36px;
                                        border-radius: 12px;
                                        background: ink;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "Accept request";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: dark ? #171717 : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                TouchArea {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    mouse-cursor: pointer;
                                    clicked => { root.decline-request(req.id); }
                                    Rectangle {
                                        width: parent.width; height: 36px;
                                        border-radius: 12px;
                                        background: surface-soft;
                                        border-width: 1px;
                                        border-color: line;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "Decline";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Activity items
                    for item in root.activity: Rectangle {
                        border-radius: 21px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 6px;
                        clip: true;
                        Rectangle {
                            x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                            background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                        }
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            padding-top: 14px; 
                            spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 43px; height: 43px;
                                border-radius: 16px;
                                background: @linear-gradient(145deg, #e9e9e9 0%, #c9c9c9 100%);
                                border-width: 1px;
                                border-color: rgba(0,0,0,0.07);
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: item.initials;
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #272727;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: item.name + " " + item.action;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: ink;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: item.time;
                                    font-size: 12px;
                                    color: muted;
                                }
                            }
                        }
                    }
                }

                // Empty state
                if root.requests.length == 0 && root.activity.length == 0: EmptyState {
                    height: 220px;
                    state: "success";
                    title: "You're all caught up";
                    subtitle: "There are no unread notifications right now.";
                }
            }
        }

    }

    // More options sheet
    if root.sheet-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea {
            clicked => { root.sheet-open = false; }
        }
        Rectangle {
            x: 12px;
            y: parent.height - 220px;
            width: parent.width - 24px;
            height: 200px;
            border-radius: 26px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle {
                    height: 4px; width: 34px;
                    x: (parent.width - 34px) / 2;
                    border-radius: 2px;
                    background: muted;
                    opacity: 0.45;
                }
                Text {
                    text: "Notification options";
                    font-size: 15px;
                    font-weight: 700;
                    color: ink;
                }
                Text {
                    text: "Manage the activity shown in your Nemo inbox.";
                    font-size: 12px;
                    color: muted;
                }
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            Text { text: "✓"; font-size: 14px; vertical-alignment: center; }
                            Text { text: "Mark all as read"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            Trash { size: 15px; tint: muted; }
                            Text { text: "Clear read notifications"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 45px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 45px;
                        border-radius: 13px;
                        background: surface-soft;
                        
                        Text {
                            width: parent.width; height: parent.height;
                            text: "Cancel";
                            font-size: 12px;
                            font-weight: 650;
                            color: ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Find Friends
// Find Friends screen — monochrome Liquid Glass (mobile-first).
export component FindScreen inherits Rectangle {
    in property <[UiPerson]> suggested;
    in property <[UiPerson]> requests;
    in property <[UiPerson]> friends;
    in property <int> pending-count: 0;
    in-out property <string> query: "";
    callback search-changed(string);
    callback add-friend(int);
    callback accept-request(int);
    callback decline-request(int);
    callback open-chats;
    callback open-profile;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <int> tab: 0; // 0 discover, 1 requests, 2 friends
    in-out property <bool> help-open: false;
    in-out property <bool> request-open: false;
    in-out property <int> selected-id: 0;
    in-out property <string> selected-name: "";
    in-out property <int> selected-action: 0; // 0 add, 1 accept, 2 remove

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> muted-2: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> line-strong: Theme.n-line-strong;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> surface-soft: Theme.n-surface-soft;
    property <color> nav-bg: Theme.n-nav-bg;
    property <color> primary: Theme.n-primary;
    property <color> primary-text: Theme.n-primary-text;
    property <color> scrim: Theme.n-scrim;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Top bar
        HorizontalLayout {
            padding-left: 21px; padding-right: 21px;
            padding-top: 15px; padding-bottom: 0px;
            spacing: 0px;
            alignment: start;
            Rectangle {
                width: 31px; height: 31px;
                border-radius: 11px;
                background: @linear-gradient(145deg, glass-strong 0%, rgba(255,255,255,0.5) 100%);
                border-width: 1px;
                border-color: line-strong;
                drop-shadow-blur: 12px;
                drop-shadow-color: rgba(0,0,0,0.045);
                drop-shadow-offset-y: 4px;
                Text {
                    width: parent.width; height: parent.height;
                    text: "N";
                    font-size: 13px;
                    font-weight: 800;
                    color: ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Nemo";
                font-size: 16px;
                font-weight: 760;
                color: ink;
                letter-spacing: -0.55px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 41px; height: 41px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 41px; height: 41px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    if root.dark: Sun {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: ink;
                    }
                    if !root.dark: Moon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: ink;
                    }
                }
            }
            TouchArea {
                width: 41px; height: 41px;
                mouse-cursor: pointer;
                clicked => { root.help-open = true; }
                Rectangle {
                    width: 41px; height: 41px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "?";
                        font-size: 16px;
                        font-weight: 700;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Content
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 21px;
                padding-right: 21px;
                padding-top: 0px;
                padding-bottom: 120px;
                spacing: 0px;

                Text {
                    text: "YOUR PEOPLE, ONE PLACE";
                    font-size: 12px;
                    font-weight: 750;
                    color: muted;
                    letter-spacing: 1.85px;
                }
                Text {
                    text: "Find friends.";
                    font-size: 31px;
                    font-weight: 760;
                    color: ink;
                    letter-spacing: -1.75px;
                }
                Text {
                    text: "Search by username and connect with people you know.";
                    font-size: 13px;
                    color: muted;
                    wrap: word-wrap;
                    padding-bottom: 22px;
                }

                // Search field
                Rectangle {
                    height: 55px;
                    border-radius: 19px;
                    background: glass;
                    border-width: 1px;
                    border-color: line-strong;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 5px;
                    HorizontalLayout {
                        padding-left: 15px; padding-right: 15px;
                        spacing: 11px;
                        alignment: center;
                        Search {
                            size: 18px;
                            tint: muted;
                        }
                        TextInput {
                            horizontal-stretch: 1;
                            text <=> root.query;
                            font-size: 14px;
                            color: ink;
                            vertical-alignment: center;
                        }
                        if root.query != "": TouchArea {
                            width: 27px; height: 27px;
                            mouse-cursor: pointer;
                            clicked => { root.query = ""; }
                            Text {
                                width: parent.width; height: parent.height;
                                text: "×";
                                font-size: 18px;
                                color: muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Tabs
                HorizontalLayout {
                    padding-top: 15px;
                    padding-bottom: 22px;
                    spacing: 7px;
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 40px;
                        mouse-cursor: pointer;
                        clicked => { root.tab = 0; }
                        Rectangle {
                            width: parent.width; height: 40px;
                            border-radius: 13px;
                            background: root.tab == 0 ? glass-strong : surface-soft;
                            border-width: 1px;
                            border-color: root.tab == 0 ? line-strong : line;
                            drop-shadow-blur: root.tab == 0 ? 12px : 0px;
                            drop-shadow-color: rgba(0,0,0,0.07);
                            drop-shadow-offset-y: 3px;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Discover";
                                font-size: 12px;
                                font-weight: 650;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 40px;
                        mouse-cursor: pointer;
                        clicked => { root.tab = 1; }
                        Rectangle {
                            width: parent.width; height: 40px;
                            border-radius: 13px;
                            background: root.tab == 1 ? glass-strong : surface-soft;
                            border-width: 1px;
                            border-color: root.tab == 1 ? line-strong : line;
                            drop-shadow-blur: root.tab == 1 ? 12px : 0px;
                            drop-shadow-color: rgba(0,0,0,0.07);
                            drop-shadow-offset-y: 3px;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Requests " + root.pending-count;
                                font-size: 12px;
                                font-weight: 650;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 40px;
                        mouse-cursor: pointer;
                        clicked => { root.tab = 2; }
                        Rectangle {
                            width: parent.width; height: 40px;
                            border-radius: 13px;
                            background: root.tab == 2 ? glass-strong : surface-soft;
                            border-width: 1px;
                            border-color: root.tab == 2 ? line-strong : line;
                            drop-shadow-blur: root.tab == 2 ? 12px : 0px;
                            drop-shadow-color: rgba(0,0,0,0.07);
                            drop-shadow-offset-y: 3px;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Friends";
                                font-size: 12px;
                                font-weight: 650;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Section head
                HorizontalLayout {
                    padding-bottom: 11px;
                    Text {
                        text: root.tab == 0 ? "People you may know" : (root.tab == 1 ? "Friend requests" : "Your friends");
                        font-size: 14px;
                        font-weight: 730;
                        color: ink;
                        letter-spacing: -0.25px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.tab == 0 ? "4 people" : (root.tab == 1 ? root.pending-count + " requests" : "2 friends");
                        font-size: 12px;
                        color: muted;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // People list
                VerticalLayout {
                    spacing: 9px;

                    // Discover tab
                    if root.tab == 0: VerticalLayout {
                        spacing: 9px;
                        for p in root.suggested: Rectangle {
                            border-radius: 21px;
                            background: glass;
                            border-width: 1px;
                            border-color: line;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: rgba(0,0,0,0.045);
                            drop-shadow-offset-y: 6px;
                            clip: true;
                            Rectangle {
                                x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                                background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                            }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 12px; padding-bottom: 12px;
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px;
                                    border-radius: 17px;
                                    background: @linear-gradient(145deg, #d9d9d9 0%, #a9a9a9 100%);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.62);
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: rgba(0,0,0,0.07);
                                    drop-shadow-offset-y: 4px;
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: p.initials;
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: #242424;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: p.name;
                                        font-size: 13px;
                                        font-weight: 730;
                                        color: ink;
                                        letter-spacing: -0.15px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "@" + p.handle;
                                        font-size: 12px;
                                        color: muted;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.subtitle;
                                        font-size: 12px;
                                        color: muted-2;
                                    }
                                }
                                TouchArea {
                                    width: 84px; height: 35px;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (p.state == 0) { root.add-friend(p.id); }
                                    }
                                    Rectangle {
                                        width: 84px; height: 35px;
                                        border-radius: 12px;
                                        background: p.state == 2 ? surface-soft : (p.state == 1 ? surface-soft : primary);
                                        border-width: 1px;
                                        border-color: p.state == 0 ? line-strong : line;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: p.state == 2 ? "Message" : (p.state == 1 ? "Requested" : "Add friend");
                                            font-size: 12px;
                                            font-weight: 730;
                                            color: p.state == 0 ? primary-text : ink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Requests tab
                    if root.tab == 1: VerticalLayout {
                        spacing: 9px;
                        for p in root.requests: Rectangle {
                            border-radius: 21px;
                            background: glass;
                            border-width: 1px;
                            border-color: line;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: rgba(0,0,0,0.045);
                            drop-shadow-offset-y: 6px;
                            clip: true;
                            Rectangle {
                                x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                                background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                            }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 12px; padding-bottom: 12px;
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px;
                                    border-radius: 17px;
                                    background: @linear-gradient(145deg, #d9d9d9 0%, #a9a9a9 100%);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.62);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: p.initials;
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: #242424;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: p.name;
                                        font-size: 13px;
                                        font-weight: 730;
                                        color: ink;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "@" + p.handle;
                                        font-size: 12px;
                                        color: muted;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "Incoming friend request";
                                        font-size: 12px;
                                        color: muted-2;
                                    }
                                }
                                TouchArea {
                                    width: 84px; height: 35px;
                                    mouse-cursor: pointer;
                                    clicked => { root.accept-request(p.id); }
                                    Rectangle {
                                        width: 84px; height: 35px;
                                        border-radius: 12px;
                                        background: primary;
                                        border-width: 1px;
                                        border-color: line-strong;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "Accept";
                                            font-size: 12px;
                                            font-weight: 730;
                                            color: primary-text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        if root.requests.length == 0: EmptyState {
                            height: 180px;
                            state: "empty";
                            title: "No requests";
                            subtitle: "New friend requests will appear here.";
                        }
                    }

                    // Friends tab
                    if root.tab == 2: VerticalLayout {
                        spacing: 9px;
                        for p in root.friends: Rectangle {
                            border-radius: 21px;
                            background: glass;
                            border-width: 1px;
                            border-color: line;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: rgba(0,0,0,0.045);
                            drop-shadow-offset-y: 6px;
                            clip: true;
                            Rectangle {
                                x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                                background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                            }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 12px; padding-bottom: 12px;
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 48px; height: 48px;
                                    border-radius: 17px;
                                    background: @linear-gradient(145deg, #d9d9d9 0%, #a9a9a9 100%);
                                    border-width: 1px;
                                    border-color: rgba(255,255,255,0.62);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: p.initials;
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: #242424;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: p.name;
                                        font-size: 13px;
                                        font-weight: 730;
                                        color: ink;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "@" + p.handle;
                                        font-size: 12px;
                                        color: muted;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "Your friend";
                                        font-size: 12px;
                                        color: muted-2;
                                    }
                                }
                                TouchArea {
                                    width: 84px; height: 35px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-chats(); }
                                    Rectangle {
                                        width: 84px; height: 35px;
                                        border-radius: 12px;
                                        background: surface-soft;
                                        border-width: 1px;
                                        border-color: line;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "Message";
                                            font-size: 12px;
                                            font-weight: 730;
                                            color: ink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        if root.friends.length == 0: EmptyState {
                            height: 180px;
                            state: "empty";
                            title: "No friends yet";
                            subtitle: "People you connect with will appear here.";
                        }
                    }

                    if root.tab == 0 && root.suggested.length == 0: EmptyState {
                        height: 180px;
                        state: "empty";
                        title: "No people found";
                        subtitle: "Try searching for a username.";
                    }
                }

                // Hint
                Rectangle {
                    border-radius: 17px;
                    background: surface-soft;
                    border-width: 1px;
                    border-color: line;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        padding-top: 13px; padding-bottom: 13px;
                        spacing: 10px;
                        alignment: start;
                        Text { text: "ℹ"; font-size: 14px; color: muted; vertical-alignment: top; }
                        Text {
                            horizontal-stretch: 1;
                            text: "Only accepted friends can start private conversations with you. Search using someone's exact username to find the right person.";
                            font-size: 12px;
                            color: muted;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Bottom navigation — shared floating glass tab bar.
        NavBar {
            selected: 1;
            requests: root.pending-count;
            select(i) => {
                if (i == 0) { root.open-chats(); }
                if (i == 2) { root.open-profile(); }
            }
        }
    }

    // Help sheet
    if root.help-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.help-open = false; } }
        Rectangle {
            x: 12px; y: parent.height - 200px;
            width: parent.width - 24px; height: 180px;
            border-radius: 27px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle { height: 4px; width: 37px; x: (parent.width - 37px) / 2; border-radius: 2px; background: muted; opacity: 0.5; }
                Text { text: "Find people on Nemo"; font-size: 16px; font-weight: 750; color: ink;  }
                Text { text: "Enter a username to find someone. Send a friend request, then wait for them to accept before starting a private chat."; font-size: 12px; color: muted; wrap: word-wrap;  }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.help-open = false; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 14px;
                        background: surface-soft;
                        Text { width: parent.width; height: parent.height; text: "Got it"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // Request confirmation sheet
    if root.request-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.request-open = false; } }
        Rectangle {
            x: 12px; y: parent.height - 200px;
            width: parent.width - 24px; height: 180px;
            border-radius: 27px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle { height: 4px; width: 37px; x: (parent.width - 37px) / 2; border-radius: 2px; background: muted; opacity: 0.5; }
                Text { text: "Send friend request?"; font-size: 16px; font-weight: 750; color: ink;  }
                Text { text: "You can message each other after the request is accepted."; font-size: 12px; color: muted; wrap: word-wrap;  }
                HorizontalLayout {
                    spacing: 9px;
                    TouchArea {
                        horizontal-stretch: 1; height: 44px;
                        mouse-cursor: pointer;
                        clicked => { root.request-open = false; }
                        Rectangle {
                            width: parent.width; height: 44px;
                            border-radius: 14px;
                            background: surface-soft;
                            Text { width: parent.width; height: parent.height; text: "Cancel"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    TouchArea {
                        horizontal-stretch: 1; height: 44px;
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.selected-action == 0) { root.add-friend(root.selected-id); }
                            else if (root.selected-action == 1) { root.accept-request(root.selected-id); }
                            root.request-open = false;
                        }
                        Rectangle {
                            width: parent.width; height: 44px;
                            border-radius: 14px;
                            background: primary;
                            Text { width: parent.width; height: parent.height; text: "Send request"; font-size: 12px; font-weight: 700; color: primary-text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Profile
// Profile screen — monochrome Liquid Glass (mobile-first).
export component ProfileScreen inherits Rectangle {
    in property <string> display-name: "";
    in property <string> handle: "";
    in property <string> bio: "";
    in property <string> initials: "";
    in property <int> variant: 0;
    in property <bool> online: false;
    in property <bool> has-avatar: false;
    in property <image> avatar;
    in property <int> friend-count: 0;
    in property <int> group-count: 0;
    callback open-settings;
    callback open-chats;
    callback open-find;
    callback log-out;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> edit-open: false;
    in-out property <string> edit-name: "";
    in-out property <string> edit-handle: "";
    in-out property <string> edit-bio: "";

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> muted-2: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> line-strong: Theme.n-line-strong;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> surface-soft: Theme.n-surface-soft;
    property <color> surface-solid: Theme.n-glass-strong;
    property <color> nav-bg: Theme.n-nav-bg;
    property <color> primary: Theme.n-primary;
    property <color> primary-text: Theme.n-primary-text;
    property <color> scrim: Theme.n-scrim;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Ambient
        Rectangle {
            height: 0px;
            Rectangle {
                x: -125px; y: 90px;
                width: 220px; height: 220px;
                border-radius: 110px;
                background: dark ? rgba(255,255,255,0.07) : rgba(255,255,255,0.72);
                opacity: 0.6;
            }
            Rectangle {
                x: parent.width - 110px; y: 360px;
                width: 180px; height: 180px;
                border-radius: 90px;
                background: dark ? rgba(255,255,255,0.07) : rgba(255,255,255,0.72);
                opacity: 0.55;
            }
        }

        // Top bar
        HorizontalLayout {
            padding-left: 21px; padding-right: 21px;
            padding-top: 17px; padding-bottom: 0px;
            height: 58px;
            alignment: start;
            Text {
                text: "nemo.";
                font-size: 17px;
                font-weight: 760;
                color: ink;
                letter-spacing: -0.6px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 40px; height: 40px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    if root.dark: Sun {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: ink;
                    }
                    if !root.dark: Moon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: ink;
                    }
                }
            }
            TouchArea {
                width: 40px; height: 40px;
                mouse-cursor: pointer;
                clicked => { root.open-settings(); }
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    Gear {
                        x: 10px;
                        y: 10px;
                        size: 20px;
                        tint: ink;
                    }
                }
            }
        }

        // Page title
        HorizontalLayout {
            padding-left: 21px; padding-right: 21px;
            padding-top: 17px; padding-bottom: 17px;
            alignment: start;
            spacing: 0px;
            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Your space";
                    font-size: 12px;
                    font-weight: 700;
                    color: muted;
                    letter-spacing: 1.7px;
                }
                Text {
                    text: "Profile";
                    font-size: 31px;
                    font-weight: 760;
                    color: ink;
                    letter-spacing: -1.35px;
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 21px;
                padding-right: 21px;
                padding-bottom: 32px;
                spacing: 0px;

                // Hero card
                Rectangle {
                    border-radius: 25px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: dark ? rgba(0,0,0,0.32) : rgba(0,0,0,0.075);
                    drop-shadow-offset-y: 18px;
                    clip: true;

                    // cover
                    Rectangle {
                        height: 108px;
                        x: -21px; y: 0px;
                        width: parent.width + 42px;
                        background: dark
                            ? @linear-gradient(145deg, #292929 0%, #484848 48%, #232323 100%)
                            : @linear-gradient(145deg, #d7d7d6 0%, #f3f3f2 48%, #c7c7c6 100%);
                        // concentric rings
                        Rectangle {
                            x: (parent.width - 250px) / 2;
                            y: -65px;
                            width: 250px; height: 110px;
                            border-radius: 125px;
                            border-width: 1px;
                            border-color: dark ? rgba(255,255,255,0.17) : rgba(255,255,255,0.7);
                        }
                    }

                    // identity
                    VerticalLayout {
                        padding-left: 18px; padding-right: 18px;
                        padding-top: 0px; padding-bottom: 19px;
                        spacing: 0px;
                        // avatar row
                        HorizontalLayout {
                            spacing: 0px;
                            alignment: space-between;
                            Rectangle {
                                width: 94px; height: 94px;
                                border-radius: 30px;
                                background: surface-solid;
                                border-width: 1px;
                                border-color: line;
                                drop-shadow-blur: 28px;
                                drop-shadow-color: rgba(0,0,0,0.13);
                                drop-shadow-offset-y: 10px;
                                Rectangle {
                                    x: 4px; y: 4px;
                                    width: 86px; height: 86px;
                                    border-radius: 26px;
                                    background: dark
                                        ? @radial-gradient(circle, #777 0%, #454545 65%, #303030 100%)
                                        : @radial-gradient(circle, #fefefe 0%, #c7c7c7 65%, #a2a2a2 100%);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: root.initials;
                                        font-size: 29px;
                                        font-weight: 780;
                                        color: dark ? #f1f1f1 : #262626;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                // edit button (overlap)
                                TouchArea {
                                    width: 29px; height: 29px;
                                    x: 65px; y: 65px;
                                    mouse-cursor: pointer;
                                    clicked => { root.edit-open = true; }
                                    Rectangle {
                                        width: 29px; height: 29px;
                                        border-radius: 11px;
                                        background: primary;
                                        border-width: 2px;
                                        border-color: surface-solid;
                                        EditPencil {
                                            x: 8px;
                                            y: 8px;
                                            size: 13px;
                                            tint: primary-text;
                                        }
                                    }
                                }
                            }
                            TouchArea {
                                width: 110px; height: 41px;
                                mouse-cursor: pointer;
                                clicked => { root.edit-open = true; }
                                Rectangle {
                                    width: 110px; height: 41px;
                                    border-radius: 14px;
                                    background: glass;
                                    border-width: 1px;
                                    border-color: line-strong;
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: rgba(0,0,0,0.045);
                                    drop-shadow-offset-y: 4px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        EditPencil { size: 13px; tint: ink; }
                                        Text { text: "Edit profile"; font-size: 12px; font-weight: 680; color: ink; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.display-name;
                            font-size: 22px;
                            font-weight: 760;
                            color: ink;
                            letter-spacing: -0.7px;
                            padding-top: 15px;
                        }
                        Text {
                            text: "@" + root.handle;
                            font-size: 13px;
                            color: muted;
                            font-weight: 520;
                        }
                        Text {
                            text: root.bio;
                            font-size: 13px;
                            color: muted;
                            wrap: word-wrap;
                            padding-top: 13px;
                            padding-bottom: 16px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 28px;
                                border-radius: 10px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                HorizontalLayout {
                                    padding-left: 9px; padding-right: 9px;
                                    spacing: 6px;
                                    alignment: center;
                                    Calendar { size: 12px; tint: muted; }
                                    Text { text: "Joined November 2026"; font-size: 12px; color: muted; vertical-alignment: center; }
                                }
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 10px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                HorizontalLayout {
                                    padding-left: 9px; padding-right: 9px;
                                    spacing: 6px;
                                    alignment: center;
                                    Users { size: 12px; tint: muted; }
                                    Text { text: root.friend-count + " friends"; font-size: 12px; color: muted; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // About you section
                Text {
                    text: "About you";
font-size: 20px;
                    font-weight: 730;
                    color: ink;
                    letter-spacing: -0.25px;
                    padding-top: 25px;
                    padding-bottom: 11px;
                }
                Rectangle {
                    border-radius: 19px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    clip: true;
                    VerticalLayout {
                        // Display name row
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            padding-top: 14px; 
                            spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 35px; height: 35px;
                                border-radius: 12px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                User { x: 9px; y: 9px; size: 17px; tint: ink; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Display name"; font-size: 12px; color: muted; }
                                Text { text: root.display-name; font-size: 12px; font-weight: 630; color: ink; overflow: elide; }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Username row
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            padding-top: 14px; 
                            spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 35px; height: 35px;
                                border-radius: 12px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                Text { width: parent.width; height: parent.height; text: "@"; font-size: 14px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Username"; font-size: 12px; color: muted; }
                                Text { text: "@" + root.handle; font-size: 12px; font-weight: 630; color: ink; overflow: elide; }
                            }
                            TouchArea {
                                width: 60px; height: 30px;
                                mouse-cursor: pointer;
                                clicked => { }
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "Copy";
                                    font-size: 12px;
                                    font-weight: 650;
                                    color: muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Bio row
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            padding-top: 14px; 
                            spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 35px; height: 35px;
                                border-radius: 12px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                NavChat { x: 9px; y: 9px; size: 17px; tint: ink; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Bio"; font-size: 12px; color: muted; }
                                Text { text: root.bio; font-size: 12px; font-weight: 630; color: ink; wrap: word-wrap; }
                            }
                            TouchArea {
                                width: 50px; height: 30px;
                                mouse-cursor: pointer;
                                clicked => { root.edit-open = true; }
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "Edit";
                                    font-size: 12px;
                                    font-weight: 650;
                                    color: muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Your Nemo shortcuts
                Text {
                    text: "Your Nemo";
font-size: 20px;
                    font-weight: 730;
                    color: ink;
                    letter-spacing: -0.25px;
                    padding-top: 25px;
                    padding-bottom: 11px;
                }
                // My groups
                TouchArea {
                    height: 75px;
                    mouse-cursor: pointer;
                    clicked => { root.open-find(); }
                    Rectangle {
                        width: parent.width;
                        height: 75px;
                        border-radius: 19px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 4px;
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            spacing: 11px;
                            alignment: center;
                            Rectangle {
                                width: 36px; height: 36px;
                                border-radius: 13px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                Users { x: 9px; y: 9px; size: 18px; tint: ink; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "My groups"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "View group chats"; font-size: 12px; color: muted; }
                            }
                            Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                        }
                    }
                }
                // Settings
                TouchArea {
                    height: 75px;
                    mouse-cursor: pointer;
                    clicked => { root.open-settings(); }
                    Rectangle {
                        width: parent.width;
                        height: 75px;
                        border-radius: 19px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 4px;
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            spacing: 11px;
                            alignment: center;
                            Rectangle {
                                width: 36px; height: 36px;
                                border-radius: 13px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                Gear {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 18px;
                                    tint: ink;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Settings"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Account preferences"; font-size: 12px; color: muted; }
                            }
                            Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                        }
                    }
                }
                // Share profile
                TouchArea {
                    height: 75px;
                    mouse-cursor: pointer;
                    clicked => { }
                    Rectangle {
                        width: parent.width;
                        height: 75px;
                        border-radius: 19px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 4px;
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            spacing: 11px;
                            alignment: center;
                            Rectangle {
                                width: 36px; height: 36px;
                                border-radius: 13px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                Text { width: parent.width; height: parent.height; text: "↗"; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Share profile"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Let friends find you"; font-size: 12px; color: muted; }
                            }
                            Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                        }
                    }
                }
                // Privacy
                TouchArea {
                    height: 75px;
                    mouse-cursor: pointer;
                    clicked => { root.open-settings(); }
                    Rectangle {
                        width: parent.width;
                        height: 75px;
                        border-radius: 19px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 4px;
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            spacing: 11px;
                            alignment: center;
                            Rectangle {
                                width: 36px; height: 36px;
                                border-radius: 13px;
                                background: surface-soft;
                                border-width: 1px;
                                border-color: line;
                                Lock { x: 9px; y: 9px; size: 18px; tint: ink; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text { text: "Privacy"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Control your visibility"; font-size: 12px; color: muted; }
                            }
                            Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Bottom navigation — shared floating glass tab bar.
        NavBar {
            selected: 2;
            select(i) => {
                if (i == 0) { root.open-chats(); }
                if (i == 1) { root.open-find(); }
            }
        }
    }

    // Edit profile sheet
    if root.edit-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.edit-open = false; } }
        Rectangle {
            x: 12px; y: parent.height - 360px;
            width: parent.width - 24px;
            height: 340px;
            border-radius: 28px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 18px;
                spacing: 0px;
                Rectangle {
                    height: 4px; width: 38px;
                    x: (parent.width - 38px) / 2;
                    border-radius: 2px;
                    background: muted;
                    opacity: 0.4;
                }
                Text {
                    text: "Edit profile";
                    font-size: 19px;
                    font-weight: 700;
                    color: ink;
                    letter-spacing: -0.5px;
                }
                Text {
                    text: "Update how your profile appears to your friends.";
                    font-size: 12px;
                    color: muted;
                }
                // Display name field
                VerticalLayout {
                    spacing: 7px;
                    padding-bottom: 12px;
                    Text { text: "Display name"; font-size: 12px; font-weight: 650; color: ink; }
                    Rectangle {
                        height: 44px;
                        border-radius: 14px;
                        background: glass;
                        border-width: 1px;
                        border-color: line-strong;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px;
                            TextInput {
                                text <=> root.edit-name;
                                font-size: 13px;
                                color: ink;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Username field
                VerticalLayout {
                    spacing: 7px;
                    padding-bottom: 12px;
                    Text { text: "Username"; font-size: 12px; font-weight: 650; color: ink; }
                    Rectangle {
                        height: 44px;
                        border-radius: 14px;
                        background: glass;
                        border-width: 1px;
                        border-color: line-strong;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px;
                            TextInput {
                                text <=> root.edit-handle;
                                font-size: 13px;
                                color: ink;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Bio field
                VerticalLayout {
                    spacing: 7px;
                    padding-bottom: 17px;
                    Text { text: "Bio"; font-size: 12px; font-weight: 650; color: ink; }
                    Rectangle {
                        height: 70px;
                        border-radius: 14px;
                        background: glass;
                        border-width: 1px;
                        border-color: line-strong;
                        VerticalLayout {
                            padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px;
                            TextInput {
                                text <=> root.edit-bio;
                                font-size: 13px;
                                color: ink;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 9px;
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 47px;
                        mouse-cursor: pointer;
                        clicked => { root.edit-open = false; }
                        Rectangle {
                            width: parent.width; height: 47px;
                            border-radius: 15px;
                            background: surface-soft;
                            border-width: 1px;
                            border-color: line-strong;
                            Text { width: parent.width; height: parent.height; text: "Cancel"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 47px;
                        mouse-cursor: pointer;
                        clicked => { root.edit-open = false; }
                        Rectangle {
                            width: parent.width; height: 47px;
                            border-radius: 15px;
                            background: primary;
                            border-width: 0px;
                            Text { width: parent.width; height: parent.height; text: "Save changes"; font-size: 12px; font-weight: 700; color: primary-text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Settings
// Settings screen — monochrome Liquid Glass (mobile-first).
export component SettingsScreen inherits Rectangle {
    in property <bool> dark: false;
    in property <bool> read-receipts: true;
    in property <bool> push: true;
    in property <bool> sounds: true;
    callback back;
    callback toggled-dark(bool);
    callback toggled-read-receipts(bool);
    callback toggled-push(bool);
    callback toggled-sounds(bool);
    callback change-password;
    callback show-recovery-codes;
    callback open-policy(string);
    callback open-updates;
    callback open-chats;
    callback open-find;
    callback open-profile;
    callback log-out;
    callback delete-account;
    background: transparent;

    in-out property <bool> local-dark: root.dark;
    in-out property <bool> push-on: root.push;
    in-out property <bool> sounds-on: root.sounds;
    in-out property <bool> receipts-on: root.read-receipts;
    in-out property <bool> enter-to-send: false;
    in-out property <bool> previews-on: true;
    in-out property <bool> haptics-on: true;
    in-out property <int> sheet: 0; // 0 none, 1 appearance, 2 logout

    property <color> ink: Theme.n-ink;
    property <color> ink-soft: Theme.n-ink-soft;
    property <color> muted: Theme.n-muted;
    property <color> muted-2: Theme.n-muted-2;
    property <color> line: Theme.n-line;
    property <color> line-strong: Theme.n-line-strong;
    property <color> glass: Theme.n-glass;
    property <color> glass-strong: Theme.n-glass-strong;
    property <color> glass-soft: Theme.n-glass-soft;
    property <color> surface-soft: Theme.n-surface-soft;
    property <color> primary: Theme.n-primary;
    property <color> primary-text: Theme.n-primary-text;
    property <color> nav-bg: Theme.n-nav-bg;
    property <color> scrim: Theme.n-scrim;
    property <color> toggle: Theme.n-primary;
    property <color> toggle-knob: Theme.n-primary-text;

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Top bar
        HorizontalLayout {
            padding-left: 20px; padding-right: 20px;
            padding-top: 15px; padding-bottom: 0px;
            height: 58px;
            alignment: start;
            NemoBackButton {
                clicked => { root.back(); }
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 120px; height: 40px;
                mouse-cursor: pointer;
                clicked => { root.sheet = 1; }
                Rectangle {
                    width: 120px; height: 40px;
                    border-radius: 15px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if root.local-dark: Sun { size: 15px; tint: ink; }
                        if !root.local-dark: Moon { size: 15px; tint: ink; }
                        Text { text: root.local-dark ? "Light mode" : "Dark mode"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 15px;
                padding-bottom: 32px;
                spacing: 0px;

                Text {
                    text: "NEMO · PERSONALISE";
                    font-size: 12px;
                    font-weight: 750;
                    color: muted;
                    letter-spacing: 1.7px;
                }
                Text {
                    text: "Settings";
                    font-size: 31px;
                    font-weight: 760;
                    color: ink;
                    letter-spacing: -1.5px;
                }
                Text {
                    text: "Make your space feel like yours.";
                    font-size: 13px;
                    color: muted;
                }

                // Profile card
                Rectangle {
                    border-radius: 22px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 18px;
                    drop-shadow-color: dark ? rgba(0,0,0,0.26) : rgba(0,0,0,0.07);
                    drop-shadow-offset-y: 8px;
                    
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 14px; 
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 46px; height: 46px;
                            border-radius: 17px;
                            background: @linear-gradient(145deg, #e9e9e9 0%, #c9c9c9 100%);
                            border-width: 1px;
                            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
                            Text {
                                width: parent.width; height: parent.height;
                                text: "AM";
                                font-size: 13px;
                                font-weight: 800;
                                color: #272727;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "Alex Morgan"; font-size: 14px; font-weight: 700; color: ink; }
                            Text { text: "@alexmorgan"; font-size: 12px; color: muted; }
                        }
                        TouchArea {
                            width: 90px; height: 36px;
                            mouse-cursor: pointer;
                            clicked => { root.open-profile(); }
                            Rectangle {
                                width: 90px; height: 36px;
                                border-radius: 12px;
                                background: glass-strong;
                                border-width: 1px;
                                border-color: line-strong;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "Edit profile";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: ink;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Preferences section
                Text {
                    text: "Preferences";
font-size: 20px;
                    font-weight: 730;
                    color: ink;
                    letter-spacing: -0.25px;
                    padding-top: 22px;
                    padding-bottom: 11px;
                }
                Rectangle {
                    border-radius: 22px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    clip: true;
                    VerticalLayout {
                        // Appearance row
                        TouchArea {
                            height: 58px;
                            mouse-cursor: pointer;
                            clicked => { root.sheet = 1; }
                            Rectangle {
                                width: parent.width; height: 58px;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; if root.local-dark: Sun { x: 8px; y: 8px; size: 17px; tint: ink; } if !root.local-dark: Moon { x: 8px; y: 8px; size: 17px; tint: ink; } }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Appearance"; font-size: 12px; font-weight: 650; color: ink; }
                                        Text { text: "Choose light, dark or follow device"; font-size: 12px; color: muted; }
                                    }
                                    Text { text: root.local-dark ? "Dark" : "Light"; font-size: 12px; font-weight: 700; color: muted; vertical-alignment: center; }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Push notifications
                        HorizontalLayout {
                            height: 58px;
                            padding-left: 16px; padding-right: 16px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Bell { x: 8px; y: 8px; size: 17px; tint: ink; } }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Push notifications"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Friend requests and new messages"; font-size: 12px; color: muted; }
                            }
                            TouchArea {
                                width: 44px; height: 26px;
                                mouse-cursor: pointer;
                                clicked => { root.push-on = !root.push-on; root.toggled-push(root.push-on); }
                                Rectangle {
                                    width: 44px; height: 26px;
                                    border-radius: 13px;
                                    background: root.push-on ? toggle : surface-soft;
                                    border-width: 1px;
                                    border-color: root.push-on ? toggle : line;
                                    Rectangle {
                                        width: 20px; height: 20px;
                                        x: root.push-on ? 22px : 3px;
                                        y: 3px;
                                        border-radius: 10px;
                                        background: root.push-on ? toggle-knob : muted;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Message sounds
                        HorizontalLayout {
                            height: 58px;
                            padding-left: 16px; padding-right: 16px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Speaker { x: 8px; y: 8px; size: 17px; tint: ink; } }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Message sounds"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Play a sound for new messages"; font-size: 12px; color: muted; }
                            }
                            TouchArea {
                                width: 44px; height: 26px;
                                mouse-cursor: pointer;
                                clicked => { root.sounds-on = !root.sounds-on; root.toggled-sounds(root.sounds-on); }
                                Rectangle {
                                    width: 44px; height: 26px;
                                    border-radius: 13px;
                                    background: root.sounds-on ? toggle : surface-soft;
                                    border-width: 1px;
                                    border-color: root.sounds-on ? toggle : line;
                                    Rectangle {
                                        width: 20px; height: 20px;
                                        x: root.sounds-on ? 22px : 3px;
                                        y: 3px;
                                        border-radius: 10px;
                                        background: root.sounds-on ? toggle-knob : muted;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Haptics
                        HorizontalLayout {
                            height: 58px;
                            padding-left: 16px; padding-right: 16px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Text { width: parent.width; height: parent.height; text: " vibrating"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Haptic feedback"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Subtle feedback when you interact"; font-size: 12px; color: muted; }
                            }
                            TouchArea {
                                width: 44px; height: 26px;
                                mouse-cursor: pointer;
                                clicked => { root.haptics-on = !root.haptics-on; }
                                Rectangle {
                                    width: 44px; height: 26px;
                                    border-radius: 13px;
                                    background: root.haptics-on ? toggle : surface-soft;
                                    border-width: 1px;
                                    border-color: root.haptics-on ? toggle : line;
                                    Rectangle {
                                        width: 20px; height: 20px;
                                        x: root.haptics-on ? 22px : 3px;
                                        y: 3px;
                                        border-radius: 10px;
                                        background: root.haptics-on ? toggle-knob : muted;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // Message previews
                        HorizontalLayout {
                            height: 58px;
                            padding-left: 16px; padding-right: 16px;
                            spacing: 12px;
                            alignment: center;
                            Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Mail { x: 8px; y: 8px; size: 17px; tint: ink; } }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Message previews"; font-size: 12px; font-weight: 650; color: ink; }
                                Text { text: "Show message text in notifications"; font-size: 12px; color: muted; }
                            }
                            TouchArea {
                                width: 44px; height: 26px;
                                mouse-cursor: pointer;
                                clicked => { root.previews-on = !root.previews-on; }
                                Rectangle {
                                    width: 44px; height: 26px;
                                    border-radius: 13px;
                                    background: root.previews-on ? toggle : surface-soft;
                                    border-width: 1px;
                                    border-color: root.previews-on ? toggle : line;
                                    Rectangle {
                                        width: 20px; height: 20px;
                                        x: root.previews-on ? 22px : 3px;
                                        y: 3px;
                                        border-radius: 10px;
                                        background: root.previews-on ? toggle-knob : muted;
                                    }
                                }
                            }
                        }
                    }
                }

                // Privacy & Security
                Text {
                    text: "Privacy & security";
font-size: 20px;
                    font-weight: 730;
                    color: ink;
                    letter-spacing: -0.25px;
                    padding-top: 22px;
                    padding-bottom: 11px;
