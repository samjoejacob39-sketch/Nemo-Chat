// Notifications, Find Friends, Profile and Settings screens.
//
// Verified Slint 1.18.1 rules used here:
// - `if` conditionals (absent from the item tree when false) instead of
//   `visible:` for anything inside a layout.
// - Layout children never set x/y; vertical centering uses
//   `cross-axis-self-alignment: center`.
// - Composite cards used as layout children get an explicit height (a bare
//   Rectangle reports preferred height 0 and would collapse or balloon).
// - Chip widths derive from `text.character-count` (pre-bound call, no parens).

import { Theme } from "../theme.slint";
import { ChevronRight, Gear } from "../icons.slint";
import {
    GlassCard, Hairline, SearchField, Avatar, EmptyState, NavBar, TopBar,
    PillTag, SectionLabel, Toggle, GhostButton,
} from "../widgets.slint";

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

export struct UiPerson {
    id: int,
    name: string,
    handle: string,
    initials: string,
    variant: int,
    online: bool,
    subtitle: string,
    state: int,          // 0 = can add, 1 = pending, 2 = friends
    has-avatar: bool,
    avatar: image,
}

export struct UiActivity {
    id: int,
    name: string,
    initials: string,
    variant: int,
    action: string,
    time: string,
    unread: bool,
}

// ---------------------------------------------------------------------------
// Action chip (auto width)
// ---------------------------------------------------------------------------

export component Chip inherits Rectangle {
    in property <string> text: "";
    in property <color> bg: Theme.c-accent-soft;
    in property <color> fg: Theme.accent;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    width: text.character-count * 6.6px + 26px;
    border-radius: self.height / 2;
    background: root.bg;
    border-width: 1px;
    border-color: Theme.c-stroke-glass;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Rectangle {
            border-radius: root.border-radius;
            background: white;
            opacity: touch.pressed ? 0.18 : 0;
            animate opacity { duration: 90ms; }
        }
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.fs-caption;
        font-weight: 700;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------------------------------------------------------------------------
// Rows
// ---------------------------------------------------------------------------

component PersonRow inherits Rectangle {
    in property <UiPerson> person;
    callback primary;

    height: 68px;

    GlassCard {
        radius: Theme.r-row;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: Theme.sp-3;
            Avatar {
                size: 44px;
                cross-axis-self-alignment: center;
                initials: person.initials;
                variant: person.variant;
                online: person.online;
                has-image: person.has-avatar;
                image: person.avatar;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 42px;
                cross-axis-self-alignment: center;
                spacing: 2px;
                Text {
                    text: person.name;
                    font-size: Theme.fs-body-lg;
                    font-weight: 700;
                    color: Theme.c-text;
                    overflow: elide;
                }
                Text {
                    text: "@" + person.handle;
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-2;
                    overflow: elide;
                }
            }
            if person.state == 0: Chip {
                text: "Add";
                bg: Theme.accent;
                fg: white;
                cross-axis-self-alignment: center;
                clicked => { root.primary(); }
            }
            if person.state == 1: Chip {
                text: "Pending";
                bg: Theme.c-surface-alpha;
                fg: Theme.c-text-3;
                enabled: false;
                cross-axis-self-alignment: center;
            }
            if person.state == 2: Chip {
                text: "Friends";
                bg: Theme.c-accent-soft;
                fg: Theme.accent;
                enabled: false;
                cross-axis-self-alignment: center;
            }
        }
    }
}

component RequestRow inherits Rectangle {
    in property <UiPerson> person;
    callback accept;
    callback decline;

    height: 76px;

    GlassCard {
        radius: Theme.r-row;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            Avatar {
                size: 48px;
                cross-axis-self-alignment: center;
                initials: person.initials;
                variant: person.variant;
                online: person.online;
                has-image: person.has-avatar;
                image: person.avatar;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 46px;
                cross-axis-self-alignment: center;
                spacing: 2px;
                Text {
                    text: person.name;
                    font-size: Theme.fs-body-lg;
                    font-weight: 700;
                    color: Theme.c-text;
                    overflow: elide;
                }
                Text {
                    text: person.subtitle != "" ? person.subtitle : "@" + person.handle;
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-2;
                    overflow: elide;
                }
            }
            Chip {
                text: "Accept";
                bg: Theme.accent;
                fg: white;
                cross-axis-self-alignment: center;
                clicked => { root.accept(); }
            }
            Chip {
                text: "Decline";
                bg: Theme.danger-soft;
                fg: Theme.danger;
                cross-axis-self-alignment: center;
                clicked => { root.decline(); }
            }
        }
    }
}

component ActivityRow inherits Rectangle {
    in property <string> name: "";
    in property <string> initials: "";
    in property <int> variant: 0;
    in property <string> action: "";
    in property <string> time: "";
    in property <bool> unread: false;

    height: 68px;

    GlassCard {
        radius: Theme.r-row;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: Theme.sp-3;
            Avatar {
                size: 42px;
                cross-axis-self-alignment: center;
                initials: root.initials;
                variant: root.variant;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 42px;
                cross-axis-self-alignment: center;
                spacing: 2px;
                Text {
                    text: root.name;
                    font-size: Theme.fs-body;
                    font-weight: 700;
                    color: Theme.c-text;
                    overflow: elide;
                }
                Text {
                    text: root.action;
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-2;
                    overflow: elide;
                }
            }
            Text {
                text: root.time;
                font-size: Theme.fs-caption;
                color: Theme.c-text-3;
                cross-axis-self-alignment: center;
            }
            if root.unread: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
                cross-axis-self-alignment: center;
            }
        }
    }
}

// Settings-style link row (chevron on the right, optional danger styling).
export component LinkRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> danger: false;
    callback clicked;

    height: 58px;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: Theme.sp-2;
        VerticalLayout {
            horizontal-stretch: 1;
            height: 40px;
            cross-axis-self-alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: Theme.fs-body;
                font-weight: 600;
                color: root.danger ? Theme.danger : Theme.c-text;
                vertical-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.fs-caption;
                color: Theme.c-text-3;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !root.danger: ChevronRight {
            size: 16px;
            cross-axis-self-alignment: center;
            tint: Theme.c-text-3;
        }
    }
}

// Settings row with a glass toggle switch.
export component ToggleRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 58px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: Theme.sp-3;
        VerticalLayout {
            horizontal-stretch: 1;
            height: 40px;
            cross-axis-self-alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: Theme.fs-body;
                font-weight: 600;
                color: Theme.c-text;
                vertical-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.fs-caption;
                color: Theme.c-text-3;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Toggle {
            cross-axis-self-alignment: center;
            checked: root.checked;
            toggled(v) => {
                root.checked = v;
                root.toggled(v);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Notifications (friend requests + activity)
// Notifications screen — monochrome Liquid Glass (mobile-first).
export component NotificationsScreen inherits Rectangle {
    in property <[UiPerson]> requests;
    in property <[UiActivity]> activity;
    in-out property <int> tab: 0; // 0 all, 1 unread
    callback back;
    callback accept-request(int);
    callback decline-request(int);
    callback open-chats;
    callback open-find;
    callback open-profile;
    background: transparent;

    in-out property <bool> dark: Theme.is-dark;
    in-out property <bool> sheet-open: false;

    property <color> ink: dark ? #f4f4f4 : #171717;
    property <color> ink-soft: dark ? #dadad7 : #3d3d3b;
    property <color> muted: dark ? #aaa : #777;
    property <color> muted-2: dark ? #777 : #999;
    property <color> line: dark ? rgba(255,255,255,0.09) : rgba(0,0,0,0.085);
    property <color> line-strong: dark ? rgba(255,255,255,0.16) : rgba(0,0,0,0.14);
    property <color> glass: dark ? rgba(35,35,35,0.80) : rgba(255,255,255,0.78);
    property <color> glass-strong: dark ? rgba(44,44,44,0.82) : rgba(255,255,255,0.92);
    property <color> glass-low: dark ? rgba(255,255,255,0.035) : rgba(255,255,255,0.24);
    property <color> surface-soft: dark ? rgba(44,44,44,0.82) : rgba(245,245,245,0.82);
    property <color> unread-bg: dark ? rgba(255,255,255,0.045) : rgba(0,0,0,0.035);
    property <color> nav-bg: dark ? rgba(30,30,30,0.82) : rgba(255,255,255,0.78);
    property <color> scrim: dark ? rgba(0,0,0,0.58) : rgba(0,0,0,0.28);

    VerticalLayout {
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        // Top bar
        HorizontalLayout {
            padding-left: 22px; padding-right: 22px;
            padding-top: 18px; padding-bottom: 10px;
            spacing: 0px;
            alignment: start;
            TouchArea {
                width: 43px; height: 43px;
                mouse-cursor: pointer;
                clicked => { root.back(); }
                Rectangle {
                    width: 43px; height: 43px;
                    border-radius: 16px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 4px;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "←";
                        font-size: 18px;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "N E M O";
                font-size: 13px;
                font-weight: 750;
                color: muted;
                letter-spacing: 1.8px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 43px; height: 43px;
                mouse-cursor: pointer;
                clicked => { root.dark = !root.dark; Theme.is-dark = root.dark; }
                Rectangle {
                    width: 43px; height: 43px;
                    border-radius: 16px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    Text {
                        width: parent.width; height: parent.height;
                        text: root.dark ? "☀" : "☾";
                        font-size: 17px;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            TouchArea {
                width: 43px; height: 43px;
                mouse-cursor: pointer;
                clicked => { root.sheet-open = true; }
                Rectangle {
                    width: 43px; height: 43px;
                    border-radius: 16px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⋯";
                        font-size: 18px;
                        color: ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Content
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 18px;
                padding-bottom: 120px;
                spacing: 0px;

                Text {
                    text: "YOUR ACTIVITY";
                    font-size: 10px;
                    font-weight: 750;
                    color: muted;
                    letter-spacing: 1.8px;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "Notifications";
                        font-size: 34px;
                        font-weight: 760;
                        color: ink;
                        letter-spacing: -1.45px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TouchArea {
                        width: 90px; height: 24px;
                        mouse-cursor: pointer;
                        Text {
                            width: parent.width; height: parent.height;
                            text: "Mark all read";
                            font-size: 11px;
                            font-weight: 700;
                            color: ink;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: "Stay up to date with what's happening.";
                    font-size: 13px;
                    color: muted;
                    wrap: word-wrap;
                    padding-bottom: 4px;
                }

                // Summary card
                Rectangle {
                    border-radius: 21px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    HorizontalLayout {
                        padding-left: 15px; padding-right: 15px;
                        padding-top: 14px; padding-bottom: 14px;
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 39px; height: 39px;
                            border-radius: 14px;
                            background: surface-soft;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "🔔";
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.requests.length + root.activity.length > 0 ? "A few things need your attention." : "You are all caught up.";
                                font-size: 12px;
                                font-weight: 700;
                                color: ink;
                            }
                            Text {
                                text: "You have " + (root.requests.length + root.activity.length) + " unread notification" + (root.requests.length + root.activity.length == 1 ? "" : "s") + ".";
                                font-size: 11px;
                                color: muted;
                            }
                        }
                        Rectangle {
                            width: 28px; height: 28px;
                            border-radius: 14px;
                            background: ink;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "" + (root.requests.length + root.activity.length);
                                font-size: 11px;
                                font-weight: 750;
                                color: dark ? #171717 : #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Tabs
                HorizontalLayout {
                    padding-top: 18px;
                    padding-bottom: 20px;
                    spacing: 7px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 13px;
                        background: root.tab == 0 ? glass-strong : surface-soft;
                        border-width: 1px;
                        border-color: root.tab == 0 ? line : line;
                        drop-shadow-blur: root.tab == 0 ? 12px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.07);
                        drop-shadow-offset-y: 3px;
                        TouchArea {
                            clicked => { root.tab = 0; }
                            Text {
                                width: parent.width; height: parent.height;
                                text: "All";
                                font-size: 12px;
                                font-weight: 700;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 13px;
                        background: root.tab == 1 ? glass-strong : surface-soft;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: root.tab == 1 ? 12px : 0px;
                        drop-shadow-color: rgba(0,0,0,0.07);
                        drop-shadow-offset-y: 3px;
                        TouchArea {
                            clicked => { root.tab = 1; }
                            Text {
                                width: parent.width; height: parent.height;
                                text: "Unread " + (root.requests.length + root.activity.length);
                                font-size: 12px;
                                font-weight: 700;
                                color: ink;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Today section
                VerticalLayout {
                    spacing: 10px;
                    padding-bottom: 23px;
                    Text {
                        text: "TODAY";
                        font-size: 11px;
                        font-weight: 800;
                        color: muted;
                        letter-spacing: 1.3px;
                    }
                    // Friend requests
                    for req in root.requests: Rectangle {
                        border-radius: 21px;
                        background: glass;
                        border-width: 1px;
                        border-color: line-strong;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 6px;
                        clip: true;
                        Rectangle {
                            x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                            background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                        }
                        VerticalLayout {
                            padding-left: 13px; padding-right: 13px;
                            padding-top: 14px; padding-bottom: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Rectangle {
                                    width: 43px; height: 43px;
                                    border-radius: 16px;
                                    background: @linear-gradient(145deg, #e9e9e9 0%, #c9c9c9 100%);
                                    border-width: 1px;
                                    border-color: rgba(0,0,0,0.07);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: req.initials;
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #272727;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: req.name + " sent you a friend request";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: ink;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "2m ago";
                                        font-size: 10px;
                                        color: muted;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                TouchArea {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    mouse-cursor: pointer;
                                    clicked => { root.accept-request(req.id); }
                                    Rectangle {
                                        width: parent.width; height: 36px;
                                        border-radius: 12px;
                                        background: ink;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "Accept request";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: dark ? #171717 : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                TouchArea {
                                    horizontal-stretch: 1;
                                    height: 36px;
                                    mouse-cursor: pointer;
                                    clicked => { root.decline-request(req.id); }
                                    Rectangle {
                                        width: parent.width; height: 36px;
                                        border-radius: 12px;
                                        background: surface-soft;
                                        border-width: 1px;
                                        border-color: line;
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: "Decline";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Activity items
                    for item in root.activity: Rectangle {
                        border-radius: 21px;
                        background: glass;
                        border-width: 1px;
                        border-color: line;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: rgba(0,0,0,0.045);
                        drop-shadow-offset-y: 6px;
                        clip: true;
                        Rectangle {
                            x: 17px; y: 0px; width: parent.width - 34px; height: 1px;
                            background: @linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.9) 50%, transparent 100%);
                        }
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            padding-top: 14px; padding-bottom: 14px;
                            spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 43px; height: 43px;
                                border-radius: 16px;
                                background: @linear-gradient(145deg, #e9e9e9 0%, #c9c9c9 100%);
                                border-width: 1px;
                                border-color: rgba(0,0,0,0.07);
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: item.initials;
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #272727;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: item.name + " " + item.action;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: ink;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: item.time;
                                    font-size: 10px;
                                    color: muted;
                                }
                            }
                        }
                    }
                }

                // Empty state
                if root.requests.length == 0 && root.activity.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    padding-top: 60px;
                    Text {
                        text: "🔔";
                        font-size: 32px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "You're all caught up";
                        font-size: 14px;
                        font-weight: 700;
                        color: ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "There are no unread notifications right now.";
                        font-size: 12px;
                        color: muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Bottom nav
        Rectangle {
            height: 90px;
            VerticalLayout {
                padding-left: 18px; padding-right: 18px;
                padding-bottom: 13px;
                spacing: 0px;
                Rectangle {
                    height: 63px;
                    border-radius: 23px;
                    background: nav-bg;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.92);
                    drop-shadow-blur: 30px;
                    drop-shadow-color: rgba(0,0,0,0.10);
                    drop-shadow-offset-y: 12px;
                    HorizontalLayout {
                        alignment: center;
                        TouchArea {
                            horizontal-stretch: 1; height: 63px;
                            mouse-cursor: pointer;
                            clicked => { root.open-chats(); }
                            Text { width: parent.width; height: parent.height; text: "Chats"; font-size: 9px; font-weight: 650; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea {
                            horizontal-stretch: 1; height: 63px;
                            mouse-cursor: pointer;
                            clicked => { root.open-find(); }
                            Text { width: parent.width; height: parent.height; text: "Find"; font-size: 9px; font-weight: 650; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea {
                            horizontal-stretch: 1; height: 63px;
                            mouse-cursor: pointer;
                            clicked => { }
                            Rectangle {
                                width: parent.width; height: 63px;
                                background: surface-soft;
                                border-radius: 15px;
                                Text { width: parent.width; height: parent.height; text: "Activity"; font-size: 9px; font-weight: 650; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        TouchArea {
                            horizontal-stretch: 1; height: 63px;
                            mouse-cursor: pointer;
                            clicked => { root.open-profile(); }
                            Text { width: parent.width; height: parent.height; text: "Profile"; font-size: 9px; font-weight: 650; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    // More options sheet
    if root.sheet-open: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea {
            clicked => { root.sheet-open = false; }
        }
        Rectangle {
            x: 12px;
            y: parent.height - 220px;
            width: parent.width - 24px;
            height: 200px;
            border-radius: 26px;
            background: glass-strong;
            border-width: 1px;
            border-color: rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle {
                    height: 4px; width: 34px;
                    x: (parent.width - 34px) / 2;
                    border-radius: 2px;
                    background: muted;
                    opacity: 0.45;
                }
                Text {
                    text: "Notification options";
                    font-size: 15px;
                    font-weight: 700;
                    color: ink;
                }
                Text {
                    text: "Manage the activity shown in your Nemo inbox.";
                    font-size: 11px;
                    color: muted;
                }
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            Text { text: "✓"; font-size: 14px; vertical-alignment: center; }
                            Text { text: "Mark all as read"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 46px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 46px;
                        
                        HorizontalLayout {
                            spacing: 11px; padding-left: 10px;
                            Text { text: "🗑"; font-size: 14px; vertical-alignment: center; }
                            Text { text: "Clear read notifications"; font-size: 12px; font-weight: 650; color: ink; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 45px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet-open = false; }
                    Rectangle {
                        width: parent.width; height: 45px;
                        border-radius: 13px;
                        background: surface-soft;
                        
                        Text {
                            width: parent.width; height: parent.height;
                            text: "Cancel";
                            font-size: 12px;
                            font-weight: 650;
                            color: ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Find Friends
// ---------------------------------------------------------------------------

export component FindScreen inherits Rectangle {
    in property <[UiPerson]> suggested;
    in property <int> pending-count: 0;
    in-out property <string> query: "";
    callback search-changed(string);
    callback add-friend(int);
    callback open-chats;
    callback open-profile;
    background: transparent;

    VerticalLayout {
        padding-left: Theme.sp-5;
        padding-right: Theme.sp-5;
        padding-top: 8px;
        spacing: Theme.sp-3;

        HorizontalLayout {
            height: Theme.bar-h;
            spacing: Theme.sp-2;
            Text {
                text: "Find Friends";
                font-size: Theme.fs-title;
                font-weight: 800;
                color: Theme.c-text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.pending-count > 0: PillTag {
                text: root.pending-count + " pending";
                cross-axis-self-alignment: center;
            }
        }

        SearchField {
            text <=> root.query;
            text-changed(t) => { root.search-changed(t); }
        }

        SectionLabel { text: "SUGGESTED FOR YOU"; }

        if root.suggested.length == 0: Rectangle {
            vertical-stretch: 1;
            EmptyState {
                y: (parent.height - self.height) / 2;
                title: "No one found";
                subtitle: "Try a different name or username.";
            }
        }
        if root.suggested.length > 0: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.sp-2;
                padding-bottom: 96px;
                for p in root.suggested: PersonRow {
                    person: p;
                    primary => { root.add-friend(p.id); }
                }
            }
        }
    }

    NavBar {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 14px;
        selected: 1;
        requests: root.pending-count;
        select(i) => {
            if (i == 0) { root.open-chats(); }
            if (i == 2) { root.open-profile(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Profile
// ---------------------------------------------------------------------------

export component ProfileScreen inherits Rectangle {
    in property <string> display-name: "";
    in property <string> handle: "";
    in property <string> bio: "";
    in property <string> initials: "";
    in property <int> variant: 0;
    in property <bool> online: false;
    in property <bool> has-avatar: false;
    in property <image> avatar;
    in property <int> friend-count: 0;
    in property <int> group-count: 0;
    callback open-settings;
    callback open-chats;
    callback open-find;
    callback log-out;
    background: transparent;

    VerticalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;
        padding-top: 8px;
        spacing: Theme.sp-3;

        HorizontalLayout {
            height: Theme.bar-h;
            spacing: Theme.sp-2;
            Text {
                text: "Profile";
                font-size: Theme.fs-title;
                font-weight: 800;
                color: Theme.c-text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TouchArea {
                width: 40px;
                mouse-cursor: pointer;
                clicked => { root.open-settings(); }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: (parent.height - 40px) / 2;
                    border-radius: 20px;
                    background: Theme.c-surface-alpha;
                    border-width: 1px;
                    border-color: Theme.c-stroke-glass;
                    Gear {
                        x: (parent.width - 20px) / 2;
                        y: (parent.height - 20px) / 2;
                        size: 20px;
                        tint: Theme.c-text;
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.sp-3;
                padding-bottom: 96px;

                // Hero card
                GlassCard {
                    strong: true;
                    height: 306px;
                    VerticalLayout {
                        padding-top: 18px;
                        padding-bottom: 16px;
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        Avatar {
                            size: 84px;
                            initials: root.initials;
                            variant: root.variant;
                            online: root.online;
                            has-image: root.has-avatar;
                            image: root.avatar;
                        }
                        Text {
                            height: 30px;
                            text: root.display-name;
                            font-size: Theme.fs-large;
                            font-weight: 800;
                            color: Theme.c-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            height: 16px;
                            text: "@" + root.handle;
                            font-size: Theme.fs-small;
                            color: Theme.c-text-2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            height: 16px;
                            width: 280px;
                            text: root.bio;
                            font-size: Theme.fs-small;
                            color: Theme.c-text-2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            height: 42px;
                            spacing: Theme.sp-6;
                            alignment: center;
                            VerticalLayout {
                                width: 80px;
                                cross-axis-self-alignment: center;
                                spacing: 0px;
                                Text {
                                    height: 26px;
                                    text: root.friend-count;
                                    font-size: Theme.fs-title;
                                    font-weight: 800;
                                    color: Theme.c-text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Text {
                                    height: 14px;
                                    text: "Friends";
                                    font-size: Theme.fs-caption;
                                    color: Theme.c-text-3;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 1px;
                                height: 28px;
                                background: Theme.c-hairline;
                                cross-axis-self-alignment: center;
                            }
                            VerticalLayout {
                                width: 80px;
                                cross-axis-self-alignment: center;
                                spacing: 0px;
                                Text {
                                    height: 26px;
                                    text: root.group-count;
                                    font-size: Theme.fs-title;
                                    font-weight: 800;
                                    color: Theme.c-text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Text {
                                    height: 14px;
                                    text: "Groups";
                                    font-size: Theme.fs-caption;
                                    color: Theme.c-text-3;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        GhostButton {
                            text: "Edit profile";
                            clicked => { root.open-settings(); }
                        }
                    }
                }

                SectionLabel { text: "ACCOUNT"; }
                GlassCard {
                    height: 117px;
                    VerticalLayout {
                        LinkRow {
                            title: "Account settings";
                            subtitle: "Password and recovery codes";
                            clicked => { root.open-settings(); }
                        }
                        Hairline { }
                        LinkRow {
                            title: "Privacy & safety";
                            subtitle: "Requests and blocked accounts";
                            clicked => { root.open-settings(); }
                        }
                    }
                }

                GlassCard {
                    height: 58px;
                    VerticalLayout {
                        LinkRow {
                            title: "Log out";
                            danger: true;
                            clicked => { root.log-out(); }
                        }
                    }
                }

                Text {
                    height: 30px;
                    text: "Nemo 0.1.0 · Rust + Slint";
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    NavBar {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 14px;
        selected: 2;
        select(i) => {
            if (i == 0) { root.open-chats(); }
            if (i == 1) { root.open-find(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

export component SettingsScreen inherits Rectangle {
    in property <bool> dark: false;
    in property <bool> read-receipts: true;
    in property <bool> push: true;
    in property <bool> sounds: true;
    callback back;
    callback toggled-dark(bool);
    callback toggled-read-receipts(bool);
    callback toggled-push(bool);
    callback toggled-sounds(bool);
    callback change-password;
    callback show-recovery-codes;
    callback open-policy(string);
    callback open-updates;
    callback delete-account;
    background: transparent;

    VerticalLayout {
        TopBar {
            title: "Settings";
            back => { root.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;
                padding-top: 4px;
                padding-bottom: Theme.sp-5;
                spacing: Theme.sp-3;

                SectionLabel { text: "ACCOUNT"; }
                GlassCard {
                    height: 117px;
                    VerticalLayout {
                        LinkRow {
                            title: "Change password";
                            subtitle: "You'll receive fresh recovery codes";
                            clicked => { root.change-password(); }
                        }
                        Hairline { }
                        LinkRow {
                            title: "Recovery codes";
                            subtitle: "View and regenerate";
                            clicked => { root.show-recovery-codes(); }
                        }
                        Hairline { }
                        LinkRow {
                            title: "App updates";
                            subtitle: "Nemo UI preview channel";
                            clicked => { root.open-updates(); }
                        }
                    }
                }

                SectionLabel { text: "PRIVACY"; }
                GlassCard {
                    height: 117px;
                    VerticalLayout {
                        ToggleRow {
                            title: "Read receipts";
                            subtitle: "Let friends see when you read messages";
                            checked: root.read-receipts;
                            toggled(v) => { root.toggled-read-receipts(v); }
                        }
                        Hairline { }
                        LinkRow {
                            title: "Who can send friend requests";
                            subtitle: "Friends of friends";
                            clicked => { }
                        }
                    }
                }

                SectionLabel { text: "NOTIFICATIONS"; }
                GlassCard {
                    height: 117px;
                    VerticalLayout {
                        ToggleRow {
                            title: "Push notifications";
                            subtitle: "New messages and requests";
                            checked: root.push;
                            toggled(v) => { root.toggled-push(v); }
                        }
                        Hairline { }
                        ToggleRow {
                            title: "Message sounds";
                            checked: root.sounds;
                            toggled(v) => { root.toggled-sounds(v); }
                        }
                    }
                }

                SectionLabel { text: "APPEARANCE"; }
                GlassCard {
                    height: 58px;
                    VerticalLayout {
                        ToggleRow {
                            title: "Dark mode";
                            subtitle: "Deep navy glass theme";
                            checked: root.dark;
                            toggled(v) => { root.toggled-dark(v); }
                        }
                    }
                }

                SectionLabel { text: "LEGAL"; }
                GlassCard {
                    height: 176px;
                    VerticalLayout {
                        LinkRow {
                            title: "Terms of service";
                            clicked => { root.open-policy("terms"); }
                        }
                        Hairline { }
                        LinkRow {
                            title: "Privacy policy";
                            clicked => { root.open-policy("privacy"); }
                        }
                        Hairline { }
                        LinkRow {
                            title: "Community guidelines";
                            clicked => { root.open-policy("guidelines"); }
                        }
                    }
                }

                SectionLabel { text: "DANGER ZONE"; }
                GlassCard {
                    height: 58px;
                    VerticalLayout {
                        LinkRow {
                            title: "Delete account";
                            subtitle: "This cannot be undone";
                            danger: true;
                            clicked => { root.delete-account(); }
                        }
                    }
                }

                Text {
                    height: 40px;
                    text: "Nemo 0.1.0 · made with Rust and Slint";
                    font-size: Theme.fs-caption;
                    color: Theme.c-text-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
