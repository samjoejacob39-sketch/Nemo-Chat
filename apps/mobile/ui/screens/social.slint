                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Blocked accounts"; font-size: 12px; font-weight: 650; color: ink; }
                                        Text { text: "Manage people you have blocked"; font-size: 12px; color: muted; }
