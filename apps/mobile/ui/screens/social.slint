                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Terms & privacy"; font-size: 12px; font-weight: 650; color: ink; }
                                        Text { text: "Read Nemo's policies"; font-size: 12px; color: muted; }
                                    }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: line; }
                        // App updates
                        TouchArea {
                            height: 58px;
                            mouse-cursor: pointer;
                            clicked => { root.open-updates(); }
                            Rectangle {
                                width: parent.width; height: 58px;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px;
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Refresh { x: 8px; y: 8px; size: 17px; tint: ink; } }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "App updates"; font-size: 12px; font-weight: 650; color: ink; }
                                        Text { text: "Check the latest Nemo version"; font-size: 12px; color: muted; }
                                    }
                                    Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Log out
                Rectangle {
                    border-radius: 22px;
                    background: glass;
                    border-width: 1px;
                    border-color: line;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: rgba(0,0,0,0.045);
                    drop-shadow-offset-y: 6px;
                    clip: true;
                    TouchArea {
                        height: 58px;
                        mouse-cursor: pointer;
                        clicked => { root.sheet = 2; }
                        Rectangle {
                            width: parent.width; height: 58px;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                spacing: 12px;
                                alignment: center;
                                Rectangle { width: 34px; height: 34px; border-radius: 12px; background: surface-soft; border-width: 1px; border-color: line; Logout { x: 8px; y: 8px; size: 17px; tint: ink; } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: "Log out"; font-size: 12px; font-weight: 650; color: ink; }
                                    Text { text: "Sign out of this device"; font-size: 12px; color: muted; }
                                }
                                Text { text: "›"; font-size: 16px; color: muted-2; vertical-alignment: center; }
                            }
                        }
                    }
                }

                Text {
                    text: "NEMO · VERSION 0.1.0 · UI PREVIEW";
                    font-size: 12px;
                    color: muted;
                    letter-spacing: 0.35px;
                    horizontal-alignment: center;
                }
            }
        }

    }

    // Appearance sheet
    if root.sheet == 1: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.sheet = 0; } }
        Rectangle {
            x: 12px; y: parent.height - 300px;
            width: parent.width - 24px; height: 280px;
            border-radius: 28px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle { height: 4px; width: 34px; x: (parent.width - 34px) / 2; border-radius: 2px; background: muted; opacity: 0.45; }
                Text { text: "Appearance"; font-size: 15px; font-weight: 700; color: ink;  }
                Text { text: "Choose how Nemo looks on this device."; font-size: 12px; color: muted;  }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.local-dark = false; root.toggled-dark(false); root.sheet = 0; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 12px;
                        background: !root.local-dark ? surface-soft : transparent;
                        Text { width: parent.width; height: parent.height; text: "Light"; font-size: 12px; font-weight: 650; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.local-dark = true; root.toggled-dark(true); root.sheet = 0; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 12px;
                        background: root.local-dark ? surface-soft : transparent;
                        Text { width: parent.width; height: parent.height; text: "Dark"; font-size: 12px; font-weight: 650; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet = 0; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 12px;
                        background: transparent;
                        Text { width: parent.width; height: parent.height; text: "System"; font-size: 12px; font-weight: 650; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet = 0; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 14px;
                        background: surface-soft;
                        
                        Text { width: parent.width; height: parent.height; text: "Cancel"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // Logout confirmation sheet
    if root.sheet == 2: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: scrim;
        TouchArea { clicked => { root.sheet = 0; } }
        Rectangle {
            x: 12px; y: parent.height - 200px;
            width: parent.width - 24px; height: 180px;
            border-radius: 28px;
            background: glass-strong;
            border-width: 1px;
            border-color: Theme.is-dark ? rgba(255,255,255,0.14) : rgba(255,255,255,0.92);
            drop-shadow-blur: 30px;
            drop-shadow-color: rgba(0,0,0,0.12);
            drop-shadow-offset-y: 10px;
            clip: true;
            VerticalLayout {
                padding: 14px;
                spacing: 0px;
                Rectangle { height: 4px; width: 34px; x: (parent.width - 34px) / 2; border-radius: 2px; background: muted; opacity: 0.45; }
                Text { text: "Log out?"; font-size: 15px; font-weight: 700; color: ink;  }
                Text { text: "You will need to sign in again to use Nemo."; font-size: 12px; color: muted;  }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet = 0; root.log-out(); }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 14px;
                        background: primary;
                        Text { width: parent.width; height: parent.height; text: "Log out"; font-size: 12px; font-weight: 700; color: primary-text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                TouchArea {
                    height: 44px;
                    mouse-cursor: pointer;
                    clicked => { root.sheet = 0; }
                    Rectangle {
                        width: parent.width; height: 44px;
                        border-radius: 14px;
                        background: surface-soft;
                        
                        Text { width: parent.width; height: parent.height; text: "Cancel"; font-size: 12px; font-weight: 700; color: ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
