// Nook — root window. Screens are imported and switched here.
//
// `screen` selects the visible screen; the demo bar (enabled by the desktop
// preview binary via `demo-mode`) lets you flip through every screen manually.

import { Theme } from "theme.slint";
import { ScreenBackground } from "widgets.slint";
import {
    WelcomeScreen, SignUpScreen, RecoveryScreen, LoginScreen, TermsScreen,
    PolicySection,
} from "screens/onboarding.slint";
import { ChatsScreen, ChatScreen, UiChat, UiBubble } from "screens/chats.slint";
import {
    NotificationsScreen, FindScreen, ProfileScreen, SettingsScreen,
    UiPerson, UiActivity,
} from "screens/social.slint";
import { UpdatesScreen } from "screens/updates.slint";
import {
    CreateGroupScreen, GroupInfoScreen, UiFriendPick, UiMember,
} from "screens/groups.slint";

// Demo-only screen picker (drawn last so it sits on top).
// Two rows, each tab with a fixed 54px hit target (a bare TouchArea in a
// layout would collapse to zero width and be unclickable).
component DemoBar inherits Rectangle {
    in property <string> screen;
    callback pick(string);

    height: 48px;
    background: #101010CC;
    VerticalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            spacing: 1px;
            for t in [
                { label: "welcome", id: "welcome" },
                { label: "signup", id: "signup" },
                { label: "codes", id: "recovery" },
                { label: "login", id: "login" },
                { label: "terms", id: "terms" },
                { label: "chats", id: "chats" },
                { label: "chat", id: "chat" },
            ]: TouchArea {
                width: 54px;
                height: 20px;
                mouse-cursor: pointer;
                clicked => { root.pick(t.id); }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: t.label;
                    font-size: 8px;
                    font-weight: 700;
                    color: root.screen == t.id ? white : #FFFFFF99;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 1px;
            for t in [
                { label: "notifs", id: "notifications" },
                { label: "find", id: "find" },
                { label: "profile", id: "profile" },
                { label: "settings", id: "settings" },
                { label: "new group", id: "newgroup" },
                { label: "members", id: "groupinfo" },
            ]: TouchArea {
                width: 54px;
                height: 20px;
                mouse-cursor: pointer;
                clicked => { root.pick(t.id); }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: t.label;
                    font-size: 8px;
                    font-weight: 700;
                    color: root.screen == t.id ? white : #FFFFFF99;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    width: 390px;
    height: 844px;
    title: "Nemo";
    background: transparent;

    // Which screen is visible. Driven from Rust.
    in-out property <string> screen: "welcome";
    // Demo harness only: show the screen-picker bar (set by the dev binary).
    in property <bool> demo-mode: false;

    // Update channel callbacks (wired from Rust).
    callback check-updates;
    callback download-update;
    callback install-update;
    callback submit-signup(string, string, string);
    callback submit-login(string, string);
    callback accept-terms;

    // Demo data (fed from Rust by the preview binary).
    in property <[UiChat]> chats;
    in property <[UiBubble]> messages;
    in property <string> typing-name: "";
    in property <[string]> recovery-codes;
    in property <string> policy-title: "";
    in property <[PolicySection]> policy-sections;
    in property <[UiPerson]> requests;
    in property <[UiActivity]> activity;
    in property <[UiPerson]> find-results;
    in property <string> me-name: "";
    in property <string> me-handle: "";
    in property <string> me-bio: "";
    in property <string> me-initials: "";
    in property <int> me-variant: 0;
    in property <int> friend-count: 0;
    in property <int> group-count: 0;
    in property <[UiFriendPick]> friend-picks;
    in property <[UiMember]> group-members;
    in property <string> group-name: "";

    // Update channel state (Nemo UI preview).
    in-out property <string> update-status: "idle";
    in-out property <string> update-current-version: "0.1.0";
    in-out property <string> update-current-build: "#0";
    in-out property <string> update-latest-version: "";
    in-out property <string> update-latest-build: "";
    in-out property <string> update-notes: "";
    in-out property <int> update-progress: 0;
    in-out property <bool> update-downloading: false;
    in-out property <string> update-error: "";

    // Auth state (driven from Rust).
    in-out property <bool> signup-busy: false;
    in-out property <string> signup-error: "";
    in-out property <bool> login-busy: false;
    in-out property <string> login-error: "";
    in-out property <string> auth-token: "";

    ScreenBackground { }

    if screen == "welcome": WelcomeScreen {
        sign-up => { root.screen = "signup"; }
        log-in => { root.screen = "login"; }
    }
    if screen == "signup": SignUpScreen {
        back => { root.screen = "welcome"; }
        error: root.signup-error;
        busy: root.signup-busy;
        submit(u, d, p) => { root.submit-signup(u, d, p); }
    }
    if screen == "recovery": RecoveryScreen {
        codes: root.recovery-codes;
        saved => { root.screen = "terms"; }
        back => { root.screen = "signup"; }
    }
    if screen == "login": LoginScreen {
        back => { root.screen = "welcome"; }
        error: root.login-error;
        busy: root.login-busy;
        submit(u, p) => { root.submit-login(u, p); }
    }
    if screen == "terms": TermsScreen {
        doc-title: root.policy-title;
        sections: root.policy-sections;
        back => { root.screen = "signup"; }
        continue-p => { root.accept-terms(); }
    }
    if screen == "chats": ChatsScreen {
        chats: root.chats;
        request-count: 2;
        unseen-activity: 2;
        open-chat(i) => { root.screen = "chat"; }
        open-notifications => { root.screen = "notifications"; }
        open-find => { root.screen = "find"; }
        open-profile => { root.screen = "profile"; }
    }
    if screen == "chat": ChatScreen {
        title: "Maya Chen";
        subtitle: "online";
        other-online: true;
        peer-initials: "MC";
        peer-variant: 1;
        is-group: false;
        messages: root.messages;
        typing-name: root.typing-name;
        chat-index: 0;
        back => { root.screen = "chats"; }
        open-info => { root.screen = "groupinfo"; }
    }
    if screen == "notifications": NotificationsScreen {
        requests: root.requests;
        activity: root.activity;
        back => { root.screen = "chats"; }
        accept-request(id) => { }
        decline-request(id) => { }
        open-chats => { root.screen = "chats"; }
        open-find => { root.screen = "find"; }
        open-profile => { root.screen = "profile"; }
    }
    if screen == "find": FindScreen {
        suggested: root.find-results;
        requests: root.requests;
        friends: root.find-results;
        pending-count: 2;
        search-changed(q) => { }
        add-friend(id) => { }
        open-chats => { root.screen = "chats"; }
        open-profile => { root.screen = "profile"; }
    }
    if screen == "profile": ProfileScreen {
        display-name: root.me-name;
        handle: root.me-handle;
        bio: root.me-bio;
        initials: root.me-initials;
        variant: root.me-variant;
        friend-count: root.friend-count;
        group-count: root.group-count;
        open-settings => { root.screen = "settings"; }
        open-chats => { root.screen = "chats"; }
        open-find => { root.screen = "find"; }
        log-out => { root.screen = "welcome"; }
    }
    if screen == "settings": SettingsScreen {
        dark: Theme.is-dark;
        back => { root.screen = "profile"; }
        toggled-dark(v) => { Theme.is-dark = v; }
        toggled-read-receipts(v) => { }
        toggled-push(v) => { }
        toggled-sounds(v) => { }
        change-password => { root.screen = "recovery"; }
        show-recovery-codes => { root.screen = "recovery"; }
        open-policy(p) => { root.screen = "terms"; }
        open-updates => { root.screen = "updates"; }
        open-chats => { root.screen = "chats"; }
        open-find => { root.screen = "find"; }
        open-profile => { root.screen = "profile"; }
        log-out => { root.screen = "welcome"; }
        delete-account => { }
    }
    if screen == "newgroup": CreateGroupScreen {
        friends: root.friend-picks;
        back => { root.screen = "chats"; }
        search-changed(q) => { }
        toggle-member(id) => { }
        create => { root.screen = "chats"; }
    }
    if screen == "updates": UpdatesScreen {
        current-version: root.update-current-version;
        current-build: root.update-current-build;
        status: root.update-status;
        latest-version: root.update-latest-version;
        latest-build: root.update-latest-build;
        notes: root.update-notes;
        progress: root.update-progress;
        downloading: root.update-downloading;
        error: root.update-error;
        back => { root.screen = "settings"; }
        check => { root.check-updates(); }
        download => { root.download-update(); }
        install => { root.install-update(); }
    }

    if screen == "groupinfo": GroupInfoScreen {
        group-name: root.group-name;
        group-initials: "TC";
        group-variant: 2;
        member-count: root.group-members.length;
        members: root.group-members;
        is-admin: true;
        back => { root.screen = "chat"; }
        leave => { root.screen = "chats"; }
    }

    // Demo-only screen picker (drawn last so it sits on top).
    if root.demo-mode: DemoBar {
        screen: root.screen;
        pick(s) => { root.screen = s; }
    }
}
